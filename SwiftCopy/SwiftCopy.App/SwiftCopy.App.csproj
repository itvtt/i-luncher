<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>SwiftCopy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SwiftCopy.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ILuncherIntegrated)' == 'true'">
    <OutputType>Library</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup Condition="'$(ILuncherIntegrated)' == 'true'">
    <ApplicationDefinition Remove="App.xaml" />
    <Compile Remove="App.xaml.cs" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../SwiftCopy.Core/SwiftCopy.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/SwiftCopy.ico"/><Resource Include="Assets/SwiftCopy-24.png"/><Resource Include="Assets/SwiftCopy-32.png"/></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Fonts/*.ttf"/>
    <Content Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
