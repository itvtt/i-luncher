<Window x:Class="TerminalNotes.GlobalAgentInstructionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="전역 에이전트 지침" Icon="Assets/AppIcon.ico"
        Width="760" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#0B111A" Foreground="#F1F5F9" FontFamily="Malgun Gothic, Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="Muted" Color="#CCD6E3"/>
        <SolidColorBrush x:Key="Line" Color="#35475D"/>
        <SolidColorBrush x:Key="Accent" Color="#70E1BD"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#0D1520"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="#35637A"/>
            <Setter Property="SelectionTextBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#1A2737"/>
            <Setter Property="BorderBrush" Value="#455970"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="전역 에이전트 지침" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="PathText" Foreground="#CCD6E3" FontSize="12"
                   TextWrapping="Wrap" Margin="0,8,0,12"/>
        <TextBox Grid.Row="2" x:Name="InstructionsInput" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Malgun Gothic" FontSize="13" SpellCheck.IsEnabled="False"
                 Padding="12"/>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatusText" Foreground="#F0A59A" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" IsCancel="True" MinWidth="86" Margin="0,0,8,0"/>
                <Button x:Name="SaveInstructionsButton" Content="저장" IsDefault="True"
                        Click="SaveInstructionsButton_Click" MinWidth="86"
                        Background="#1D5144" BorderBrush="#3E8A72" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
