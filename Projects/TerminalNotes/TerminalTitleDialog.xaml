<Window x:Class="TerminalNotes.TerminalTitleDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="터미널 제목" Width="430" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/AppIcon.ico"
 Background="#141D28" Foreground="#E6EDF3" FontFamily="Malgun Gothic, Segoe UI" FontSize="14">
 <StackPanel Margin="24">
  <TextBlock x:Name="Heading" Text="새 터미널 이름" FontSize="19" FontWeight="SemiBold"/>
  <TextBlock Text="예: 지휘자, 구현 담당, 코드 검토" Foreground="#C6D1DF" Margin="0,8,0,16"/>
  <TextBox x:Name="TitleInput" MaxLength="60" Padding="10" FontSize="15" Background="#0C1016" Foreground="#E6EDF3" CaretBrush="#77E6BD" BorderBrush="#3C685C" AutomationProperties.Name="터미널 제목"/>
  <TextBlock x:Name="ValidationMessage" Text="최대 60자 · 실행 중에도 이름을 바꿀 수 있습니다." Foreground="#C6D1DF" FontSize="13" Margin="0,8,0,20"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="취소" IsCancel="True" MinWidth="74" Padding="12,8" Margin="0,0,8,0"/>
   <Button x:Name="ConfirmButton" Content="만들기" IsDefault="True" MinWidth="90" Padding="12,8" Background="#245244" Foreground="#E6EDF3" Click="Confirm_Click"/>
  </StackPanel>
 </StackPanel>
</Window>
