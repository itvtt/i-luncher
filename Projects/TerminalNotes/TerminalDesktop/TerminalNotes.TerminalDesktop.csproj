<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <ProjectReference Include="..\TerminalEngine\TerminalNotes.TerminalEngine.csproj" />
    <ProjectReference Include="..\TerminalTransport\TerminalNotes.TerminalTransport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../TerminalTransport/native/terminalnotes-pty" Link="terminalnotes-pty" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../TerminalTransport/native/terminalnotes-pty')" />
  </ItemGroup>
</Project>
