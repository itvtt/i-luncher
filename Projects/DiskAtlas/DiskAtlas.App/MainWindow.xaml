<Window x:Class="DiskAtlas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:DiskAtlas.App"
        Title="DiskAtlas" Width="1280" Height="850" MinWidth="1050" MinHeight="700"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Malgun Gothic, Segoe UI" WindowStyle="None" ResizeMode="CanResize" Icon="/DiskAtlas;component/Assets/DiskAtlas.ico">
    <Window.Resources>
        <Style x:Key="CancelActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="PathContextMenu" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="위치 열기" Click="OpenLocation_Click"/>
            <MenuItem Header="탐색기에서 선택" Click="SelectInExplorer_Click"/>
            <Separator/>
            <MenuItem Header="경로 복사" Click="CopyPath_Click"/>
        </ContextMenu>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#BAC9DB" BorderThickness="1" CornerRadius="10" Background="{StaticResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/><RowDefinition Height="56"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="74"/><RowDefinition x:Name="MainContentRow" Height="3*" MinHeight="140"/><RowDefinition x:Name="MapSplitterRow" Height="5"/><RowDefinition x:Name="DiskMapRow" Height="2.1*" MinHeight="90"/><RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#182E49">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <Image Source="/DiskAtlas;component/Assets/DiskAtlas.png" Width="23" Height="23" Margin="0,0,10,0"/>
                    <TextBlock Text="D I S K A T L A S" Foreground="White" FontSize="13" FontWeight="Bold"/>
                    <Border Background="#2B4563" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"><TextBlock Text="디스크 분석" FontSize="9" Foreground="#83E6DA"/></Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" AutomationProperties.AutomationId="MinimizeButton" Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" AutomationProperties.AutomationId="MaximizeButton" Style="{StaticResource ChromeButton}" Content="□" FontSize="15" Click="Maximize_Click"/>
                    <Button x:Name="CloseButton" AutomationProperties.AutomationId="CloseButton" Style="{StaticResource ChromeButton}" Content="×" FontSize="19" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="SearchToolbar" Grid.Row="1" Height="36" Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="1.15*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DriveBox" Height="36" Margin="0,0,8,0" DisplayMemberPath="Label" SelectionChanged="DriveBox_SelectionChanged" ToolTip="드라이브 선택"/>
                <TextBox x:Name="PathBox" Grid.Column="1" Height="36" VerticalContentAlignment="Center" AutomationProperties.Name="폴더 경로" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" KeyDown="PathBox_KeyDown"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Style="{StaticResource ActionButton}" Padding="0" Margin="4,0,0,0" ToolTip="폴더 선택" AutomationProperties.Name="폴더 선택" Click="Browse_Click"><Path Width="17" Height="14" Stretch="Uniform" Stroke="#52677D" StrokeThickness="1.4" StrokeLineJoin="Round" Data="M1,3 L7,3 9,5 18,5 18,15 1,15 Z M1,7 L18,7"/></Button>
                <Button x:Name="ScanButton" Grid.Column="3" AutomationProperties.AutomationId="ScanButton" Style="{StaticResource ActionButton}" Padding="10,0" Background="#087F80" Foreground="White" BorderBrush="#087F80" Content="분석" ToolTip="선택한 위치 분석 · F5로 다시 분석" Margin="6,0,0,0" Click="Scan_Click"/>
                <Button x:Name="CancelButton" Grid.Column="4" AutomationProperties.AutomationId="CancelButton" Style="{StaticResource CancelActionButton}" Padding="10,0" Content="취소" Margin="6,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                <Border Grid.Column="5" Width="1" Margin="0,6" Background="{StaticResource StrokeBrush}"/>
                <Grid Grid.Column="6">
                    <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox" Height="36" VerticalContentAlignment="Center" ToolTip="코드 AND 분석: 모두 포함 / 코드 OR 분석: 하나 이상 / &quot;코드 분석&quot;: 문구 일치 · Ctrl+F 검색" AutomationProperties.Name="파일 이름 또는 내용 검색어" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="{Binding SelectedItem.Label, ElementName=SearchModeBox, StringFormat={}{0} 검색}" Margin="10,0" VerticalAlignment="Center" Foreground="#6B7E93" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid>
                <Button x:Name="SearchButton" Grid.Column="7" Background="#176BA0" Foreground="White" BorderBrush="#176BA0" Margin="6,0,0,0" Padding="10,0" Style="{StaticResource ActionButton}" Content="검색" ToolTip="{Binding SelectedItem.Label, ElementName=SearchModeBox, StringFormat={}{0} 검색 · Enter}" Click="Search_Click"/>
                <Button x:Name="SearchCancelButton" Grid.Column="8" Style="{StaticResource CancelActionButton}" Padding="10,0" Content="취소" IsEnabled="False" Margin="6,0,0,0" Click="SearchCancel_Click"/>
                <ToggleButton x:Name="OptionsToggle" Grid.Column="9" Margin="6,0,0,0" ToolTip="검색 및 크기 기준 옵션" AutomationProperties.Name="검색 및 크기 기준 옵션" Foreground="{StaticResource TextBrush}" Background="White" BorderBrush="{StaticResource StrokeBrush}">
                    <ToggleButton.Content><Grid Width="18" Height="18"><Path Stroke="#52677D" StrokeThickness="1.5" Data="M1,4 L17,4 M1,9 L17,9 M1,14 L17,14"/><Ellipse Width="4" Height="4" Fill="White" Stroke="#52677D" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0"/><Ellipse Width="4" Height="4" Fill="White" Stroke="#52677D" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,7,0,0"/><Ellipse Width="4" Height="4" Fill="White" Stroke="#52677D" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,12,0,0"/></Grid></ToggleButton.Content>
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#DDF0F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsToggle}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=OptionsToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <Border Background="White" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Width="260" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="검색 방식" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"/>
                            <ComboBox x:Name="SearchModeBox" Height="36" ItemsSource="{Binding SearchModes}" SelectedIndex="2" ToolTip="내용 검색: 텍스트·코드·로그, DOCX, XLSX, PPTX 지원"/>
                            <CheckBox x:Name="MatchCaseBox" Content="대소문자 구분" Foreground="{StaticResource TextBrush}" Margin="0,12,0,16"/>
                            <TextBlock Text="검색 조건" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"><Run Text="코드 AND 분석  ·  두 단어 모두"/><LineBreak/><Run Text="코드 OR 분석  ·  하나 이상"/><LineBreak/><Run Text="&quot;코드 분석&quot;  ·  문구 그대로"/><LineBreak/><Run Text="(코드 OR 설계) AND 분석"/></TextBlock>
                            <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,0,0,14"/>
                            <TextBlock Text="용량 표시 기준" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"/>
                            <ComboBox x:Name="MetricBox" Height="36" ItemsSource="{Binding MetricChoices}" SelectedIndex="0" SelectionChanged="MetricBox_SelectionChanged" AutomationProperties.AutomationId="MetricBox"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Grid Grid.Row="2">
                <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                <Border x:Name="MessageBar" Background="#FFF4DB" BorderBrush="#E4C577" BorderThickness="0,1" Padding="14,6" MaxHeight="58" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" Foreground="#785513" TextWrapping="Wrap" Margin="0,1"/>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="14,10,14,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <local:MetricCard Grid.Column="0" Label="논리적 크기" Value="{Binding LogicalSizeText}" Accent="#33D6C6"/>
                <local:MetricCard Grid.Column="1" Label="할당 크기" Value="{Binding AllocatedSizeText}" Accent="#8976F5"/>
                <local:MetricCard Grid.Column="2" Label="파일" Value="{Binding FileCountText}" Accent="#5AA9FF"/>
                <local:MetricCard Grid.Column="3" Label="걸린 시간" Value="{Binding ElapsedText}" Accent="#F4B86A"/>
                <local:MetricCard Grid.Column="4" Label="분석 방식" Value="{Binding ScanModeText}" Accent="#6ED68C" IsLast="True"/>
            </Grid>

            <Grid x:Name="ResultsPanelGrid" Grid.Row="4" Margin="14,0,14,8">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ResultsColumn" Width="2.15*"/><ColumnDefinition x:Name="ResultsSplitterColumn" Width="8"/><ColumnDefinition x:Name="ExtensionColumn" Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="10,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="BackButton" Padding="0" Foreground="{StaticResource TextBrush}" Style="{StaticResource ActionButton}" Width="34" Height="30" Content="←" IsEnabled="False" Click="Back_Click"/>
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer>
                        </Grid>
                        <TabControl Grid.Row="1" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid KeyboardNavigation.TabNavigation="Local" ClipToBounds="True">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="138"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#F3F7FB" CornerRadius="7" Margin="0,0,10,0">
                                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Margin="8,10"/>
                                        </Border>
                                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2" SnapsToDevicePixels="True"/>
                                    </Grid>
                                </ControlTemplate>
                            </TabControl.Template>
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Height" Value="42"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="TabSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabSurface" Property="Background" Value="#E7F0F7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabSurface" Property="Background" Value="White"/>
                                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="#C9D9E8"/>
                                                        <Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Foreground" Value="#087F80"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="TabSurface" Property="BorderBrush" Value="#087F80"/>
                                                        <Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabItem Header="폴더">
                                <Grid><DataGrid x:Name="FolderGrid" AutomationProperties.AutomationId="FolderGrid" ItemsSource="{Binding FolderRows}" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionChanged="FolderGrid_SelectionChanged" MouseDoubleClick="FolderGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="이름" Width="*" MinWidth="230">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <Grid Margin="{Binding Indent}"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <Button Content="{Binding ExpanderGlyph}" Visibility="{Binding ExpanderVisibility}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Tag="{Binding}" Click="FolderExpander_Click"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="▰" Foreground="{StaticResource VioletBrush}" Margin="1,0,8,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                </Grid>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="논리 크기" Binding="{Binding SizeText}" Width="110" SortMemberPath="Node.Size"/>
                                        <DataGridTextColumn Header="할당 크기" Binding="{Binding AllocatedText}" Width="110" SortMemberPath="Node.AllocatedSize"/>
                                        <DataGridTextColumn Header="파일" Binding="{Binding FileCountText}" Width="82" SortMemberPath="Node.FileCount"/>
                                        <DataGridTextColumn Header="수정한 날짜" Binding="{Binding ModifiedText}" Width="132" SortMemberPath="Node.LastWriteTimeUtc"/>
                                    </DataGrid.Columns>
                                </DataGrid><Border Background="{StaticResource PanelBrush}" Margin="1,34,1,1"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FolderRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="분석할 위치를 선택하세요"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=ScanButton}" Value="False"><Setter Property="Text" Value="용량을 분석하고 있습니다…"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="상단에서 드라이브나 폴더를 고르고 분석을 누르세요." Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Border></Grid>
                            </TabItem>
                            <TabItem Header="큰 파일" ToolTip="용량이 큰 상위 10,000개 파일">
                                <Grid><DataGrid x:Name="LargeFilesGrid" AutomationProperties.AutomationId="LargeFilesGrid" ItemsSource="{Binding LargeFiles}" AutoGenerateColumns="False" SelectionChanged="FileGrid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="1.2*" MinWidth="180"/>
                                        <DataGridTextColumn Header="경로" Binding="{Binding Directory}" Width="2*" MinWidth="220"/>
                                        <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="100" SortMemberPath="Node.Size"/>
                                        <DataGridTextColumn Header="할당 크기" Binding="{Binding AllocatedText}" Width="105" SortMemberPath="Node.AllocatedSize"/>
                                        <DataGridTextColumn Header="수정한 날짜" Binding="{Binding ModifiedText}" Width="130" SortMemberPath="Node.LastWriteTimeUtc"/>
                                    </DataGrid.Columns>
                                </DataGrid><Border Background="{StaticResource PanelBrush}" Margin="1,34,1,1"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LargeFiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock Text="용량이 큰 파일을 모아 보여줍니다" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/><TextBlock Text="위치를 분석하면 큰 파일부터 확인할 수 있습니다." Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Border></Grid>
                            </TabItem>
                            <TabItem Header="검색 결과">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock x:Name="SearchStatusText" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="선택한 위치에서 검색 · 시스템 파일 제외" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <DataGrid Grid.Row="1" x:Name="SearchResultsGrid" AutomationProperties.AutomationId="SearchResultsGrid" ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False" SelectionChanged="SearchGrid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="1.1*" MinWidth="140"/>
                                            <DataGridTextColumn Header="일치" Binding="{Binding MatchKind}" Width="80"/>
                                            <DataGridTextColumn Header="미리 보기" Binding="{Binding Preview}" Width="2*" MinWidth="220"/>
                                            <DataGridTextColumn Header="경로" Binding="{Binding Directory}" Width="1.5*" MinWidth="180"/>
                                            <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="90" SortMemberPath="Node.Size"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Row="1" Margin="1,34,1,1" Background="{StaticResource PanelBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchResults.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="검색 결과가 없습니다"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled, ElementName=SearchButton}" Value="False"><Setter Property="Text" Value="파일을 확인하고 있습니다…"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="검색어 또는 선택한 위치를 확인하세요. 검색 방식은 오른쪽 옵션에서 변경할 수 있습니다." MaxWidth="410" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="DuplicatesTab" Header="중복 찾기" ToolTip="선택한 위치를 분석하고 내용이 같은 파일 찾기">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                    <Grid Margin="10,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button x:Name="FindDuplicatesButton" AutomationProperties.AutomationId="FindDuplicatesButton" Content="중복 파일 찾기" Style="{StaticResource ActionButton}" Background="#087F80" Foreground="White" BorderBrush="#087F80" Padding="12,0" Click="FindDuplicates_Click"/>
                                        <Button x:Name="CancelDuplicatesButton" AutomationProperties.AutomationId="CancelDuplicatesButton" Grid.Column="1" Content="취소" Style="{StaticResource CancelActionButton}" Padding="10,0" Margin="6,0,0,0" IsEnabled="False" Click="CancelDuplicates_Click"/>
                                        <Button x:Name="OpenDuplicateFolderButton" AutomationProperties.AutomationId="OpenDuplicateFolderButton" Grid.Column="2" Content="폴더 열기" Style="{StaticResource ActionButton}" Padding="10,0" Margin="6,0,0,0" IsEnabled="False" Click="OpenDuplicateFolder_Click"/>
                                        <TextBlock x:Name="DuplicateSummaryText" Grid.Column="3" Text="선택한 위치에서 중복을 찾습니다 · 시스템 파일 제외" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="10,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="DuplicateProgress" Height="5" VerticalAlignment="Top" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="DuplicateStatusText" Margin="0,8,12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="찾기를 누르면 선택한 위치를 분석한 뒤 크기와 내용을 비교합니다." TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <TextBlock x:Name="DuplicateSelectionText" Grid.Column="1" Margin="12,8,0,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="10" Text="선택 0개 · 0 B"/>
                                    </Grid>
                                    <DataGrid Grid.Row="2" x:Name="DuplicateGrid" AutomationProperties.AutomationId="DuplicateGrid" ItemsSource="{Binding DuplicateRows}" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" SelectionChanged="DuplicateGrid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="삭제" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="휴지통으로 이동할 파일 선택"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="1.1*" MinWidth="130"/>
                                            <DataGridTextColumn Header="경로" Binding="{Binding Directory}" Width="1.8*" MinWidth="180"/>
                                            <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size"/>
                                            <DataGridTextColumn Header="오류" Binding="{Binding Error}" Width="1.1*" MinWidth="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Row="2" Margin="1,34,1,1" Background="{StaticResource PanelBrush}" IsHitTestVisible="False">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DuplicateRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock Text="찾은 중복 파일이 없습니다" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/><TextBlock Text="‘중복 파일 찾기’를 누르면 위에서 선택한 위치를 분석합니다. 항목은 자동으로 선택되지 않습니다." MaxWidth="430" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                    </Border>
                                    <Grid Grid.Row="3" Margin="10,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="각 그룹에서 보관할 파일을 최소 1개 남겨야 합니다." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        <ToggleButton x:Name="DuplicateFailuresToggle" AutomationProperties.AutomationId="DuplicateFailuresToggle" Grid.Column="1" Content="{Binding DuplicateFailures.Count}" ContentStringFormat="실패 {0:N0}개" Padding="10,0">
                                            <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Height" Value="30"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding DuplicateFailures.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#DDF0F8"/></Trigger></Style.Triggers></Style></ToggleButton.Style>
                                        </ToggleButton>
                                        <Popup x:Name="DuplicateFailuresPopup" PlacementTarget="{Binding ElementName=DuplicateFailuresToggle}" Placement="Top" IsOpen="{Binding IsChecked, ElementName=DuplicateFailuresToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <Border Background="White" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Width="520" MaxHeight="240" Margin="0,0,0,5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="이동하지 못한 파일" FontWeight="SemiBold" Margin="4,2,4,8"/><ListBox Grid.Row="1" ItemsSource="{Binding DuplicateFailures}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,3"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                                        </Popup>
                                        <Button x:Name="ClearDuplicateSelectionButton" AutomationProperties.AutomationId="ClearDuplicateSelectionButton" Grid.Column="2" Content="선택 해제" Style="{StaticResource ActionButton}" Padding="10,0" Margin="6,0,0,0" IsEnabled="False" Click="ClearDuplicateSelection_Click"/>
                                        <Button x:Name="DeleteDuplicatesButton" AutomationProperties.AutomationId="DeleteDuplicatesButton" Grid.Column="3" Content="선택 파일 휴지통으로" Style="{StaticResource ActionButton}" Background="#B33A3A" Foreground="White" BorderBrush="#B33A3A" Padding="12,0" Margin="6,0,0,0" IsEnabled="False" Click="DeleteDuplicates_Click"/>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="OptimizationTab" Header="저장소 최적화" ToolTip="지정 임시폴더 파일과 선택한 진단 파일 확인 및 정리">
                                <Grid Margin="12,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="4,2,4,10">
                                        <TextBlock Text="저장소 최적화" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="현재 사용자와 Windows의 지정 임시폴더를 정리합니다. 분석 위치나 위쪽 경로와는 별개입니다." Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="임시폴더의 삭제 가능한 파일을 표시합니다. 하위 폴더 포함 옵션을 켜면 내부 폴더도 검사합니다. 시스템·숨김·연결 폴더는 제외합니다. 목록에서 선택한 파일은 영구 삭제됩니다." Margin="0,6,0,0" FontSize="11" Foreground="#52677D" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Row="1" Margin="4,0,4,8">
                                        <Button x:Name="PreviewOptimizationButton" AutomationProperties.AutomationId="PreviewOptimizationButton" Content="정리 대상 검사" Style="{StaticResource ActionButton}" Background="#087F80" Foreground="White" BorderBrush="#087F80" Padding="13,0" Margin="0,0,6,4" Click="PreviewOptimization_Click"/>
                                        <Button x:Name="SelectAllOptimizationButton" AutomationProperties.AutomationId="SelectAllOptimizationButton" Content="전체 선택" Style="{StaticResource ActionButton}" Padding="10,0" Margin="0,0,6,4" IsEnabled="False" Click="SelectAllOptimization_Click"/>
                                        <Button x:Name="ClearOptimizationSelectionButton" AutomationProperties.AutomationId="ClearOptimizationSelectionButton" Content="선택 해제" Style="{StaticResource ActionButton}" Padding="10,0" Margin="0,0,6,4" IsEnabled="False" Click="ClearOptimizationSelection_Click"/>
                                        <Button x:Name="DeleteSelectedOptimizationButton" AutomationProperties.AutomationId="DeleteSelectedOptimizationButton" Content="선택 파일 삭제" Style="{StaticResource ActionButton}" Background="#B33A3A" Foreground="White" BorderBrush="#B33A3A" Padding="11,0" Margin="0,0,6,4" IsEnabled="False" Click="DeleteSelectedOptimization_Click"/>
                                        <Button x:Name="DeleteAllOptimizationButton" AutomationProperties.AutomationId="DeleteAllOptimizationButton" Content="정리 가능 파일 전체 삭제" Style="{StaticResource ActionButton}" Background="#9A3030" Foreground="White" BorderBrush="#9A3030" Padding="11,0" Margin="0,0,6,4" IsEnabled="False" Click="DeleteAllOptimization_Click"/>
                                        <Button x:Name="CancelOptimizationButton" AutomationProperties.AutomationId="CancelOptimizationButton" Content="취소" Style="{StaticResource CancelActionButton}" Padding="12,0" Margin="0,0,6,4" IsEnabled="False" Click="CancelOptimization_Click"/>
                                    </WrapPanel>
                                    <Border Grid.Row="2" Margin="4,0,4,8" Padding="10,7" Background="#F3F7FB" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel>
                                            <CheckBox x:Name="IncludeTemporarySubfoldersCheckBox" Content="임시폴더 하위 폴더 포함" IsChecked="True" Margin="0,0,0,5" Checked="OptimizationOptions_Changed" Unchecked="OptimizationOptions_Changed"/>
                                            <WrapPanel VerticalAlignment="Center">
                                                <CheckBox x:Name="IncludeCrashDumpsCheckBox" Content="30일 지난 크래시 덤프" IsChecked="False" Margin="0,0,18,0" Checked="OptimizationOptions_Changed" Unchecked="OptimizationOptions_Changed"/>
                                                <CheckBox x:Name="IncludeErrorReportsCheckBox" Content="30일 지난 오류 보고서" IsChecked="False" Checked="OptimizationOptions_Changed" Unchecked="OptimizationOptions_Changed"/>
                                            </WrapPanel>
                                            <TextBlock Text="크래시 덤프와 오류 보고서는 문제 분석에 쓰일 수 있으며, 두 옵션은 기본적으로 꺼져 있습니다." Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="3" Margin="4,0,4,4">
                                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="OptimizationStatusText" Text="아직 검사하지 않았습니다" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <TextBlock x:Name="OptimizationCandidateCountText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="10" Text="후보 —개"/>
                                            <TextBlock x:Name="OptimizationSelectedCountText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="10" Text="선택 —개"/>
                                            <TextBlock x:Name="OptimizationSkippedCountText" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="건너뜀 —개"/>
                                            <TextBlock x:Name="OptimizationFailedCountText" Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#B33A3A" FontSize="10" Text="실패 —개"/>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <TextBlock x:Name="OptimizationCategorySummaryText" Margin="0,3,0,2" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="유형별 파일 수와 크기는 검사 후 표시됩니다." TextWrapping="Wrap"/>
                                            <ProgressBar x:Name="OptimizationProgress" Grid.Row="1" Height="4" VerticalAlignment="Top" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"/>
                                            <DataGrid x:Name="OptimizationResultsGrid" Grid.Row="1" Margin="0,7,0,0" ItemsSource="{Binding OptimizationRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="선택" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" Click="OptimizationRow_SelectionChanged" ToolTip="이 후보 파일을 삭제 대상으로 선택"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="유형" Binding="{Binding CategoryText}" Width="125"/>
                                                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="150"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Name}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                                    <DataGridTextColumn Header="파일 경로" Binding="{Binding Path}" Width="2*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                                    <DataGridTextColumn Header="파일 크기" Binding="{Binding SizeText}" Width="95"/>
                                                    <DataGridTextColumn Header="수정한 날짜" Binding="{Binding ModifiedText}" Width="130"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border x:Name="OptimizationEmptyState" Grid.Row="1" Margin="0,39,0,0" Background="{StaticResource PanelBrush}" IsHitTestVisible="False">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                                    <TextBlock x:Name="OptimizationEmptyTitle" Text="아직 검사하지 않았습니다" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="OptimizationEmptyDescription" Text="정리 대상을 검사해 후보 목록을 먼저 확인하세요." MaxWidth="430" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="4" Margin="4,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OptimizationScopeStatusText" Text="후보 목록을 확인한 뒤 삭제하세요. 선택한 파일은 영구 삭제됩니다." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <TextBlock Grid.Column="1" x:Name="OptimizationDeletedBytesText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="삭제한 파일 크기: —"/>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
                <GridSplitter x:Name="ResultsSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
                <Border x:Name="ExtensionPanel" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="파일 유형 · 색상 범례" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ExtensionScopeText" Grid.Column="1" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="전체 파일" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource AccentBrush}"/></Grid>
                        <DataGrid x:Name="ExtensionGrid" Grid.Row="1" ItemsSource="{Binding Extensions}" AutoGenerateColumns="False" SelectionChanged="ExtensionGrid_SelectionChanged" ToolTip="파일 유형을 선택하면 디스크 맵에서 해당 색상을 강조합니다">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="형식" Width="*" SortMemberPath="Extension"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="11" Height="11" CornerRadius="2" Background="{Binding ColorBrush}" Margin="7,0,7,0"/><TextBlock Text="{Binding Extension}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="파일" Binding="{Binding CountText}" Width="70" SortMemberPath="Count"/>
                                <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size"/>
                                <DataGridTextColumn Header="비율" Binding="{Binding PercentText}" Width="58" SortMemberPath="Percent"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="MapSplitter" Grid.Row="5" Height="5" HorizontalAlignment="Stretch" Margin="14,0" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="드래그하여 표와 디스크 맵 높이 조절"/>
            <Border x:Name="DiskMapPanel" Grid.Row="6" Margin="14,0,14,8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="디스크 맵" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/><Button x:Name="ClearTypeHighlightButton" Grid.Column="1" Content="유형 강조 해제" Style="{StaticResource ActionButton}" Height="25" Padding="9,0" Margin="12,0,0,0" Visibility="Collapsed" Click="ClearTypeHighlight_Click"/><TextBlock x:Name="TreemapScopeText" Grid.Column="2" Text="파일 크기는 면적, 파일 유형은 색상으로 표시됩니다" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" HorizontalAlignment="Right" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}"/></Grid>
                    <local:TreemapControl x:Name="Treemap" Grid.Row="1" Margin="5" NodeSelected="Treemap_NodeSelected" FolderInvoked="Treemap_FolderInvoked"/>
                </Grid>
            </Border>
            <Grid Grid.Row="7" Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ctrl+F 검색 · F5 분석 · Esc 취소" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectionText" Grid.Column="1" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
            </Grid>
        </Grid>
    </Border>
</Window>
