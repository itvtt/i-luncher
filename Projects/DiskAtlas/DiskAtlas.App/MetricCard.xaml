<UserControl x:Class="DiskAtlas.App.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Edge" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="16,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{Binding Accent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
