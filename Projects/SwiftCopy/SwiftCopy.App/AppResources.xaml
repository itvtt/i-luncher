<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Ink" Color="#172033"/>
 <SolidColorBrush x:Key="Muted" Color="#667085"/>
 <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
 <SolidColorBrush x:Key="Canvas" Color="#F4F7FC"/>
 <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="Line" Color="#D9E2F0"/>

 <Style TargetType="Button">
  <Setter Property="Background" Value="#FFFFFF"/>
  <Setter Property="Foreground" Value="#344054"/>
  <Setter Property="Padding" Value="14,8"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="BorderBrush" Value="#C7D2E3"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"
             RenderOptions.ClearTypeHint="Enabled">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#93A8C7"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#667085"/><Setter TargetName="Surface" Property="Background" Value="#F2F4F7"/><Setter TargetName="Surface" Property="BorderBrush" Value="#E4E7EC"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F5FB"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E5EBF5"/></Trigger>
  </Style.Triggers>
 </Style>

 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="BorderBrush" Value="#93B4F6"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DBEAFE"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="CopyAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/>
  <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/><Setter Property="BorderBrush" Value="#1D4ED8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1E40AF"/></Trigger></Style.Triggers>
 </Style>

 <Style TargetType="TextBox">
  <Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="#FFFFFF"/>
  <Setter Property="Foreground" Value="#172033"/><Setter Property="CaretBrush" Value="#2563EB"/>
  <Setter Property="BorderBrush" Value="#B8C7DB"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" RenderOptions.ClearTypeHint="Enabled">
      <Grid>
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
       <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#667085" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed" FontSize="14"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#667085"/><Setter TargetName="Surface" Property="Background" Value="#F2F4F7"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <Style x:Key="Card" TargetType="Border">
  <Setter Property="Background" Value="#FFFFFF"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#D9E2F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/>
  <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#17365F" BlurRadius="14" ShadowDepth="2" Opacity="0.09"/></Setter.Value></Setter>
 </Style>
 <Style x:Key="PanelArea" TargetType="Border">
  <Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#B8C7DB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#6E9BE8"/><Setter Property="Background" Value="#F3F7FE"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#2563EB"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="PanelAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Width" Value="84"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="Padding" Value="9"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="Background" Value="#EFF6FF"/><Setter Property="BorderBrush" Value="#A8C2F3"/>
 </Style>
 <Style x:Key="ClearAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="MinWidth" Value="58"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="9,4"/><Setter Property="Foreground" Value="#667085"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#D5DEEA"/><Setter Property="FontSize" Value="13"/>
 </Style>
 <Style x:Key="Metric" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F8FAFF"/><Setter Property="Margin" Value="0,4,0,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
 </Style>
 <Style x:Key="MetricLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#AFC5E5"/>
 </Style>
 <Style x:Key="MetricCell" TargetType="Border">
  <Setter Property="Background" Value="#173154"/><Setter Property="BorderBrush" Value="#315680"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,0,8,0"/>
 </Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="#172033"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#344054"/><Setter Property="Padding" Value="8,5"/></Style>
</ResourceDictionary>
