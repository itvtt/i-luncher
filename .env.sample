# i-luncher 빌드 설정 예시
# 이 파일을 복사해 값을 채우세요. 둘 곳: 프로필 폴더(사용자 환경 변수 APPS_ENV_DIR)의 i-luncher.env (권장) 또는 저장소 루트의 .env (있으면 이쪽이 먼저).
# 어느 쪽도 git 에 올리지 않습니다.
# 빌드할 때 아래 줄만 골라 i-luncher.exe 옆 launcher.env 로 들어갑니다 (다른 줄은 무시).
# Actions 러너에서는 Secret ILUNCHER_ENV (이 내용 전체) 또는 러너 PC 의 .env 경로(ILUNCHER_ENV_PATH)로 넣습니다.

# API 서버 (이 저장소의 CDEP\relay.py, 예: http://<서버 IP>:2003). 마스터 계정만 씀: 서버 목록을 이 서버에서 읽고 고침(고칠 때 관리자 비밀번호). 공지는 GitHub(NOTICES_REPOSITORY).
# 일반 사용자의 런처는 이 서버를 쓰지 않음. 릴리스(버전 · 설치 · 업데이트)는 누구나 GitHub 에 바로 물음 (비공개면 프로젝트마다 넣은 토큰, 마스터 PC 는 git 로그인, 또는 LAUNCHER_TOKEN)
API_SERVER=

# 마스터 계정 (쉼표로, 이 PC 의 Windows 계정 이름). 여기 있는 계정만 서버 목록 · 공지 · 관리자 메뉴를 봅니다.
# 그 밖의 사람(일반)은 런처에 든 기본 목록(basic-apps.json)만 보는 로컬 앱 (공지는 모두 GitHub 에서). 비우면 모두 일반
# 설치된 앱의 사용 기록(AppKit AppUsage)도 이 계정만 보냅니다
MASTER_USERS=

# 런처 자신의 릴리스 저장소 (자체 업데이트). Actions 러너에서 빌드할 때 비워 두면 그 러너의 저장소를 씁니다.
LAUNCHER_REPOSITORY=

# 앱 목록 저장소와 파일. 비우면 LAUNCHER_REPOSITORY 의 catalog/apps.json.
# 런처에서 앱을 추가·수정·삭제하면 이 파일에 커밋이 생깁니다 (쓰기 권한 있는 사용자 토큰 필요).
CATALOG_REPOSITORY=
CATALOG_PATH=catalog/apps.json
# 비우면 저장소 기본 브랜치
CATALOG_BRANCH=

# 공지: 모든 런처가 GitHub 공지 저장소의 파일을 바로 읽음 (공개 저장소, 토큰 없음). 첫 줄 제목, 다음 줄부터 본문, 공지 사이는 --- 줄
# 저장소: 비우면 i-luncher-notices (이름만이면 LAUNCHER_REPOSITORY 와 같은 호스트 · 소유자)
NOTICES_REPOSITORY=
NOTICES_PATH=공지.txt

# GitHub Enterprise 호스트 (예: github.example.com). "owner/repo" 처럼 짧게 입력한 주소에 씀. 릴리스는 이 호스트의 GitHub API 에 바로 물음.
# 비우면 LAUNCHER_REPOSITORY 의 호스트
GITHUB_HOST=

# 읽기 전용 토큰 (contents: read). 비우면 각 사용자가 프로젝트마다 앱 우클릭 → 토큰… 으로 넣음. 넣으면 비공개·internal 저장소의 릴리스를 모든 사용자가 읽음.
# 앱 안에 들어가므로 쓰기 권한은 절대 주지 마세요. 이 호스트(GITHUB_HOST 또는 LAUNCHER_REPOSITORY 의 호스트)로만 보냅니다.
LAUNCHER_TOKEN=
