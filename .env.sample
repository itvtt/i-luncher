# i-luncher 빌드 설정 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올리지 않습니다.
# 빌드할 때 아래 줄만 골라 i-luncher.exe 옆 launcher.env 로 들어갑니다 (다른 줄은 무시).
# Actions 러너에서는 Secret ILUNCHER_ENV (이 내용 전체) 또는 러너 PC 의 .env 경로(ILUNCHER_ENV_PATH)로 넣습니다.

# API 서버 (ApiServer 프로젝트, 예: http://192.168.0.32:2003). 쓰면 앱 목록·공지를 이 서버에서 읽고 고치며(고칠 때 관리자 비밀번호),
# github.com 저장소의 릴리스는 이 서버의 GitHub 중계로 받아 사용자 PC 에 GitHub 토큰이 필요 없습니다.
API_SERVER=

# 런처 자신의 릴리스 저장소 (자체 업데이트). Actions 러너에서 빌드할 때 비워 두면 그 러너의 저장소를 씁니다.
LAUNCHER_REPOSITORY=

# 앱 목록 저장소와 파일. 비우면 LAUNCHER_REPOSITORY 의 catalog/apps.json.
# 런처에서 앱을 추가·수정·삭제하면 이 파일에 커밋이 생깁니다 (쓰기 권한 있는 사용자 토큰 필요).
CATALOG_REPOSITORY=
CATALOG_PATH=catalog/apps.json
# 비우면 저장소 기본 브랜치
CATALOG_BRANCH=

# 공지 파일 (앱 목록 저장소 안). 첫 줄 제목, 다음 줄부터 본문, 공지 사이는 --- 줄
NOTICES_PATH=공지.txt

# 사내 GitHub 호스트 (예: github.company.com). "owner/repo" 처럼 짧게 입력한 주소에 씀. 비우면 LAUNCHER_REPOSITORY 의 호스트
GITHUB_HOST=

# 읽기 전용 토큰 (contents: read). 비공개·internal 저장소의 릴리스와 앱 목록을 모든 사용자가 읽게 함.
# 앱 안에 들어가므로 쓰기 권한은 절대 주지 마세요. 이 호스트(GITHUB_HOST 또는 LAUNCHER_REPOSITORY 의 호스트)로만 보냅니다.
# 앱 목록을 바꾸는 관리자는 런처 설정에서 자기 토큰(contents: write)을 따로 등록합니다.
LAUNCHER_TOKEN=
