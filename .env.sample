# i-luncher 빌드 설정 예시
# 이 파일을 복사해 값을 채우세요. 둘 곳: 프로필 폴더(사용자 환경 변수 APPS_ENV_DIR)의 i-luncher.env (권장) 또는 저장소 루트의 .env (있으면 이쪽이 먼저).
# 어느 쪽도 git 에 올리지 않습니다.
# 빌드할 때 아래 줄만 골라 i-luncher.exe 옆 launcher.env 로 들어갑니다 (다른 줄은 무시).
# Actions 러너에서는 Secret ILUNCHER_ENV (이 내용 전체) 또는 러너 PC 의 .env 경로(ILUNCHER_ENV_PATH)로 넣습니다.

# API 서버 (이 저장소의 ApiManager\server\relay.py, 예: http://<서버 IP>:2003). 쓰면 앱 목록·공지를 이 서버에서 읽고 고치며(고칠 때 관리자 비밀번호),
# github.com 과 GITHUB_HOST 저장소의 릴리스는 이 서버의 GitHub 중계로 받아 사용자 PC 에 GitHub 토큰이 필요 없습니다.
# (GitHub Enterprise 면 서버 SETTINGS 의 RELAY_GITHUB_API 를 https://<호스트>/api/v3 로)
API_SERVER=

# 마스터 계정 (쉼표로, Windows 계정 이름). 앱 목록에서 "마스터 계정에만 보이기"로 둔 앱(예: API 서버)은 이 계정에만 보입니다.
# 비우면 제한 없음 (모두에게 보임)
# 왼쪽 아래 API Manager(API 서버 관리)는 여기 적은 계정에만 보입니다 (비우면 아무에게도 안 보임)
MASTER_USERS=

# 런처 자신의 릴리스 저장소 (자체 업데이트). Actions 러너에서 빌드할 때 비워 두면 그 러너의 저장소를 씁니다.
LAUNCHER_REPOSITORY=

# 앱 목록 저장소와 파일. 비우면 LAUNCHER_REPOSITORY 의 catalog/apps.json.
# 런처에서 앱을 추가·수정·삭제하면 이 파일에 커밋이 생깁니다 (쓰기 권한 있는 사용자 토큰 필요).
CATALOG_REPOSITORY=
CATALOG_PATH=catalog/apps.json
# 비우면 저장소 기본 브랜치
CATALOG_BRANCH=

# 공지 파일 (앱 목록 저장소 안). 첫 줄 제목, 다음 줄부터 본문, 공지 사이는 --- 줄
NOTICES_PATH=공지.txt

# GitHub Enterprise 호스트 (예: github.example.com). "owner/repo" 처럼 짧게 입력한 주소에 쓰고, API_SERVER 가 있으면 이 호스트도 중계로 받음.
# 비우면 LAUNCHER_REPOSITORY 의 호스트
GITHUB_HOST=

# 읽기 전용 토큰 (contents: read). API 서버 중계를 쓰지 않을 때만: 비공개·internal 저장소의 릴리스와 앱 목록을 모든 사용자가 읽게 함.
# 앱 안에 들어가므로 쓰기 권한은 절대 주지 마세요. 이 호스트(GITHUB_HOST 또는 LAUNCHER_REPOSITORY 의 호스트)로만 보냅니다.
LAUNCHER_TOKEN=
