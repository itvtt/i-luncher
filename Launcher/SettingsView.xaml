<UserControl x:Class="ILauncher.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 런처 오른쪽 화면의 설정 (일반 사용자용): 서버 주소 · 자동 업데이트. 관리 일은 관리자 메뉴에서 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 런처 본 화면과 같은 무채색 -->
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,0,0,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#FF98989D" />
            </Style>
            <Style x:Key="PageCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#FF242427" />
                <Setter Property="BorderBrush" Value="#FF2E3036" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,14,18,16" />
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>
            <Style x:Key="PageTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
                <Setter Property="Background" Value="#FF1C1C1E" />
                <Setter Property="BorderBrush" Value="#FF3A3B41" />
            </Style>
            <Style x:Key="PageHintStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#FF8E8E93" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="30,20,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 큰 제목 · 저장 (런처의 다른 화면과 같은 머리) -->
        <DockPanel>
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="저장" Height="32" MinWidth="76" Padding="16,0" VerticalAlignment="Center"
                    IsEnabled="False" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
            <TextBlock Text="설정" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" Padding="0,0,8,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left" MinWidth="360">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="연결" />
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" Text="서버 주소" />
                        <Grid>
                            <TextBox x:Name="ApiServerBox" Style="{StaticResource PageTextBoxStyle}" AutomationProperties.Name="서버 주소" TextChanged="Field_Changed" />
                            <TextBlock x:Name="ApiServerPlaceholder" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF8E8E93" />
                        </Grid>
                        <TextBlock Style="{StaticResource PageHintStyle}" Text="비워 두면 기본 서버를 씁니다." />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="업데이트" />
                <Border Style="{StaticResource PageCardStyle}">
                    <CheckBox x:Name="AutoUpdateBox" Margin="0" FontSize="13" Content="i-luncher 자동 업데이트" Checked="Field_Changed" Unchecked="Field_Changed" />
                </Border>

                <TextBlock x:Name="ErrorText" Margin="4,0,0,16" FontSize="12.5" Foreground="#FFF0CF8A" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
