<UserControl x:Class="ILauncher.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 런처 오른쪽 화면의 설정: (마스터만) API 서버 주소 · 런처 공지 편집, 자동 업데이트 (누르면 바로 저장), 재설정, 저장 위치.
         API 서버의 관리(앱 목록 · 릴리스 · 러너 · 공지 · API)는 서버 PC 의 i-api.exe 관리 창 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 런처 본 화면과 같은 무채색 -->
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,0,0,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#FF98989D" />
            </Style>
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,3,12,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#FF98989D" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PageCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#FF242427" />
                <Setter Property="BorderBrush" Value="#FF2E3036" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,14,18,16" />
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="30,20,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="설정" FontSize="28" FontWeight="Bold" />

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" Padding="0,0,8,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
            <StackPanel Width="440" HorizontalAlignment="Left">
                <!-- 마스터만: 서버 목록 · 스크린샷 · 앱 사용 기록이 가는 API 서버, 모든 런처에 보이는 공지 (GitHub) -->
                <StackPanel x:Name="MasterSection" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="API 서버" />
                    <Border Style="{StaticResource PageCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ApiServerBox" Style="{StaticResource FieldTextBoxStyle}" AutomationProperties.Name="API 서버 주소" KeyDown="ApiServerBox_KeyDown" />
                                <Button x:Name="ConnectButton" Grid.Column="1" Content="연결" Padding="14,6" Margin="8,0,0,0" MinWidth="72" Style="{StaticResource PrimaryButtonStyle}" Click="Connect_Click" />
                            </Grid>
                            <TextBlock x:Name="ApiServerHint" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="런처 공지" />
                    <Border Style="{StaticResource PageCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="모든 런처의 공지" FontSize="13" />
                                <TextBlock Text="GitHub 공지 저장소의 공지.txt (첫 줄 제목, 공지 사이 ---)" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="GitHub에서 편집" Padding="14,6" Style="{StaticResource ToolbarButtonStyle}" Click="EditNotices_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="업데이트" />
                <Border Style="{StaticResource PageCardStyle}">
                    <CheckBox x:Name="AutoUpdateBox" Margin="0" FontSize="13" Content="i-luncher 자동 업데이트" Checked="AutoUpdateBox_Changed" Unchecked="AutoUpdateBox_Changed" />
                </Border>

                <!-- 재설정: 줄마다 무엇을 지우는지, 누르면 아래에 확인 (설치한 앱은 그대로) -->
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="재설정" />
                <Border Style="{StaticResource PageCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="목록" FontSize="13" />
                                <TextBlock Text="뺀 앱 다시 보이기 · 목록 새로 받기" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                            <Button x:Name="ResetListButton" Grid.Column="1" Content="되돌리기" Padding="14,6" MinWidth="82" Style="{StaticResource ToolbarButtonStyle}" Click="ResetList_Click" />
                        </Grid>
                        <Border Height="1" Margin="0,12" Background="#FF2E3036" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="전체" FontSize="13" />
                                <TextBlock Text="설정 · 토큰 · 즐겨찾기 · 내 앱 · 캐시 (설치한 앱은 그대로)" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                            <Button x:Name="ResetAllButton" Grid.Column="1" Content="재설정" Padding="14,6" MinWidth="82" Style="{StaticResource ToolbarButtonStyle}" Click="ResetAll_Click" />
                        </Grid>
                        <Border x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,10" CornerRadius="9" Background="#FF1C1C1E" BorderBrush="#FF3A3A3C" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ConfirmText" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="취소" Padding="12,6" Margin="10,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Click="CancelReset_Click" />
                                <Button x:Name="ConfirmButton" Grid.Column="2" Content="다시 시작" Padding="12,6" Margin="6,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmReset_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 백업할 사용자 데이터 폴더 (C:\i-luncher). 캐시는 %LOCALAPPDATA%\i-luncher 라 보이지 않음 -->
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="저장 위치" />
                <Border Style="{StaticResource PageCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DataFolderText" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="새 PC 에 이 폴더를 복사하면 그대로 (토큰 제외)" Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="열기" Padding="14,6" Style="{StaticResource ToolbarButtonStyle}" Click="OpenFolder_Click" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
