<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 홈 화면과 같은 어두운 판의 작은 창 (GitHub 프로젝트 추가 · 내 앱 삭제): 둥근 카드, 그림자, 파란 주 단추, 빨간 삭제 단추 -->
    <SolidColorBrush x:Key="DialogMutedBrush" Color="#FF9A9AA2" />

    <Style x:Key="DialogCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#FF1F2023" />
        <Setter Property="BorderBrush" Value="#FF34353B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="26,22,26,24" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#FF000000" /></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,16,0,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFB4B4BA" />
    </Style>

    <!-- 입력 칸: 둥근 어두운 칸, 누르면 파란 테두리 -->
    <Style x:Key="DialogFieldStyle" TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="#FFF5F5F7" />
        <Setter Property="CaretBrush" Value="#FFF5F5F7" />
        <Setter Property="SelectionBrush" Value="#FF0A84FF" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" Background="#FF141416" BorderBrush="#FF3A3B42" BorderThickness="1.5" CornerRadius="11">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#FF4A4B52" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#FF0A84FF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 여러 줄 입력 칸 (상세 설명) -->
    <Style x:Key="DialogAreaStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="#FFF5F5F7" />
        <Setter Property="CaretBrush" Value="#FFF5F5F7" />
        <Setter Property="SelectionBrush" Value="#FF0A84FF" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" Background="#FF141416" BorderBrush="#FF3A3B42" BorderThickness="1.5" CornerRadius="11">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#FF4A4B52" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#FF0A84FF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 작은 보조 단추 (자동 · 이미지 파일… · 스크린샷 추가) -->
    <Style x:Key="DialogSmallButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="#FF2C2D32" />
        <Setter Property="Foreground" Value="#FFE5E5EA" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF3A3B42" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 고르기 타일 (기본 아이콘): 투명 단추, 고른 것은 파란 고리 -->
    <Style x:Key="DialogTileStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Ring" CornerRadius="11" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" Padding="2" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Background" Value="#22FFFFFF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 보통 단추 · 주 단추(파랑) · 삭제 단추(빨강) -->
    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="#FF2C2D32" />
        <Setter Property="Foreground" Value="#FFF5F5F7" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#99FFFFFF" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.35" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DialogPrimaryStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="Background" Value="#FF0A84FF" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="DialogDangerStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="Background" Value="#FFE5484D" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- 오른쪽 위 닫기 -->
    <Style x:Key="DialogCloseStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF2C2D32" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 분류 고르기: 둥근 알약, 고른 것은 파랑 -->
    <Style x:Key="DialogChipStyle" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,6,6,0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="#FF2C2D32" />
        <Setter Property="Foreground" Value="#FFE5E5EA" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 고르기 카드 (내 앱 삭제: 목록에서만 빼기 / 설치된 앱도 제거): 동그라미 + 제목 + 설명, 고른 카드는 파란 테두리 -->
    <Style x:Key="DialogChoiceStyle" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#FFF5F5F7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" Padding="14,12" CornerRadius="14" Background="#FF26272B" BorderBrush="#FF303137" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring" Stroke="#FF6B6C74" StrokeThickness="1.6" />
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FF0A84FF" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#FF2C2D32" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="#FF0A84FF" />
                            <Setter TargetName="Card" Property="Background" Value="#1A0A84FF" />
                            <Setter TargetName="Ring" Property="Stroke" Value="#FF0A84FF" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
