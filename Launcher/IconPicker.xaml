<UserControl x:Class="ILauncher.IconPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 아이콘 고르기: 미리 보기 + [자동] [이미지 파일…] + 기본 아이콘 -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Width="56" Height="56">
                <Border x:Name="PreviewPlate" CornerRadius="14" />
                <TextBlock x:Name="PreviewInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" />
                <Image x:Name="PreviewImage" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="#FFB4B4BA" TextWrapping="Wrap" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button x:Name="AutoButton" Style="{StaticResource DialogSmallButtonStyle}" Margin="0,0,6,0" Click="Auto_Click" Content="자동" />
                    <Button x:Name="BuiltinButton" Style="{StaticResource DialogSmallButtonStyle}" Margin="0,0,6,0" Click="Builtin_Click" Content="기본 아이콘" />
                    <Button x:Name="FileButton" Style="{StaticResource DialogSmallButtonStyle}" Click="File_Click" Content="이미지 파일…" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <WrapPanel x:Name="BuiltinTiles" Margin="0,12,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
