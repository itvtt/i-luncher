<Window x:Class="ILauncher.GitHubProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ILauncher"
        Title="GitHub 프로젝트 추가"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#FFF5F5F7"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
                <ResourceDictionary Source="DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--
        GitHub 프로젝트 추가 · 내 앱 편집: 저장소 주소 → [확인]으로 최신 릴리스와 설치 파일을 확인 →
        이름 · 분류 · 설명 · 아이콘 → [추가]. 이 PC 의 "내 앱"이 됨 (설치됨 탭). 편집은 저장소를 빼고 모두 바꿈
    -->
    <Grid Margin="14">
        <Border Style="{StaticResource DialogCardStyle}" Padding="0" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <!-- 머리 -->
                <Grid Margin="26,22,26,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13" Background="#FF2C2D32" VerticalAlignment="Top">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Foreground="#FFE5E5EA" Text="&#xE943;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,1,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Text="GitHub 프로젝트 추가" />
                        <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" FontSize="12.5" Foreground="{StaticResource DialogMutedBrush}" Text="저장소의 릴리스로 설치 · 업데이트합니다. 이 PC 에만 추가됩니다." />
                    </StackPanel>
                    <Button Grid.Column="2" Margin="8,-4,-8,0" VerticalAlignment="Top" Style="{StaticResource DialogCloseStyle}" Click="Cancel_Click" ToolTip="닫기 (Esc)" AutomationProperties.Name="닫기">
                        <Path Width="11" Height="11" Data="M 0.5,0.5 L 10.5,10.5 M 10.5,0.5 L 0.5,10.5" Stroke="#FFB4B4BA" StrokeThickness="1.4" />
                    </Button>
                </Grid>

                <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="26,0,26,0">
                        <!-- 저장소 -->
                        <TextBlock Style="{StaticResource DialogLabelStyle}" Margin="2,20,0,8" Text="저장소" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="RepoBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="저장소 주소" TextChanged="RepoBox_TextChanged" KeyDown="RepoBox_KeyDown" />
                                <TextBlock x:Name="RepoPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76"
                                           Text="https://github.com/소유자/저장소  또는  소유자/저장소" />
                            </Grid>
                            <Button x:Name="CheckButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="76" Style="{StaticResource DialogButtonStyle}" Click="Check_Click" Content="확인" />
                        </Grid>
                        <TextBlock x:Name="ErrorText" Margin="2,10,0,0" FontSize="12.5" Foreground="#FFFF9F8A" TextWrapping="Wrap" Visibility="Collapsed" />
                        <!-- 비공개라 읽지 못했을 때만: 이 프로젝트의 토큰 (넣고 다시 확인) -->
                        <Grid x:Name="TokenRow" Margin="0,10,0,0" Visibility="Collapsed">
                            <PasswordBox x:Name="TokenBox" Style="{StaticResource DialogPasswordStyle}" AutomationProperties.Name="이 프로젝트의 토큰"
                                         PasswordChanged="TokenBox_PasswordChanged" KeyDown="RepoBox_KeyDown" />
                            <TextBlock x:Name="TokenPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76"
                                       Text="이 프로젝트의 토큰 붙여넣기 (읽기 권한)" />
                        </Grid>

                        <!-- 확인한 프로젝트 -->
                        <StackPanel x:Name="Details" Visibility="Collapsed">
                            <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="14" Background="#FF26272B" BorderBrush="#FF303137" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid Width="48" Height="48" VerticalAlignment="Center">
                                        <Border x:Name="PreviewTile" CornerRadius="12">
                                            <TextBlock x:Name="PreviewInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <Image x:Name="PreviewImage" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PreviewName" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <Border x:Name="PreviewVersionPill" Padding="7,1,7,2" CornerRadius="6" Background="#2630D158">
                                                <TextBlock x:Name="PreviewVersion" FontSize="11.5" FontWeight="SemiBold" Foreground="#FF5BE3A3" />
                                            </Border>
                                            <TextBlock x:Name="PreviewFile" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource DialogMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="이름" />
                            <TextBox x:Name="NameBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="이름" TextChanged="Field_Changed" />

                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="분류" />
                            <Grid>
                                <TextBox x:Name="CategoryBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="분류" TextChanged="Category_Changed" />
                                <TextBlock x:Name="CategoryPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76" Text="비우면 기타 · 아래에서 고르거나 직접 쓰기" />
                            </Grid>
                            <WrapPanel x:Name="CategoryChips" Margin="0,4,0,0" />

                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="설명" />
                            <Grid>
                                <TextBox x:Name="DescriptionBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="설명" TextChanged="Field_Changed" />
                                <TextBlock x:Name="DescriptionPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76" Text="칸 · 스토어 줄에 보일 한 줄 (선택)" />
                            </Grid>

                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="아이콘" />
                            <local:IconPicker x:Name="IconChoice" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 단추 -->
                <StackPanel Grid.Row="2" Margin="26,22,26,24" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="96" Margin="0,0,8,0" Style="{StaticResource DialogButtonStyle}" Click="Cancel_Click" Content="취소" />
                    <Button x:Name="AddButton" Width="96" Style="{StaticResource DialogPrimaryStyle}" Click="Add_Click" Content="추가" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
