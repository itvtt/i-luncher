<Window x:Class="ILauncher.FavoriteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로그램"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFF5F7FB"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProgramItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#FF222B38" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#FF2A3D5C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Border Background="#FF19212B" BorderBrush="#FF354252" BorderThickness="1" CornerRadius="18" Padding="24,20,24,22"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.38" Color="#FF000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Text="프로그램 추가" />

                <!-- 추가할 때만: 설치된 프로그램(시작 메뉴)에서 고르기 -->
                <StackPanel x:Name="PickerPanel">
                    <Grid Margin="0,16,0,6">
                        <TextBox x:Name="FilterBox" Style="{StaticResource FieldTextBoxStyle}" AutomationProperties.Name="설치된 프로그램 검색" TextChanged="FilterBox_TextChanged" />
                        <TextBlock x:Name="FilterPlaceholder" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}" Text="설치된 프로그램 검색" />
                    </Grid>
                    <ListBox x:Name="ProgramList" Height="200" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             Padding="4" ItemContainerStyle="{StaticResource ProgramItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ProgramList_SelectionChanged" MouseDoubleClick="ProgramList_MouseDoubleClick" AutomationProperties.Name="설치된 프로그램">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="이름" />
                <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBoxStyle}" AutomationProperties.Name="이름" TextChanged="Field_Changed" />

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="경로" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Style="{StaticResource FieldTextBoxStyle}" AutomationProperties.Name="경로" TextChanged="Field_Changed" />
                    <Button Grid.Column="1" Content="찾아보기" Height="34" Margin="8,0,0,0" Padding="12,0" Click="BrowseButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                </Grid>

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="실행 인수 (선택)" />
                <TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldTextBoxStyle}" AutomationProperties.Name="실행 인수" TextChanged="Field_Changed" />

                <TextBlock x:Name="ErrorText" Margin="0,12,0,0" FontSize="12" Foreground="#FFF0CF8A" TextWrapping="Wrap" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="취소" Width="90" Height="36" Margin="0,0,8,0" Padding="0" IsCancel="True" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="SaveButton" Content="저장" Width="90" Height="36" Padding="0" IsDefault="True" IsEnabled="False" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
