<Window x:Class="ILauncher.FavoriteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ILauncher"
        Title="즐겨찾기"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#FFF5F5F7"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
                <ResourceDictionary Source="DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProgramItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Foreground" Value="#FFE5E5EA" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#FF2C2D32" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#400A84FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 즐겨찾기 추가 · 편집: 이 PC 프로그램(설치된 프로그램에서 고르기 · 찾아보기) 또는 웹사이트(주소 → [확인]으로 이름 · 아이콘). 아이콘은 자동 · 기본 아이콘 · 이미지 파일 -->
    <Grid Margin="14">
        <Border Style="{StaticResource DialogCardStyle}" Padding="0" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <!-- 머리 -->
                <Grid Margin="26,22,26,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13" Background="#FF2C2D32" VerticalAlignment="Top">
                        <TextBlock x:Name="HeaderGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Foreground="#FFE5E5EA" Text="&#xE7F4;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,1,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Text="프로그램 추가" />
                        <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" FontSize="12.5" Foreground="{StaticResource DialogMutedBrush}" TextWrapping="Wrap"
                                   Text="설치된 프로그램에서 고르거나 찾아보기로 고릅니다." />
                    </StackPanel>
                    <Button Grid.Column="2" Margin="8,-4,-8,0" VerticalAlignment="Top" Style="{StaticResource DialogCloseStyle}" Click="Cancel_Click" ToolTip="닫기 (Esc)" AutomationProperties.Name="닫기">
                        <Path Width="11" Height="11" Data="M 0.5,0.5 L 10.5,10.5 M 10.5,0.5 L 0.5,10.5" Stroke="#FFB4B4BA" StrokeThickness="1.4" />
                    </Button>
                </Grid>

                <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="26,0,26,0">
                        <!-- 추가할 때만: 설치된 프로그램(시작 메뉴)에서 고르기 -->
                        <StackPanel x:Name="PickerPanel">
                            <Grid Margin="0,18,0,8">
                                <TextBox x:Name="FilterBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="설치된 프로그램 검색" TextChanged="FilterBox_TextChanged" />
                                <TextBlock x:Name="FilterPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76" Text="설치된 프로그램 검색" />
                            </Grid>
                            <Border CornerRadius="11" Background="#FF141416" BorderBrush="#FF3A3B42" BorderThickness="1.5" Padding="4">
                                <ListBox x:Name="ProgramList" Height="150" Background="Transparent" BorderThickness="0" Foreground="#FFE5E5EA"
                                         ItemContainerStyle="{StaticResource ProgramItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="ProgramList_SelectionChanged" MouseDoubleClick="ProgramList_MouseDoubleClick" AutomationProperties.Name="설치된 프로그램">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>

                        <!-- 경로 / 주소 -->
                        <TextBlock x:Name="PathLabel" Style="{StaticResource DialogLabelStyle}" Text="경로" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="PathBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="경로" TextChanged="Path_Changed" KeyDown="PathBox_KeyDown" />
                                <TextBlock x:Name="PathPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76" />
                            </Grid>
                            <Button x:Name="PathButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="86" Style="{StaticResource DialogButtonStyle}" Click="PathButton_Click" Content="찾아보기" />
                        </Grid>
                        <TextBlock x:Name="PathNote" Margin="2,8,0,0" FontSize="12" Foreground="{StaticResource DialogMutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource DialogLabelStyle}" Text="이름" />
                        <TextBox x:Name="NameBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="이름" TextChanged="Field_Changed" />

                        <TextBlock Style="{StaticResource DialogLabelStyle}" Text="아이콘" />
                        <local:IconPicker x:Name="IconChoice" />

                        <!-- 분류: 전체 앱·분류 화면에서 같은 분류의 앱과 함께 보임. 아래의 지금 있는 분류를 눌러 고르거나 직접 씀 -->
                        <TextBlock Style="{StaticResource DialogLabelStyle}" Text="분류" />
                        <Grid>
                            <TextBox x:Name="CategoryBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="분류" TextChanged="Category_Changed" />
                            <TextBlock x:Name="CategoryPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76" Text="비우면 기타 · 아래에서 고르거나 직접 쓰기" />
                        </Grid>
                        <WrapPanel x:Name="CategoryChips" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource DialogLabelStyle}" Text="설명" />
                        <Grid>
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="설명" TextChanged="Field_Changed" />
                            <TextBlock x:Name="DescriptionPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76" Text="카드에 보일 한 줄 (비우면 경로)" />
                        </Grid>

                        <StackPanel x:Name="ArgumentsPanel">
                            <TextBlock Style="{StaticResource DialogLabelStyle}" Text="실행 인수 (선택)" />
                            <TextBox x:Name="ArgumentsBox" Style="{StaticResource DialogFieldStyle}" AutomationProperties.Name="실행 인수" TextChanged="Field_Changed" />
                        </StackPanel>

                        <TextBlock x:Name="ErrorText" Margin="2,12,0,0" FontSize="12.5" Foreground="#FFFF9F8A" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 단추 -->
                <StackPanel Grid.Row="2" Margin="26,22,26,24" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="96" Margin="0,0,8,0" Style="{StaticResource DialogButtonStyle}" Click="Cancel_Click" Content="취소" />
                    <Button x:Name="SaveButton" Width="96" Style="{StaticResource DialogPrimaryStyle}" Click="SaveButton_Click" Content="추가" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
