<Window x:Class="ILauncher.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ILauncher"
        Title="i-luncher"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF242427"
        Foreground="#FFF5F5F7"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 앱 칸: 마우스를 올리면 둥글게 옅은 판 -->
            <Style x:Key="QuickCellStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#14FFFFFF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#0AFFFFFF" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF4AA3FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 머리의 아이콘 버튼 (큰 창 · 설정) -->
            <Style x:Key="QuickIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Foreground" Value="#FFC7C7CC" />
            </Style>
            <!-- 업데이트 버튼: 옅은 초록 알약 -->
            <Style x:Key="QuickUpdateButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Foreground" Value="#FF5BE3A3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pill" Padding="{TemplateBinding Padding}" CornerRadius="13" Background="#2E3DD68C">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#473DD68C" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Background" Value="#1F3DD68C" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 전체 보기: 파란 글자 -->
            <Style x:Key="QuickLinkStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FF4AA3FF" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter VerticalAlignment="Center" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FF8CC4FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 앱 칸: 아이콘(받지 않은 앱은 흐리게, 실행 중이면 오른쪽 아래 초록 점), 이름 -->
            <DataTemplate DataType="{x:Type local:AppCard}">
                <Button Style="{StaticResource QuickCellStyle}" Tag="{Binding}" Click="Item_Click" ToolTip="{Binding RunToolTip}" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Margin="2,10,2,8">
                        <Grid Width="46" Height="46" HorizontalAlignment="Center">
                            <Grid Opacity="{Binding CellIconOpacity}">
                                <Border CornerRadius="11" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                </Border>
                                <Image Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <Ellipse Width="13" Height="13" Margin="0,0,-3,-3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Fill="#FF3DD68C" Stroke="#FF242427" StrokeThickness="3" Visibility="{Binding RunningVisibility}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="#FFD1D1D6" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>
            <!-- 내 PC 프로그램 칸: 둥근 판 위 아이콘 -->
            <DataTemplate DataType="{x:Type local:FavoriteCard}">
                <Button Style="{StaticResource QuickCellStyle}" Tag="{Binding}" Click="Item_Click" ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Margin="2,10,2,8" Opacity="{Binding CardOpacity}">
                        <Grid Width="46" Height="46" HorizontalAlignment="Center">
                            <Border CornerRadius="11" Background="#FF3A3B41" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" />
                            <Image Width="30" Height="30" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="#FFD1D1D6" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>
            <!-- 업데이트 줄: 아이콘 · 이름 · 업데이트 버튼 -->
            <DataTemplate x:Key="UpdateRowTemplate">
                <Grid Height="44">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28">
                        <Border CornerRadius="7" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                        </Border>
                        <Image Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis">
                        <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" /><Run Foreground="#FF8E8E93" Text=" · 새 버전" />
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource QuickUpdateButtonStyle}" Content="업데이트" Tag="{Binding}" Click="Update_Click" AutomationProperties.Name="{Binding Name}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Windows 11 은 둥근 모서리와 테두리를 DWM 이 그림 (그러면 이 테두리는 0) -->
    <Border x:Name="Frame" BorderBrush="#FF3A3B41" BorderThickness="1">
        <StackPanel>
            <Grid Height="48" Margin="16,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Image Width="20" Height="20" VerticalAlignment="Center" Source="Assets/ILauncher.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Text="i-luncher" />
                <Button Grid.Column="2" Style="{StaticResource QuickIconButtonStyle}" Click="Full_Click" ToolTip="큰 창" AutomationProperties.Name="큰 창">
                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource QuickIconButtonStyle}" Click="Settings_Click" ToolTip="설정" AutomationProperties.Name="설정">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                </Button>
            </Grid>

            <Border Height="34" Margin="14,0" CornerRadius="9" Background="#FF2C2D32">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Path Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 6.25,1.25 A 5,5 0 1 1 6.25,11.25 A 5,5 0 1 1 6.25,1.25 M 10,10 L 13.25,13.25" Stroke="#FF98989D" StrokeThickness="1.5" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,1,10,1" VerticalContentAlignment="Center" AutomationProperties.Name="검색" Background="Transparent" BorderThickness="0"
                             CaretBrush="#FFF5F7FB" FontSize="13" Foreground="#FFF5F7FB" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchHint" Grid.Column="1" Margin="2,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="검색" FontSize="13" Foreground="#FF98989D" />
                </Grid>
            </Border>

            <ItemsControl x:Name="Items" Margin="10,10,10,4" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="NoResults" Margin="0,18,0,22" HorizontalAlignment="Center" FontSize="12.5" Foreground="#FF8E8E93" Text="일치하는 앱이 없습니다" Visibility="Collapsed" />

            <StackPanel x:Name="UpdatesPanel" Margin="16,4,16,8" Visibility="Collapsed">
                <TextBlock Margin="0,0,0,2" FontSize="11.5" FontWeight="Bold" Foreground="#FF8E8E93" Text="업데이트" />
                <ItemsControl x:Name="Updates" Focusable="False" ItemTemplate="{StaticResource UpdateRowTemplate}" />
            </StackPanel>

            <Border Height="40" Background="#FF1F2024" BorderBrush="#FF2E3036" BorderThickness="0,1,0,0">
                <Button Margin="16,0" HorizontalAlignment="Left" Style="{StaticResource QuickLinkStyle}" Click="Full_Click" Content="전체 보기 ›" AutomationProperties.Name="전체 보기" />
            </Border>
        </StackPanel>
    </Border>
</Window>
