<Window x:Class="ILauncher.DeleteProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="내 앱 삭제"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#FFF5F5F7"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 목록에서 삭제 (내 앱 · 기본 목록 앱): 목록에서만 뺄지, 설치된 앱도 제거할지 고름 (설치되지 않았으면 고르기 없이 목록에서 뺌) -->
    <Grid Margin="14">
        <Border Style="{StaticResource DialogCardStyle}" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="#FFB4B4BA" Text="내 앱 삭제" />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="58" Height="58" VerticalAlignment="Top">
                        <Border x:Name="IconTile" CornerRadius="15">
                            <TextBlock x:Name="IconInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <Image x:Name="IconImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RepositoryText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource DialogMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="QuestionText" Margin="2,20,0,0" FontSize="14" Foreground="#FFE5E5EA" TextWrapping="Wrap" />

                <!-- 설치되어 있을 때만: 고르기 -->
                <StackPanel x:Name="Choices" Margin="0,4,0,0" Visibility="Collapsed">
                    <RadioButton x:Name="KeepInstalled" Style="{StaticResource DialogChoiceStyle}" GroupName="Delete" IsChecked="True">
                        <StackPanel>
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="목록에서만 빼기" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource DialogMutedBrush}" TextWrapping="Wrap" Text="설치된 앱은 그대로 두고 실행할 수 있습니다." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="UninstallToo" Style="{StaticResource DialogChoiceStyle}" GroupName="Delete">
                        <StackPanel>
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="설치된 앱도 제거" />
                            <TextBlock x:Name="UninstallDetail" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource DialogMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Width="96" Margin="0,0,8,0" Style="{StaticResource DialogButtonStyle}" Click="Cancel_Click" Content="취소" />
                    <Button x:Name="DeleteButton" Width="96" Style="{StaticResource DialogDangerStyle}" Click="Delete_Click" Content="삭제" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
