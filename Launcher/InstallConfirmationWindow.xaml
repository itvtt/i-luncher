<Window x:Class="ILauncher.InstallConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="앱 설치"
        Width="440"
        MinWidth="360"
        MaxWidth="520"
        MinHeight="236"
        MaxHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFF5F7FB"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Fixed" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Border Background="#FF19212B"
                BorderBrush="#FF354252"
                BorderThickness="1"
                CornerRadius="18"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.38" Color="#FF000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HeaderText" Grid.Row="0"
                           Text="앱 설치"
                           Foreground="#FFB9C7D8"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="64" Height="64"
                            Background="#FF232D3B"
                            CornerRadius="16"
                            VerticalAlignment="Top">
                        <Grid>
                            <Image x:Name="AppIconImage"
                                   Width="48" Height="48"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"
                                   AutomationProperties.Name="앱 아이콘" />
                            <TextBlock x:Name="AppInitialsText"
                                       Visibility="Collapsed"
                                       Foreground="#FFB9C7D8"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F7FB"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="58"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="QuestionText" Margin="0,8,0,0"
                                   Text="이 앱을 설치할까요?"
                                   FontSize="14"
                                   Foreground="#FFB9C7D8"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailText" Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="#FF8C96A8"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">
                    <Button x:Name="CancelButton"
                            Content="취소"
                            Width="96" Height="42"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="CancelButton_Click"
                            Background="#FF232D3B"
                            Foreground="#FFF5F7FB"
                            BorderBrush="#FF45546A"
                            BorderThickness="1"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            AutomationProperties.Name="설치 취소">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="11">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FF2B3747" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF59BFAE" />
                                        <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FF17202B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="InstallButton"
                            Content="설치"
                            Width="96" Height="42"
                            Click="InstallButton_Click"
                            Background="#FF59BFAE"
                            Foreground="#FF10221F"
                            BorderBrush="#FF59BFAE"
                            BorderThickness="1"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            AutomationProperties.Name="앱 설치">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="11">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FF70CEBE" />
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF70CEBE" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFD7FFF7" />
                                        <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#FF3FA591" />
                                        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF3FA591" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
