<Window x:Class="ILauncher.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공지" Width="740" Height="500" MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF141821" Foreground="#FFF5F7FB" FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF232D3B" />
            <Setter Property="Foreground" Value="#FFF5F7FB" />
            <Setter Property="BorderBrush" Value="#FF45546A" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FF33445B" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFAECFFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="RefreshNoticesButton" DockPanel.Dock="Right" Content="새로고침" Click="Refresh_Click" AutomationProperties.Name="공지 새로고침" />
            <TextBlock Text="공지" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,0,12" Foreground="#FFB9C7D8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="NoticeList" Background="#FF19212B" Foreground="#FFF5F7FB" BorderBrush="#FF354252" SelectionChanged="NoticeList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="공지 목록">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#FF253247" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#FF304868" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#FFAECFFF" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DateText}" Margin="0,6,0,0" FontSize="11" Foreground="#FFB9C7D8" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="NoticeTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="NoticeDate" Grid.Row="1" Margin="0,8,0,16" FontSize="12" Foreground="#FFB9C7D8" />
                <TextBox x:Name="NoticeBody" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Foreground="#FFF5F7FB" FontSize="14" AutomationProperties.Name="공지 내용" />
            </Grid>
        </Grid>
    </Grid>
</Window>
