<Window x:Class="ILauncher.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로젝트 토큰"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#FFF5F5F7"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 이 프로젝트(저장소)의 GitHub 토큰: 비공개 저장소를 읽을 때. 저장하기 전에 그 저장소를 읽을 수 있는지 확인 -->
    <Grid Margin="14">
        <Border Style="{StaticResource DialogCardStyle}" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFB4B4BA" Text="프로젝트 토큰" />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="58" Height="58" VerticalAlignment="Top">
                        <Border x:Name="IconTile" CornerRadius="15">
                            <TextBlock x:Name="IconInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <Image x:Name="IconImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RepositoryText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource DialogMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <PasswordBox x:Name="TokenBox" Style="{StaticResource DialogPasswordStyle}" AutomationProperties.Name="토큰"
                                 PasswordChanged="TokenBox_PasswordChanged" KeyDown="TokenBox_KeyDown" />
                    <TextBlock x:Name="TokenPlaceholder" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" Foreground="#FF6E6E76" />
                </Grid>
                <TextBlock x:Name="StateText" Margin="2,10,0,0" FontSize="12.5" Foreground="{StaticResource DialogMutedBrush}" TextWrapping="Wrap"
                           Text="읽기 권한이면 됩니다. 이 PC 의 이 Windows 계정에만 암호화해 둡니다." />

                <Grid Margin="0,24,0,0">
                    <Button x:Name="ClearButton" Width="96" HorizontalAlignment="Left" Style="{StaticResource DialogButtonStyle}" Click="Clear_Click" Content="지우기"
                            Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Width="96" Margin="0,0,8,0" Style="{StaticResource DialogButtonStyle}" Click="Cancel_Click" Content="취소" />
                        <Button x:Name="SaveButton" Width="96" Style="{StaticResource DialogPrimaryStyle}" Click="Save_Click" Content="저장" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
