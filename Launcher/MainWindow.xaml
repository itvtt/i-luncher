<Window x:Class="ILauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="i-luncher"
        Icon="Assets/ILauncher.ico"
        Foreground="#FFF5F7FB"
        FontFamily="Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="1240"
        Height="840"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#FF202632" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="28"
                           Height="28"
                           Margin="0,0,10,0"
                           Source="Assets/ILauncher.png"
                           Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#FFE8ECF4"
                               Text="i-luncher" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton"
                            AutomationProperties.AutomationId="MinimizeButton"
                            AutomationProperties.Name="최소화"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="최소화">
                        <Path Width="12"
                              Height="1"
                              Data="M 0,0.5 L 12,0.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            AutomationProperties.AutomationId="MaximizeButton"
                            AutomationProperties.Name="최대화"
                            Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="최대화">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyph"
                                  Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph"
                                  Data="M 3.5,1.5 L 11.5,1.5 L 11.5,9.5 M 1.5,3.5 L 9.5,3.5 L 9.5,11.5 L 1.5,11.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton"
                            AutomationProperties.AutomationId="CloseButton"
                            AutomationProperties.Name="닫기"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource CloseChromeButtonStyle}"
                            ToolTip="닫기">
                        <Path Width="12"
                              Height="12"
                              Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,20,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="앱 런처" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="12.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="필요한 도구를 빠르게 시작하세요" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenFolderButton"
                        Margin="0,0,8,0"
                        AutomationProperties.AutomationId="OpenFolderButton"
                        AutomationProperties.Name="앱 폴더 열기"
                        Click="OpenFolderButton_Click"
                        Content="앱 폴더"
                        Style="{StaticResource ToolbarButtonStyle}" />
                <Button x:Name="RefreshButton"
                        AutomationProperties.AutomationId="RefreshButton"
                        AutomationProperties.Name="앱 목록 새로고침"
                        Click="RefreshButton_Click"
                        Content="새로고침"
                        Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="28,0,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Height="42"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <DockPanel>
                        <Path Width="14"
                              Height="14"
                              Margin="13,0,10,0"
                              VerticalAlignment="Center"
                              Data="M 6.25,1.25 A 5,5 0 1 1 6.25,11.25 A 5,5 0 1 1 6.25,1.25 M 10,10 L 13.25,13.25"
                              Stroke="{StaticResource MutedTextBrush}"
                              StrokeThickness="1.4" />
                        <TextBox x:Name="SearchBox"
                                 Margin="0,1,12,1"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="SearchBox"
                                 AutomationProperties.Name="앱 검색"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{StaticResource TextBrush}"
                                 FontSize="14"
                                 Foreground="{StaticResource TextBrush}"
                                 TextChanged="SearchBox_TextChanged" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="CountText"
                           Grid.Column="1"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="앱 0개" />
            </Grid>

            <Border x:Name="ErrorPanel"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="12,9,8,9"
                    AutomationProperties.LiveSetting="Assertive"
                    Background="#FF2B1C21"
                    BorderBrush="#FF61313C"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Width="14"
                          Height="14"
                          Margin="0,1,10,0"
                          VerticalAlignment="Top"
                          Data="M 7,1 L 13,12 L 1,12 Z M 7,4.3 L 7,8 M 7,10.2 L 7,10.3"
                          Stroke="#FFFFB4C0"
                          StrokeThickness="1.4" />
                    <TextBlock x:Name="ErrorText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="#FFF6BAC3"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Width="30"
                            Height="28"
                            Margin="10,0,0,0"
                            Padding="0"
                            AutomationProperties.AutomationId="DismissErrorButton"
                            AutomationProperties.Name="오류 알림 닫기"
                            Click="DismissErrorButton_Click"
                            Content="×"
                            FontSize="18"
                            Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="알림 닫기" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer Padding="28,0,14,18"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LauncherItems" ItemsSource="{Binding LauncherCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="374" Margin="0,0,14,14" Padding="18,16,18,12"
                                    Background="{StaticResource RaisedSurfaceBrush}" BorderBrush="#FF354359"
                                    BorderThickness="1" CornerRadius="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="76" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Width="50" Height="50" Padding="0" HorizontalAlignment="Left"
                                            VerticalAlignment="Center" Click="LauncherCard_Click" Tag="{Binding}"
                                            IsEnabled="{Binding CanRun}" Style="{StaticResource ToolbarButtonStyle}"
                                            AutomationProperties.Name="{Binding AccessibleName}" ToolTip="앱 실행">
                                    <Border Width="48"
                                            Height="48"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="#FF222A3A"
                                            BorderBrush="#FF343F55"
                                            BorderThickness="1"
                                            CornerRadius="13">
                                        <Grid>
                                            <Image Margin="8"
                                                   Source="{Binding IconSource}"
                                                   Stretch="Uniform"
                                                   Visibility="{Binding IconVisibility}" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFC6D3FF"
                                                       Text="{Binding Initials}"
                                                       Visibility="{Binding InitialsVisibility}" />
                                        </Grid>
                                    </Border>
                                    </Button>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="15.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding Entry.Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,7,2,0"
                                                   MaxHeight="38"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   LineHeight="18"
                                                   Text="{Binding Entry.Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{Binding InstallLabel}" Tag="{Binding}"
                                                Visibility="{Binding InstallVisibility}"
                                                Click="InstallButton_Click" IsEnabled="{Binding CanInstall}"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.AutomationId="{Binding InstallAutomationId}"
                                                AutomationProperties.Name="{Binding InstallAccessibleName}"
                                                ToolTip="{Binding InstallToolTip}" Padding="12,6"
                                                Style="{StaticResource ToolbarButtonStyle}" />
                                        <Button Content="{Binding RunLabel}" Tag="{Binding}" Click="LauncherCard_Click"
                                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                                AutomationProperties.Name="{Binding RunAccessibleName}"
                                                IsEnabled="{Binding CanRun}" Margin="{Binding RunMargin}" Padding="12,6"
                                                Grid.Column="{Binding RunColumn}"
                                                Grid.ColumnSpan="{Binding RunColumnSpan}"
                                                Background="#FF3864D9" BorderBrush="#FF6C91FA" Foreground="White"
                                                Style="{StaticResource ToolbarButtonStyle}" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="1,7,0,0"
                                               Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                                               TextTrimming="CharacterEllipsis" FontSize="11"
                                               Foreground="#FFB6C9EA" AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="54"
                        Height="54"
                        HorizontalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="…" />
                </Border>
                <TextBlock x:Name="EmptyStateTitle"
                           Margin="0,13,0,0"
                           HorizontalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="등록된 앱이 없습니다" />
                <TextBlock x:Name="EmptyStateDescription"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="새로고침하여 앱을 다시 찾아보세요." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
