<Window x:Class="ILauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ILauncher"
        Title="i-luncher"
        Icon="Assets/ILauncher.ico"
        Foreground="#FFF5F7FB"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        Width="1100" Height="860" MinWidth="640" MinHeight="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 제목 표시줄의 글자 버튼 (공지 · 관리자 메뉴): 회색 캡슐, 흰 글자 -->
            <Style x:Key="RoundedToolbarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Background" Value="#FF2C2D32" />
                <Setter Property="Foreground" Value="#FFF5F5F7" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Capsule" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF3A3B41" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF232428" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF3A3B41" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Capsule" Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 일반/마스터 전환의 한 칸 (고른 칸의 배경 · 글자색은 코드에서) -->
            <Style x:Key="SegmentButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF9DA7B8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Segment" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Opacity" Value="0.85" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 제목 표시줄의 아이콘 버튼 (새로고침 · 설정) -->
            <Style x:Key="TitleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="Foreground" Value="#FFC7C7CC" />
            </Style>
            <!-- 홈 화면의 아이콘 칸: 누르면 바로 열기 (받기 · 업데이트도), 마우스를 올리면 둥글게 옅은 판 -->
            <Style x:Key="IconCellStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" CornerRadius="18" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#14FFFFFF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="#0AFFFFFF" />
                                    <Setter TargetName="Face" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF4AA3FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 아래 독의 아이콘: 마우스를 올리면 살짝 떠오름 -->
            <Style x:Key="DockItemStyle" TargetType="Button">
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="Content" RenderTransformOrigin="0.5,1">
                                <ContentPresenter.RenderTransform><TranslateTransform /></ContentPresenter.RenderTransform>
                            </ContentPresenter>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-3" /></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Content" Property="RenderTransform"><Setter.Value><TranslateTransform Y="0" /></Setter.Value></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 아이콘 칸의 즐겨찾기 별 (마우스를 올리면 아이콘 오른쪽 위에): 즐겨찾기면 채운 금색 별 · 아니면 빈 별 -->
            <!-- 아이콘 아래 상태 단추: 둥근 알약, 받기 · 업데이트는 파랑, 열기는 회색, 실행 중은 초록 글자 -->
            <Style x:Key="CellActionStyle" TargetType="Button">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="52" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.85" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CardStarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Face" Fill="#FF3A3B41" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Fill" Value="#FF4A4B52" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Fill" Value="#FF2C2D32" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 분류 버튼 줄 (검색 아래 가운데): 둥근 버튼, 고른 것은 흰 바탕에 진한 글자 -->
            <Style x:Key="CategoryChipStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Margin" Value="4,0,4,8" />
                <Setter Property="Background" Value="#FF2C2D32" />
                <Setter Property="Foreground" Value="#FFE5E5EA" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" CornerRadius="16" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="Tag" Value="off" /></MultiTrigger.Conditions>
                                    <Setter TargetName="Face" Property="Background" Value="#FF3A3B41" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 왼쪽 메뉴 한 줄: 아이콘 · 이름 · 개수, 고른 줄은 밝은 판 -->
            <Style x:Key="SideItemStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Foreground" Value="#FFD1D1D6" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF222327" /></Trigger>
                                <Trigger Property="Tag" Value="on">
                                    <Setter TargetName="Face" Property="Background" Value="#FF2E2F35" />
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF4AA3FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 앱 페이지의 큰 버튼: 불투명한 흰 둥근 사각에 옅은 그림자, 아이콘 + 글자는 그 앱 색의 진한 톤(Ink) -->
            <Style x:Key="DetailActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="92" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="Background" Value="#FF0A84FF" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                <Border x:Name="Face" CornerRadius="16" Background="{TemplateBinding Background}">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF3395FF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="#FF0071E3" />
                                    <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 스토어 줄: 둥근 판, 마우스를 올리면 조금 밝게 (누르면 앱 페이지) -->
            <Style x:Key="StoreRowStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF1E1F23" /></Trigger>
                </Style.Triggers>
            </Style>
<!-- 제목줄 로고: 모양 없는 버튼 -->
            <Style x:Key="PlainButtonStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 파란 글자 링크 (모두 업데이트, 뒤로) -->
            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FF4AA3FF" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="Text" Margin="0,0,0,3" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FF8CC4FF" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF6E6E73" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#FF1C1C1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 제목 표시줄: 로고(홈) · 버전, 오른쪽에 일반/마스터 전환(마스터 계정만) · 공지 · 관리자 메뉴 · 새로고침 · 설정, 창 버튼 -->
        <Border Grid.Row="0" Background="#FF19191B" BorderBrush="#FF2E3036" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HomeButton" AutomationProperties.Name="홈" Click="HomeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource PlainButtonStyle}" ToolTip="홈">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Image Width="28" Height="28" Margin="0,0,10,0" Source="Assets/ILauncher.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#FFE8ECF4" Text="i-luncher" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TitleVersionText" Margin="8,1,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 일반/마스터 전환: 마스터 계정만. 일반 = 일반 사용자와 똑같은 화면 (기본 목록만, 서버에 묻지 않음) -->
                    <Border x:Name="ViewModeSwitch" Height="30" Margin="8,0,0,0" Padding="3" CornerRadius="15" Background="#FF2C2D32" Visibility="Collapsed"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="GeneralViewButton" Content="일반" Click="GeneralViewButton_Click" Style="{StaticResource SegmentButtonStyle}"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="일반 화면" ToolTip="일반 사용자 화면" />
                            <Button x:Name="MasterViewButton" Content="마스터" Click="MasterViewButton_Click" Style="{StaticResource SegmentButtonStyle}"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="마스터 화면" ToolTip="마스터 화면" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="NoticeButton" Click="NoticeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="공지" ToolTip="공지">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="공지" VerticalAlignment="Center" />
                            <Ellipse x:Name="NoticeUnreadDot" Width="6" Height="6" Margin="6,0,0,0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <!-- 관리자 메뉴: 마스터 계정만 (빌드 설정 MASTER_USERS, 비밀번호 없음) -->
                    <Button x:Name="ApiManagerButton" Click="ApiManagerButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource RoundedToolbarButtonStyle}"
                            Visibility="Collapsed" AutomationProperties.Name="관리자 메뉴" ToolTip="앱 목록 · 릴리스 · 러너 · 공지 · 서버">
                        <TextBlock Text="관리자 메뉴" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleIconButtonStyle}" AutomationProperties.Name="새로고침" ToolTip="새로고침 (F5)">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="SettingsButton" Click="SettingsButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleIconButtonStyle}" AutomationProperties.Name="설정" ToolTip="설정">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" AutomationProperties.Name="최소화" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최소화">
                        <Path Width="12" Height="1" Data="M 0,0.5 L 12,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton" AutomationProperties.Name="최대화" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최대화">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyph" Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph" Data="M 3.5,1.5 L 11.5,1.5 L 11.5,9.5 M 1.5,3.5 L 9.5,3.5 L 9.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" AutomationProperties.Name="닫기" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseChromeButtonStyle}" ToolTip="닫기">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <!-- 왼쪽 메뉴 (앱스토어처럼): 검색, 스토어 · 분류마다, 설치됨 · 즐겨찾기 · 업데이트. 설정 · 관리자 메뉴에서는 숨김 -->
            <Border x:Name="Sidebar" Background="#FF161618" BorderBrush="#FF2A2B30" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16,12,12">
                    <Border DockPanel.Dock="Top" Height="34" Background="#FF2C2D32" CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 6.25,1.25 A 5,5 0 1 1 6.25,11.25 A 5,5 0 1 1 6.25,1.25 M 10,10 L 13.25,13.25" Stroke="#FF98989D" StrokeThickness="1.5" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,1,16,1" VerticalContentAlignment="Center" AutomationProperties.Name="앱 검색" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource TextBrush}" FontSize="13.5" Foreground="{StaticResource TextBrush}" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Grid.Column="1" Margin="2,0,16,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="검색" FontSize="13.5" Foreground="#FF98989D">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryButtons" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- 오른쪽: 스토어(앱 줄) · 설치됨(큰 아이콘) · 앱 페이지, 아래 독(즐겨찾기 · 실행 중 · 프로그램 추가) -->
            <Grid x:Name="StorePane" Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <!-- 지금 화면 이름 (스토어 · 분류 · 설치됨 · 즐겨찾기 · 업데이트 · 검색) -->
                <StackPanel Margin="30,22,30,4">
                    <TextBlock x:Name="ViewHeading" FontSize="26" FontWeight="Bold" Foreground="#FFF5F5F7" TextTrimming="CharacterEllipsis" />
                    <!-- 설치됨: 분류별 필터 단추 (전체 · 분류마다 개수), 검색 중에는 숨김 -->
                    <WrapPanel x:Name="InstalledChips" Margin="-4,14,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- 런처 업데이트 -->
                <Border x:Name="LauncherUpdateBanner" Grid.Row="1" MaxWidth="760" Margin="24,8,24,0" Padding="12,8" Background="#FF1A2E27" BorderBrush="#FF3C6B58" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LauncherUpdateText" VerticalAlignment="Center" Foreground="#FFBFEBD5" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="LauncherUpdateButton" Grid.Column="1" Content="지금 업데이트" Margin="12,0,0,0" Padding="10,4" Click="LauncherUpdateButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                </Border>

                <!-- 공지 -->
                <Border x:Name="NoticeBanner" Grid.Row="2" MaxWidth="760" Margin="24,8,24,0" Padding="12,8" Background="#FF1D2C41" BorderBrush="#FF385577" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="공지" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#FFAECFFF" FontWeight="SemiBold" />
                        <TextBlock x:Name="NoticeBannerTitle" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="보기" Margin="12,0,0,0" Padding="10,4" Click="NoticeBanner_Click" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="공지 보기" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <ScrollViewer x:Name="CardScrollViewer" Padding="24,4,24,118" SizeChanged="CardScrollViewer_SizeChanged" ScrollChanged="CardScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <!-- 앱 칸: 큰 아이콘(받지 않은 앱은 흐리게, 새 버전은 오른쪽 위 파란 ↑, 받을 수 있으면 오른쪽 아래 ↓), 이름, 상태 한 줄
                                 아이콘 밖 오른쪽 위에 작은 버전(회색 판), 이름 아래 상태 단추(받기 · 업데이트 · 실행 중 · 진행 중, 열기는 없음).
                                 아이콘을 누르면 바로 실행 (받기 · 업데이트는 상태 단추로도). 마우스를 올리면 왼쪽 위 즐겨찾기 별, 우클릭은 메뉴 (내 앱은 삭제도) -->
                            <DataTemplate DataType="{x:Type local:AppCard}">
                                <Grid x:Name="Cell" Width="132" Margin="4,0,4,10">
                                    <!-- 실행 중: 형형색색 형광 테두리가 칸을 따라 돎 (배지 없음) -->
                                    <Border CornerRadius="18" Background="#0EFFFFFF" BorderThickness="2.5" IsHitTestVisible="False"
                                            Visibility="{Binding RunningVisibility}">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <LinearGradientBrush.RelativeTransform>
                                                    <RotateTransform CenterX="0.5" CenterY="0.5" Angle="0" />
                                                </LinearGradientBrush.RelativeTransform>
                                                <GradientStop Color="#FFFF2BD6" Offset="0" />
                                                <GradientStop Color="#FF00E5FF" Offset="0.25" />
                                                <GradientStop Color="#FF39FF14" Offset="0.5" />
                                                <GradientStop Color="#FFFFE600" Offset="0.75" />
                                                <GradientStop Color="#FFFF2BD6" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="BorderBrush.(LinearGradientBrush.RelativeTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:2.4" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <Button Style="{StaticResource IconCellStyle}" Tag="{Binding}" Click="Cell_Click" ToolTip="{Binding RunToolTip}"
                                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{Binding FavoriteMenuHeader}" Icon="{Binding FavoriteGlyph}" Tag="{Binding}" Click="FavoriteToggleMenu_Click" />
                                            <MenuItem Header="업데이트" Icon="&#xE896;" Tag="{Binding}" Click="UpdateMenu_Click" Visibility="{Binding UpdateMenuVisibility}" />
                                            <MenuItem Header="설치 / 다시 설치" Icon="&#xE72C;" Tag="{Binding}" Click="ReinstallMenu_Click" />
                                            <Separator />
                                            <MenuItem Header="저장소 열기" Icon="&#xE8A7;" Tag="{Binding}" Click="OpenRepositoryMenu_Click" />
                                            <MenuItem Header="릴리스 노트 보기" Icon="&#xE8A5;" Tag="{Binding}" Click="OpenReleaseMenu_Click" Visibility="{Binding ReleaseMenuVisibility}" />
                                            <MenuItem Header="설치 폴더 열기" Icon="&#xE838;" Tag="{Binding}" Click="OpenFolderMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                            <MenuItem Header="관리자 메뉴에서 편집" Icon="&#xE70F;" Tag="{Binding}" Click="EditMenu_Click" Visibility="{Binding AdminMenuVisibility}" />
                                            <MenuItem Header="편집…" Icon="&#xE70F;" Tag="{Binding}" Click="EditMyApp_Click" Visibility="{Binding PersonalMenuVisibility}" />
                                            <Separator />
                                            <MenuItem Header="제거" Icon="&#xE74D;" Tag="{Binding}" Click="UninstallMenu_Click" Visibility="{Binding InstalledMenuVisibility}"
                                                      Style="{StaticResource DangerMenuItemStyle}" />
                                            <MenuItem Header="목록에서 삭제…" Icon="&#xE711;" Tag="{Binding}" Click="DeleteFromList_Click"
                                                      Style="{StaticResource DangerMenuItemStyle}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Margin="0,26,0,12" VerticalAlignment="Center">
                                            <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                                <Grid Opacity="{Binding CellIconOpacity}">
                                                    <Grid.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#FF000000" /></Grid.Effect>
                                                    <Border CornerRadius="18" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                                    </Border>
                                                    <Image Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                                <!-- 버전: 아이콘 밖, 오른쪽 위 모서리 위에 작게 (회색 판에 밝은 글자) -->
                                                <Border Margin="0,-17,-10,0" Padding="4,0,4,1" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="5"
                                                        Background="#FF34353B" Visibility="{Binding IconVersionVisibility}" IsHitTestVisible="False">
                                                    <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#FFE5E5EA" Text="{Binding IconVersionText}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Margin="6,11,6,0" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFF5F5F7" Text="{Binding Name}" ToolTip="{Binding FullName}" TextTrimming="CharacterEllipsis" />
                                            <Button Margin="0,7,0,0" HorizontalAlignment="Center" Style="{StaticResource CellActionStyle}" Tag="{Binding}" Click="CellAction_Click"
                                                    Visibility="{Binding CellPillVisibility}" Content="{Binding CellActionText}" Background="{Binding CellActionBackground}" Foreground="{Binding CellActionInk}"
                                                    IsHitTestVisible="{Binding CellActionEnabled}" ToolTip="{Binding VersionToolTip}" AutomationProperties.Name="{Binding CellActionText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="Star" Style="{StaticResource CardStarButtonStyle}" Margin="8,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                                            Tag="{Binding}" Click="FavoriteToggleMenu_Click" Content="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteGlyphBrush}"
                                            ToolTip="{Binding FavoriteMenuHeader}" AutomationProperties.Name="{Binding FavoriteMenuHeader}" />
                                    <ProgressBar Height="3" Margin="28,0,28,4" VerticalAlignment="Bottom" IsHitTestVisible="False" Minimum="0" Maximum="100"
                                                 IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue, Mode=OneWay}" Visibility="{Binding BusyVisibility}"
                                                 Background="#FF2C2D32" BorderThickness="0" Foreground="#FF4AA3FF" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                            <!-- 스토어 줄 (앱스토어처럼): 아이콘 · 이름 · 한 줄 설명 · 오른쪽 단추(받기 · 열기 · 업데이트 · 진행 중).
                                 줄을 누르면 앱 페이지, 우클릭은 앱 칸과 같은 메뉴 -->
                            <DataTemplate DataType="{x:Type local:StoreRow}">
                                <Border Height="88" Margin="10,0" Padding="2,0,4,0" BorderBrush="#FF2C2D32" BorderThickness="0,0,0,1" Style="{StaticResource StoreRowStyle}"
                                        Tag="{Binding Card}" MouseLeftButtonUp="StoreRow_MouseLeftButtonUp" AutomationProperties.AutomationId="{Binding Card.AutomationId}" AutomationProperties.Name="{Binding Card.Name}">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{Binding FavoriteMenuHeader}" Icon="{Binding FavoriteGlyph}" Tag="{Binding}" Click="FavoriteToggleMenu_Click" />
                                        <MenuItem Header="업데이트" Icon="&#xE896;" Tag="{Binding}" Click="UpdateMenu_Click" Visibility="{Binding UpdateMenuVisibility}" />
                                        <MenuItem Header="설치 / 다시 설치" Icon="&#xE72C;" Tag="{Binding}" Click="ReinstallMenu_Click" />
                                        <Separator />
                                        <MenuItem Header="저장소 열기" Icon="&#xE8A7;" Tag="{Binding}" Click="OpenRepositoryMenu_Click" />
                                        <MenuItem Header="릴리스 노트 보기" Icon="&#xE8A5;" Tag="{Binding}" Click="OpenReleaseMenu_Click" Visibility="{Binding ReleaseMenuVisibility}" />
                                        <MenuItem Header="설치 폴더 열기" Icon="&#xE838;" Tag="{Binding}" Click="OpenFolderMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                        <MenuItem Header="관리자 메뉴에서 편집" Icon="&#xE70F;" Tag="{Binding}" Click="EditMenu_Click" Visibility="{Binding AdminMenuVisibility}" />
                                        <Separator />
                                        <MenuItem Header="제거" Icon="&#xE74D;" Tag="{Binding}" Click="UninstallMenu_Click" Visibility="{Binding InstalledMenuVisibility}"
                                                  Style="{StaticResource DangerMenuItemStyle}" />
                                        <MenuItem Header="목록에서 삭제…" Icon="&#xE711;" Tag="{Binding}" Click="DeleteFromList_Click"
                                                  Style="{StaticResource DangerMenuItemStyle}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid Width="60" Height="60" VerticalAlignment="Center">
                                            <Border CornerRadius="14" Background="{Binding Card.TileBrush}" Visibility="{Binding Card.InitialsVisibility}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Text="{Binding Card.Initials}" />
                                            </Border>
                                            <Image Source="{Binding Card.Icon}" Stretch="Uniform" Visibility="{Binding Card.IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="#FFF5F5F7" Text="{Binding Card.Name}" ToolTip="{Binding Card.FullName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="#FFAEAEB2" Text="{Binding Card.DescriptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Card.DescriptionText}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Height="28" MinWidth="70" VerticalAlignment="Center" Style="{StaticResource CellActionStyle}" Tag="{Binding Card}" Click="CellAction_Click"
                                                Content="{Binding Card.StoreCapsuleText}" Background="#FF2C2C2E" Foreground="{Binding Card.StoreCapsuleInk}" FontWeight="Bold"
                                                IsHitTestVisible="{Binding Card.CellActionEnabled}" ToolTip="{Binding Card.VersionToolTip}" AutomationProperties.Name="{Binding Card.CellActionText}" />
                                        <ProgressBar Grid.ColumnSpan="3" Height="3" Margin="74,0,0,8" VerticalAlignment="Bottom" IsHitTestVisible="False" Minimum="0" Maximum="100"
                                                     IsIndeterminate="{Binding Card.IsIndeterminate}" Value="{Binding Card.ProgressValue, Mode=OneWay}" Visibility="{Binding Card.BusyVisibility}"
                                                     Background="#FF2C2D32" BorderThickness="0" Foreground="#FF4AA3FF" />
                                    </Grid>
                                </Border>
                            </DataTemplate>

<!-- 내 PC 프로그램 칸: 둥근 판 위 아이콘, 이름, "내 PC". 누르면 실행, 우클릭은 편집 · 파일 위치 · 삭제 -->
                            <DataTemplate DataType="{x:Type local:FavoriteCard}">
                                <Grid Width="132" Margin="4,0,4,10">
                                    <Button Style="{StaticResource IconCellStyle}" Tag="{Binding}" Click="FavoriteCard_Click" ToolTip="{Binding ToolTipText}"
                                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{Binding RunMenuText}" Icon="&#xE768;" Tag="{Binding}" Click="FavoriteRunMenu_Click" />
                                            <MenuItem Header="{Binding FavoriteMenuHeader}" Icon="{Binding FavoriteGlyph}" Tag="{Binding}" Click="ProgramFavoriteMenu_Click" />
                                            <MenuItem Header="편집…" Icon="&#xE70F;" Tag="{Binding}" Click="FavoriteEditMenu_Click" />
                                            <MenuItem Header="파일 위치 열기" Icon="&#xE838;" Tag="{Binding}" Click="FavoriteFolderMenu_Click" Visibility="{Binding FolderMenuVisibility}" />
                                            <Separator />
                                            <MenuItem Header="삭제" Icon="&#xE74D;" Tag="{Binding}" Click="FavoriteDeleteMenu_Click" Style="{StaticResource DangerMenuItemStyle}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Margin="0,14,0,11" Opacity="{Binding CardOpacity}">
                                            <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                                <Grid.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#FF000000" /></Grid.Effect>
                                                <Border CornerRadius="18" Background="#FF2E2F35" BorderBrush="#14FFFFFF" BorderThickness="1" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" />
                                                <Image Width="50" Height="50" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <TextBlock Margin="6,11,6,0" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFF5F5F7" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="6,3,6,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="#FF8E8E93" Text="{Binding CellStateText}" ToolTip="{Binding DescriptionText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ScrollViewer.Resources>

                        <!-- 칸 묶음: 제목 줄(업데이트 화면의 모두 업데이트 등)은 있을 때만, 칸은 창 폭에 맞춰 열 수가 바뀌고 가운데 -->
                        <ItemsControl x:Name="SectionList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:StoreSection}">
                                    <StackPanel Width="{Binding PanelWidth}" Margin="0,4,0,26" HorizontalAlignment="Left">
                                        <DockPanel Margin="12,6,12,4" Visibility="{Binding HeaderVisibility}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="{Binding ActionText}" Tag="{Binding}" Click="SectionAction_Click"
                                                    Visibility="{Binding ActionVisibility}" IsEnabled="{Binding ActionEnabled}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Title}" />
                                                <TextBlock Margin="8,0,0,2" VerticalAlignment="Bottom" FontSize="13" Foreground="#FF98989D" Text="{Binding Note}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" Margin="0,0,0,90" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="460">
                        <TextBlock x:Name="EmptyStateTitle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyStateText" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="EmptyStateButton" Margin="0,14,0,0" Padding="14,7" HorizontalAlignment="Center" Click="EmptyStateButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>

                    <!-- 독: 즐겨찾기(등록한 순서) | 즐겨찾기가 아닌 실행 중인 앱, 끝에 + (프로그램 추가). 실행 중이면 아이콘 아래 흰 점 -->
                    <Grid x:Name="Dock" Margin="0,0,0,16" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Border Margin="6,10,6,-8" CornerRadius="22" Background="#80000000" IsHitTestVisible="False">
                            <Border.Effect><BlurEffect Radius="24" /></Border.Effect>
                        </Border>
                        <Border Padding="10,10,10,5" CornerRadius="22" Background="#F22A2B30" BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <DataTemplate DataType="{x:Type local:AppCard}">
                                        <Button Style="{StaticResource DockItemStyle}" Tag="{Binding}" Click="StoreAction_Click" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{Binding FavoriteMenuHeader}" Icon="{Binding FavoriteGlyph}" Tag="{Binding}" Click="FavoriteToggleMenu_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel>
                                                <Grid Width="46" Height="46">
                                                    <Border CornerRadius="11" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                                    </Border>
                                                    <Image Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                                <Ellipse Width="5" Height="5" Margin="0,4,0,0" Fill="#FFF5F5F7" Opacity="{Binding RunningDotOpacity}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type local:FavoriteCard}">
                                        <Button Style="{StaticResource DockItemStyle}" Tag="{Binding}" Click="FavoriteCard_Click" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{Binding FavoriteMenuHeader}" Icon="{Binding FavoriteGlyph}" Tag="{Binding}" Click="ProgramFavoriteMenu_Click" />
                                                <MenuItem Header="편집…" Icon="&#xE70F;" Tag="{Binding}" Click="FavoriteEditMenu_Click" />
                                                <MenuItem Header="파일 위치 열기" Icon="&#xE838;" Tag="{Binding}" Click="FavoriteFolderMenu_Click" Visibility="{Binding FolderMenuVisibility}" />
                                                <Separator />
                                                <MenuItem Header="삭제" Icon="&#xE74D;" Tag="{Binding}" Click="FavoriteDeleteMenu_Click" Style="{StaticResource DangerMenuItemStyle}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Opacity="{Binding CardOpacity}">
                                                <Grid Width="46" Height="46">
                                                    <Border CornerRadius="11" Background="#FF3A3B41" />
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" />
                                                    <Image Width="30" Height="30" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                                <Ellipse Width="5" Height="5" Margin="0,4,0,0" Opacity="0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </StackPanel.Resources>
                                <ItemsControl x:Name="DockFavorites" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border x:Name="DockDivider" Width="1" Height="40" Margin="6,0,6,10" Background="#2EFFFFFF" Visibility="Collapsed" />
                                <ItemsControl x:Name="DockRunning" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="AddProgramButton" Style="{StaticResource DockItemStyle}" Click="AddAppButton_Click" ToolTip="프로그램 추가" AutomationProperties.Name="프로그램 추가">
                                    <StackPanel>
                                        <Border Width="46" Height="46" CornerRadius="11" Background="#0FFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFC7C7CC" Text="&#xE710;" />
                                        </Border>
                                        <Ellipse Width="5" Height="5" Margin="0,4,0,0" Opacity="0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border x:Name="ErrorPanel" Grid.RowSpan="4" MaxWidth="760" Margin="24,12,24,0" Padding="12,9,8,9" VerticalAlignment="Top" Panel.ZIndex="3" AutomationProperties.LiveSetting="Assertive" Background="#FF2A2418" BorderBrush="#FF6B5A33" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Path Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top" Data="M 7,1 L 13,12 L 1,12 Z M 7,4.3 L 7,8 M 7,10.2 L 7,10.3" Stroke="#FFF0CF8A" StrokeThickness="1.4" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#FFF3DDB0" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Width="30" Height="28" Margin="10,0,0,0" Padding="0" AutomationProperties.Name="알림 닫기" Click="DismissErrorButton_Click" Content="×" FontSize="18" Style="{StaticResource ChromeButtonStyle}" ToolTip="알림 닫기" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 앱 페이지 (스토어 줄을 누르면): 아이콘·이름·버튼, 정보 줄, 스크린샷, 설명, 새로운 기능. 뒤로·Esc·마우스 뒤로 단추로 스토어 -->
            <Grid x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed">
                <ScrollViewer x:Name="DetailScrollViewer" Padding="40,16,40,28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                        <Button x:Name="DetailBackButton" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="DetailBack_Click"
                                AutomationProperties.Name="뒤로" ToolTip="뒤로 (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="DetailBackText" Text="스토어" />
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="128" Height="128" VerticalAlignment="Top">
                                <Border CornerRadius="28" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="46" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                </Border>
                                <Image Width="128" Height="128" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="24,2,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="28" FontWeight="Bold" TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" /><Run FontSize="16" FontWeight="Normal" Foreground="#FF8E8E93" Text="{Binding EnglishSuffix, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF98989D" Text="{Binding App.Description}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource DetailActionButtonStyle}" Tag="{Binding}" Click="StoreAction_Click" IsEnabled="{Binding CanInteract}"
                                            Visibility="{Binding StoreButtonVisibility}" ToolTip="{Binding RunToolTip}" AutomationProperties.Name="{Binding StoreButtonText}">
                                        <TextBlock Text="{Binding StoreButtonText}" VerticalAlignment="Center" />
                                    </Button>
                                    <Border Style="{StaticResource TagStyle}" Height="20" Margin="12,0,0,0" VerticalAlignment="Center" Background="#29E6C07A" Visibility="{Binding BetaVisibility}">
                                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#FFF0CF8A" Text="베타" />
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Height="20" Margin="8,0,0,0" VerticalAlignment="Center" Background="#293DD68C" Visibility="{Binding NewVisibility}">
                                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#FF7FE2B0" Text="NEW" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,12,0,0" MaxWidth="360" HorizontalAlignment="Left" Visibility="{Binding BusyVisibility}">
                                    <TextBlock FontSize="12" Foreground="#FF98989D" Text="{Binding BusyText}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue, Mode=OneWay}"
                                                 Background="#FF2C2D32" BorderThickness="0" Foreground="#FF4AA3FF" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 정보 줄: 버전 · 출시 · 분류 · 크기 -->
                        <Border Margin="0,26,0,0" BorderBrush="#FF2E3036" BorderThickness="0,1,0,1" Padding="0,14">
                            <ItemsControl x:Name="DetailFacts" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#FF8E8E93" Text="{Binding Label}" />
                                            <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="17" FontWeight="Bold" Foreground="#FFE5E5EA" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="11" Foreground="#FF8E8E93" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- 스크린샷: 옆으로 넘김 (Shift+휠), 누르면 크게 -->
                        <StackPanel x:Name="DetailShotsSection" Margin="0,24,0,0" Visibility="Collapsed">
                            <TextBlock Text="미리 보기" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                            <ScrollViewer x:Name="DetailShotsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,10"
                                          PreviewMouseWheel="DetailShots_PreviewMouseWheel">
                                <ItemsControl x:Name="DetailShots" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource PlainButtonStyle}" Margin="0,0,14,0" Tag="{Binding Shot}" Click="Shot_Click" ToolTip="크게 보기">
                                                <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="12" BorderBrush="#26FFFFFF" BorderThickness="1" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" /></Border.Background>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- 설명 (앱 목록의 상세 설명) -->
                        <TextBlock x:Name="DetailDescription" Margin="0,24,0,0" FontSize="14" LineHeight="23" TextWrapping="Wrap" Foreground="#FFE5E5EA" Visibility="Collapsed" />

                        <!-- 새로운 기능 (최신 릴리스) -->
                        <StackPanel x:Name="DetailNewsSection" Margin="0,28,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock x:Name="DetailNewsWhen" DockPanel.Dock="Right" VerticalAlignment="Bottom" FontSize="12.5" Foreground="#FF8E8E93" />
                                <TextBlock Text="새로운 기능" FontSize="20" FontWeight="Bold" />
                            </DockPanel>
                            <TextBlock x:Name="DetailNewsVersion" Margin="0,4,0,0" FontSize="12.5" Foreground="#FF8E8E93" />
                            <TextBlock x:Name="DetailNews" Margin="0,10,0,0" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" Foreground="#FFD1D1D6" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 스크린샷 크게 보기 (누르거나 Esc 로 닫음) -->
                <Grid x:Name="ShotViewer" Background="#F2111113" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ShotViewer_MouseLeftButtonUp">
                    <Image x:Name="ShotViewerImage" Margin="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Grid>
            <!-- 설정 · 관리자 메뉴: 위에 뒤로 (Esc 도), 아래에 그 화면 -->
            <Grid x:Name="PagePane" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button x:Name="PageBackButton" Margin="30,14,0,0" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Click="PageBack_Click"
                        AutomationProperties.Name="뒤로" ToolTip="뒤로 (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="뒤로" />
                    </StackPanel>
                </Button>
                <ContentControl x:Name="PageContent" Grid.Row="1" Margin="0,-6,0,0" Focusable="False" />
            </Grid>
        </Grid>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="2" Background="#FF19191B" BorderBrush="#FF2E3036" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CatalogSourceText" Visibility="Collapsed" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Cursor="Hand" MouseLeftButtonUp="CatalogSourceText_Click" ToolTip="앱 목록 위치 (클릭하면 열기)" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Opacity="0.75" IsHitTestVisible="False" Text="made by jy01.ahn" />
            </Grid>
        </Border>
    </Grid>
</Window>
