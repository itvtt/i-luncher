<Window x:Class="ILauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ILauncher"
        Title="i-luncher"
        Icon="Assets/ILauncher.ico"
        Foreground="#FFF5F7FB"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Width="1100" Height="640" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 도구 버튼: 회색 캡슐, 흰 글자 (스토어형) -->
            <Style x:Key="RoundedToolbarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Background" Value="#FF2C2D32" />
                <Setter Property="Foreground" Value="#FFF5F5F7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Capsule" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF3A3B41" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF232428" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF3A3B41" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Capsule" Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 앱 한 줄: 배경 없음, 마우스를 올리면 살짝 밝게 -->
            <Style x:Key="StoreRowStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FFF5F5F7" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#0FFFFFFF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Row" Property="Background" Value="#1AFFFFFF" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="#14FFFFFF" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.62" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 홍보 카드: 내용(그라데이션 카드) 그대로, 마우스를 올리면 살짝 밝게 -->
            <Style x:Key="HeroCardStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <ContentPresenter />
                                <Border x:Name="Shine" CornerRadius="18" Background="#14FFFFFF" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shine" Property="Background" Value="#1A000000" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.7" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 섹션 오른쪽 파란 글자 링크 (모두 업데이트 등) -->
            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FF4AA3FF" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="Text" Margin="0,0,0,3" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FF8CC4FF" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF6E6E73" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="#FF2A2B30" />
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="Transparent" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#FF1C1C1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 제목 표시줄 -->
        <Border Grid.Row="0" Background="#FF19191B" BorderBrush="#FF2E3036" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="28" Height="28" Margin="0,0,10,0" Source="Assets/ILauncher.png" Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#FFE8ECF4" Text="i-luncher" />
                    <TextBlock x:Name="TitleVersionText" Margin="8,1,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" AutomationProperties.Name="최소화" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최소화">
                        <Path Width="12" Height="1" Data="M 0,0.5 L 12,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton" AutomationProperties.Name="최대화" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최대화">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyph" Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph" Data="M 3.5,1.5 L 11.5,1.5 L 11.5,9.5 M 1.5,3.5 L 9.5,3.5 L 9.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" AutomationProperties.Name="닫기" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseChromeButtonStyle}" ToolTip="닫기">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <!-- 왼쪽: 검색 · 보기 · 분류 -->
            <Border Grid.Column="0" Background="#FF1F2024" BorderBrush="#FF2E3036" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Height="32" Margin="0,0,0,14" Background="#FF2C2D32" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 6.25,1.25 A 5,5 0 1 1 6.25,11.25 A 5,5 0 1 1 6.25,1.25 M 10,10 L 13.25,13.25" Stroke="#FF98989D" StrokeThickness="1.5" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,1,8,1" VerticalContentAlignment="Center" AutomationProperties.Name="앱 검색" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource TextBrush}" FontSize="13" Foreground="{StaticResource TextBrush}" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Grid.Column="1" Margin="2,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="검색" FontSize="13" Foreground="#FF98989D">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Button x:Name="AllAppsButton" Grid.Row="1" Click="FilterButton_Click" Tag="all" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="전체 앱" /><TextBlock x:Name="AllCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Button x:Name="InstalledAppsButton" Grid.Row="2" Click="FilterButton_Click" Tag="installed" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="설치된 앱" /><TextBlock x:Name="InstalledCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Button x:Name="UpdatesButton" Grid.Row="3" Click="FilterButton_Click" Tag="updates" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="업데이트" /><TextBlock x:Name="UpdatesCountText" HorizontalAlignment="Right" FontSize="11" Foreground="#FF8FD4A8" /></Grid>
                    </Button>
                    <!-- 즐겨찾기: 이 PC 의 일반 프로그램 -->
                    <Button x:Name="FavoritesButton" Grid.Row="4" Click="FilterButton_Click" Tag="favorites" Style="{StaticResource SidebarNavButtonStyle}"
                            ToolTip="이 PC 에 설치된 프로그램 바로 실행">
                        <Grid><TextBlock Text="즐겨찾기" /><TextBlock x:Name="FavoritesCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Border Grid.Row="5" Height="1" Margin="8,10,8,12" Background="#FF2E3036" />
                    <TextBlock Grid.Row="6" Margin="8,0,0,8" FontSize="11" FontWeight="SemiBold" Foreground="#FF8E8E93" Text="분류" />
                    <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryButtons" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30,20,22,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <!-- 큰 제목 · 개수 · 도구 -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NoticeButton" Click="NoticeButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="공지" ToolTip="공지">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="공지" VerticalAlignment="Center" />
                                <Ellipse x:Name="NoticeUnreadDot" Width="6" Height="6" Margin="6,0,0,0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddAppButton" Click="AddAppButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="앱 추가" ToolTip="앱 추가">
                            <TextBlock x:Name="AddAppText" Text="앱 추가" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="SettingsButton" Width="32" Padding="0" Click="SettingsButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="설정" ToolTip="설정">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="RefreshButton" Width="32" Padding="0" Click="RefreshButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="새로고침" ToolTip="새로고침 (F5)">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="SectionTitle" FontSize="28" FontWeight="Bold" Text="전체 앱" />
                        <TextBlock x:Name="CountText" Margin="10,0,0,5" VerticalAlignment="Bottom" FontSize="13" Foreground="#FF98989D" />
                    </StackPanel>
                </DockPanel>

                <!-- 런처 업데이트 -->
                <Border x:Name="LauncherUpdateBanner" Grid.Row="1" Margin="0,12,0,0" Padding="12,8" Background="#FF1A2E27" BorderBrush="#FF3C6B58" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LauncherUpdateText" VerticalAlignment="Center" Foreground="#FFBFEBD5" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="LauncherUpdateButton" Grid.Column="1" Content="지금 업데이트" Margin="12,0,0,0" Padding="10,4" Click="LauncherUpdateButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                </Border>

                <!-- 공지 -->
                <Border x:Name="NoticeBanner" Grid.Row="2" Margin="0,12,0,0" Padding="12,8" Background="#FF1D2C41" BorderBrush="#FF385577" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="공지" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#FFAECFFF" FontWeight="SemiBold" />
                        <TextBlock x:Name="NoticeBannerTitle" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="보기" Margin="12,0,0,0" Padding="10,4" Click="NoticeBanner_Click" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="공지 보기" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <ScrollViewer x:Name="CardScrollViewer" Padding="0,0,8,16" SizeChanged="CardScrollViewer_SizeChanged" ScrollChanged="CardScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <!-- 앱 한 줄: 아이콘 · 이름(길면 두 줄) · 설명 · 오른쪽 열기/업데이트/받기 -->
                            <DataTemplate DataType="{x:Type local:AppCard}">
                                <Grid Margin="0,0,20,0">
                                    <Button Style="{StaticResource StoreRowStyle}" Tag="{Binding}" Click="Card_Click" IsEnabled="{Binding CanInteract}" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding RunToolTip}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="실행" Tag="{Binding}" Click="LaunchMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                            <MenuItem Header="{Binding FavoriteMenuHeader}" Tag="{Binding}" Click="FavoriteToggleMenu_Click" />
                                            <MenuItem Header="업데이트" Tag="{Binding}" Click="UpdateMenu_Click" Visibility="{Binding UpdateMenuVisibility}" />
                                            <MenuItem Header="설치 / 다시 설치" Tag="{Binding}" Click="ReinstallMenu_Click" />
                                            <MenuItem Header="제거" Tag="{Binding}" Click="UninstallMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                            <Separator />
                                            <MenuItem Header="편집…" Tag="{Binding}" Click="EditMenu_Click" />
                                            <MenuItem Header="목록에서 삭제…" Tag="{Binding}" Click="DeleteMenu_Click" />
                                            <Separator />
                                            <MenuItem Header="저장소 열기" Tag="{Binding}" Click="OpenRepositoryMenu_Click" />
                                            <MenuItem Header="릴리스 노트 보기" Tag="{Binding}" Click="OpenReleaseMenu_Click" Visibility="{Binding ReleaseMenuVisibility}" />
                                            <MenuItem Header="설치 폴더 열기" Tag="{Binding}" Click="OpenFolderMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid Height="78">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Width="56" Height="56" VerticalAlignment="Center">
                                                <Border CornerRadius="13" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" />
                                                <Image Width="56" Height="56" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,8,8,8" VerticalAlignment="Center">
                                                <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{Binding TitleBrush}" ToolTip="{Binding FullName}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" /><Run FontSize="12" FontWeight="Normal" Foreground="#FF8E8E93" Text="{Binding EnglishSuffix, Mode=OneWay}" /></TextBlock>
                                                <DockPanel Margin="0,2,0,0">
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource TagStyle}" Height="17" Padding="5,0" Margin="0,0,5,0" Background="#29E6C07A" Visibility="{Binding BetaVisibility}" AutomationProperties.Name="베타">
                                                        <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FFF0CF8A" Text="베타" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource TagStyle}" Height="17" Padding="5,0" Margin="0,0,5,0" Background="#293DD68C" Visibility="{Binding NewVisibility}" AutomationProperties.Name="새 앱">
                                                        <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FF7FE2B0" Text="NEW" />
                                                    </Border>
                                                    <TextBlock FontSize="12" Foreground="#FF98989D" Text="{Binding DescriptionText}" ToolTip="{Binding DescriptionText}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </StackPanel>
                                            <Border Grid.Column="2" Height="28" MinWidth="52" Padding="12,0" CornerRadius="14" VerticalAlignment="Center" Background="#FF2C2D32" Visibility="{Binding StoreButtonVisibility}"
                                                    ToolTip="{Binding VersionToolTip}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FF4AA3FF" Text="{Binding StoreButtonText}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Border Height="1" Margin="66,0,0,0" VerticalAlignment="Bottom" Background="#FF2E3036" IsHitTestVisible="False" />
                                    <ProgressBar Height="2" Margin="66,0,0,1" VerticalAlignment="Bottom" IsHitTestVisible="False" Minimum="0" Maximum="100"
                                                 IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue, Mode=OneWay}" Visibility="{Binding BusyVisibility}"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FF4AA3FF" />
                                </Grid>
                            </DataTemplate>

                            <!-- 맨 위 큰 홍보 카드: 아이콘 색 그라데이션, 머리글 · 제목 · 설명, 큰 아이콘, 아래 앱 이름과 버튼 -->
                            <DataTemplate DataType="{x:Type local:HeroItem}">
                                <Button Style="{StaticResource HeroCardStyle}" Margin="0,6,18,8" Height="232" Tag="{Binding Card}" Click="Card_Click" IsEnabled="{Binding Card.CanInteract}"
                                        ToolTip="{Binding Card.RunToolTip}" AutomationProperties.Name="{Binding Card.Name}">
                                    <Border CornerRadius="18" Background="{Binding Art}" Padding="22,20,22,16">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#D9FFFFFF" Text="{Binding Eyebrow}" />
                                            <StackPanel Grid.Row="1" Margin="0,4,118,0">
                                                <TextBlock FontSize="23" FontWeight="Bold" Foreground="White" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#B3FFFFFF" Text="{Binding Card.EnglishName}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Margin="0,6,118,0" MaxHeight="40" FontSize="13.5" LineHeight="19" Foreground="#E6FFFFFF" Text="{Binding Subtitle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.RowSpan="4" Width="100" Height="100" Margin="0,22,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Grid.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.35" Color="#FF000000" /></Grid.Effect>
                                                <Border CornerRadius="24" Background="{Binding Card.TileBrush}" Visibility="{Binding Card.InitialsVisibility}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="38" FontWeight="Bold" Foreground="White" Text="{Binding Card.Initials}" />
                                                </Border>
                                                <Image Width="100" Height="100" Source="{Binding Card.Icon}" Stretch="Uniform" Visibility="{Binding Card.IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <Border Grid.Row="4" BorderBrush="#40FFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Height="28" MinWidth="52" Padding="14,0" CornerRadius="14" Background="#40FFFFFF" VerticalAlignment="Center" Visibility="{Binding Card.StoreButtonVisibility}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" Text="{Binding Card.StoreButtonText}" />
                                                    </Border>
                                                    <Grid Width="34" Height="34" DockPanel.Dock="Left">
                                                        <Border CornerRadius="9" Background="{Binding Card.TileBrush}" Visibility="{Binding Card.InitialsVisibility}">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White" Text="{Binding Card.Initials}" />
                                                        </Border>
                                                        <Image Width="34" Height="34" Source="{Binding Card.Icon}" Stretch="Uniform" Visibility="{Binding Card.IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                    <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="White" Text="{Binding Card.Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11.5" Foreground="#CCFFFFFF" Text="{Binding Card.Category}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>

                            <!-- 순위 한 줄 (최근 업데이트): 아이콘 · 번호 · 이름 · 분류와 날짜 · 버튼 -->
                            <DataTemplate DataType="{x:Type local:RankItem}">
                                <Grid Margin="0,0,20,0">
                                    <Button Style="{StaticResource StoreRowStyle}" Tag="{Binding Card}" Click="Card_Click" IsEnabled="{Binding Card.CanInteract}" ToolTip="{Binding Card.RunToolTip}"
                                            AutomationProperties.Name="{Binding Card.Name}">
                                        <Grid Height="72">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Width="48" Height="48" VerticalAlignment="Center">
                                                <Border CornerRadius="11" Background="{Binding Card.TileBrush}" Visibility="{Binding Card.InitialsVisibility}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="White" Text="{Binding Card.Initials}" />
                                                </Border>
                                                <Image Width="48" Height="48" Source="{Binding Card.Icon}" Stretch="Uniform" Visibility="{Binding Card.IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#FFF5F5F7" Text="{Binding Rank}" />
                                            <StackPanel Grid.Column="2" Margin="4,0,8,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{Binding Card.TitleBrush}" ToolTip="{Binding Card.FullName}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Card.Name, Mode=OneWay}" /><Run FontSize="12" FontWeight="Normal" Foreground="#FF8E8E93" Text="{Binding Card.EnglishSuffix, Mode=OneWay}" /></TextBlock>
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#FF98989D" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Height="28" MinWidth="52" Padding="12,0" CornerRadius="14" VerticalAlignment="Center" Background="#FF2C2D32" Visibility="{Binding Card.StoreButtonVisibility}"
                                                    ToolTip="{Binding Card.VersionToolTip}">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FF4AA3FF" Text="{Binding Card.StoreButtonText}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Border Height="1" Margin="94,0,0,0" VerticalAlignment="Bottom" Background="#FF2E3036" IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>

                            <!-- 즐겨찾기의 내 PC 프로그램 한 줄 -->
                            <DataTemplate DataType="{x:Type local:FavoriteCard}">
                                <Grid Margin="0,0,20,0">
                                    <Button Style="{StaticResource StoreRowStyle}" Tag="{Binding}" Click="FavoriteCard_Click" ToolTip="{Binding ToolTipText}" Opacity="{Binding CardOpacity}"
                                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="실행" Tag="{Binding}" Click="FavoriteRunMenu_Click" />
                                            <MenuItem Header="편집…" Tag="{Binding}" Click="FavoriteEditMenu_Click" />
                                            <MenuItem Header="파일 위치 열기" Tag="{Binding}" Click="FavoriteFolderMenu_Click" />
                                            <Separator />
                                            <MenuItem Header="삭제" Tag="{Binding}" Click="FavoriteDeleteMenu_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid Height="78">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Width="56" Height="56" VerticalAlignment="Center">
                                                <Border CornerRadius="13" Background="#FF2C2D32" Visibility="{Binding InitialsVisibility}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                                </Border>
                                                <Image Width="48" Height="48" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,8,8,8" VerticalAlignment="Center">
                                                <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="#FFF5F5F7" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#FF98989D" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Height="28" MinWidth="52" Padding="12,0" CornerRadius="14" VerticalAlignment="Center" Background="#FF2C2D32">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FF4AA3FF" Text="열기" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Border Height="1" Margin="66,0,0,0" VerticalAlignment="Bottom" Background="#FF2E3036" IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ScrollViewer.Resources>

                        <!-- 섹션: 제목 · 오른쪽 링크(모두 업데이트 등) · 줄 목록 (창 폭에 맞춰 1~4열) -->
                        <ItemsControl x:Name="SectionList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:StoreSection}">
                                    <StackPanel Margin="0,8,0,10">
                                        <Border BorderBrush="#FF38383A" BorderThickness="0,1,0,0" Padding="0,14,0,2" Visibility="{Binding HeaderVisibility}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="{Binding ActionText}" Tag="{Binding}" Click="SectionAction_Click"
                                                        Visibility="{Binding ActionVisibility}" IsEnabled="{Binding ActionEnabled}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Title}" />
                                                    <TextBlock Margin="8,0,0,2" VerticalAlignment="Bottom" FontSize="13" Foreground="#FF98989D" Text="{Binding Note}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="460">
                        <TextBlock x:Name="EmptyStateTitle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyStateText" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="EmptyStateButton" Margin="0,14,0,0" Padding="14,7" HorizontalAlignment="Center" Click="EmptyStateButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Border x:Name="ErrorPanel" Grid.RowSpan="5" Padding="12,9,8,9" VerticalAlignment="Top" Panel.ZIndex="3" AutomationProperties.LiveSetting="Assertive" Background="#FF2A2418" BorderBrush="#FF6B5A33" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Path Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top" Data="M 7,1 L 13,12 L 1,12 Z M 7,4.3 L 7,8 M 7,10.2 L 7,10.3" Stroke="#FFF0CF8A" StrokeThickness="1.4" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#FFF3DDB0" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Width="30" Height="28" Margin="10,0,0,0" Padding="0" AutomationProperties.Name="알림 닫기" Click="DismissErrorButton_Click" Content="×" FontSize="18" Style="{StaticResource ChromeButtonStyle}" ToolTip="알림 닫기" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="2" Background="#FF19191B" BorderBrush="#FF2E3036" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CatalogSourceText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Cursor="Hand" MouseLeftButtonUp="CatalogSourceText_Click" ToolTip="앱 목록 위치 (클릭하면 열기)" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
