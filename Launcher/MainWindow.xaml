<Window x:Class="ILauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="i-luncher"
        Icon="Assets/ILauncher.ico"
        Foreground="#FFF5F7FB"
        FontFamily="Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="1100"
        Height="600"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RoundedToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#FF202635" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF46516A" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#FF111520" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CircularPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedToolbarButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#FF3864D9" />
                <Setter Property="BorderBrush" Value="#FF6C91FA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#FF4E75E5" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF9BB2FF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#FF294EBB" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RegistrationActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FFA8DAB5" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="RegistrationFocus" Margin="-3,0,-3,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFC4E8CD" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="#FFF5F7FB" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsManagedInstalled}" Value="True">
                                    <Setter Property="Foreground" Value="#FFE59AA6" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsManagedInstalled}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="#FFF2B6BE" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsManagedInstalled}" Value="True" />
                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="#FFD98290" />
                                </MultiDataTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="RegistrationFocus" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="#FF202635" />
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="#FF30394A" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
        <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SubtleSurfaceBrush}"
                BorderBrush="#FF202632" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="28" Height="28" Margin="0,0,10,0" Source="Assets/ILauncher.png" Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#FFE8ECF4" Text="i-luncher" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" AutomationProperties.AutomationId="MinimizeButton" AutomationProperties.Name="최소화" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최소화">
                        <Path Width="12" Height="1" Data="M 0,0.5 L 12,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton" AutomationProperties.AutomationId="MaximizeButton" AutomationProperties.Name="최대화" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최대화">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyph" Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph" Data="M 3.5,1.5 L 11.5,1.5 L 11.5,9.5 M 1.5,3.5 L 9.5,3.5 L 9.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" AutomationProperties.AutomationId="CloseButton" AutomationProperties.Name="닫기" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseChromeButtonStyle}" ToolTip="닫기">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="148" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FF141821" BorderBrush="#FF252C39" BorderThickness="0,0,1,0">
                <Grid Margin="12,17,10,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="8,0,0,12" FontSize="12" FontWeight="SemiBold" Foreground="#FF8C96A8" Text="라이브러리" />
                    <Button x:Name="AllAppsButton" Grid.Row="1" Content="전체 앱" Click="AllAppsButton_Click" Style="{StaticResource SidebarNavButtonStyle}" />
                    <Button x:Name="InstalledAppsButton" Grid.Row="2" Content="설치된 앱" Click="InstalledAppsButton_Click" Style="{StaticResource SidebarNavButtonStyle}" />
                    <Border Grid.Row="3" Margin="8,8,8,12" Background="#FF2B3240" />
                    <TextBlock Grid.Row="4" Margin="8,0,0,8" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF697486" Text="분류" />
                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryButtons" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Height="38" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="37" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 6.25,1.25 A 5,5 0 1 1 6.25,11.25 A 5,5 0 1 1 6.25,1.25 M 10,10 L 13.25,13.25" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.4" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,1,10,1" VerticalContentAlignment="Center" AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="앱 검색" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource TextBrush}" FontSize="13" Foreground="{StaticResource TextBrush}" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="앱 검색" Foreground="{StaticResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button x:Name="NoticeButton" Height="34" Margin="0,0,6,0" Padding="10,0" Click="NoticeButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.AutomationId="NoticeButton" AutomationProperties.Name="공지" ToolTip="공지">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="공지" VerticalAlignment="Center" />
                                <Ellipse x:Name="NoticeUnreadDot" Width="6" Height="6" Margin="6,0,0,0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenFolderButton" Width="34" Height="34" Margin="0,0,6,0" Padding="0" AutomationProperties.AutomationId="OpenFolderButton" AutomationProperties.Name="앱 폴더 열기" Click="OpenFolderButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" ToolTip="앱 폴더 열기">
                            <Path Width="16" Height="16" Stretch="Uniform" Data="M2,4 L6,4 L8,6 L14,6 L14,13 L2,13 Z M8,10 L11,7 M9,7 L11,7 L11,9" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="RefreshButton" Width="34" Height="34" Padding="0" AutomationProperties.AutomationId="RefreshButton" AutomationProperties.Name="앱 목록 새로고침" Click="RefreshButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" ToolTip="새로고침">
                            <Path Width="16" Height="16" Stretch="Uniform" Data="M13,6 A5,5 0 1 0 14,9 M13,3 L13,6 L10,6" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border x:Name="NoticeBanner" Grid.Row="1" Margin="0,12,0,0" Padding="12,8" Background="#FF1D2C41" BorderBrush="#FF385577" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="공지" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#FFAECFFF" FontWeight="SemiBold" />
                        <TextBlock x:Name="NoticeBannerTitle" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="보기" Margin="12,0,0,0" Padding="10,4" Click="NoticeBanner_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="중요 공지 보기" />
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SectionTitle" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="전체 앱" />
                    <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Text="0개 앱" />
                </Grid>
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="CardScrollViewer" Padding="0,0,8,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LauncherItems" ItemsSource="{Binding LauncherCards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="280" Height="108" Margin="0,0,16,12" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                                        <Grid Margin="-1">
                                            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" Cursor="Hand" Tag="{Binding}" Click="LauncherCard_Click" ContextMenuOpening="LauncherCard_ContextMenuOpening" MouseEnter="LauncherCard_MouseEnter" MouseLeave="LauncherCard_MouseLeave" PreviewMouseDown="LauncherCard_PreviewMouseDown" PreviewMouseUp="LauncherCard_PreviewMouseUp" PreviewKeyDown="LauncherCard_PreviewKeyDown" PreviewKeyUp="LauncherCard_PreviewKeyUp" RenderTransformOrigin="0.5,0.5" IsEnabled="{Binding CanInteract}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding RunToolTip}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding RunAccessibleName}">
                                                <Button.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Button.RenderTransform>
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="앱 작업 메뉴">
                                                        <MenuItem Header="업데이트" Tag="{Binding}" Click="UpdateContextMenuItem_Click" AutomationProperties.Name="앱 업데이트" Visibility="Collapsed" />
                                                        <MenuItem Header="제거" Tag="{Binding}" Click="RemoveContextMenuItem_Click" AutomationProperties.Name="앱 제거" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <Border x:Name="LaunchSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" />
                                                            <Border x:Name="LaunchHoverOverlay" Background="{Binding CardHoverBrush}" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
                                                            <ContentPresenter />
                                                            <Border x:Name="CardStateOutline" CornerRadius="12" BorderBrush="{Binding CardBorderBrush}" BorderThickness="2" IsHitTestVisible="False" />
                                                            <Border x:Name="LaunchHoverOutline" CornerRadius="12" BorderBrush="{Binding CardHoverBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
                                                            <Border x:Name="LaunchFocusOverlay" CornerRadius="12" BorderBrush="Transparent" BorderThickness="2" IsHitTestVisible="False" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LaunchSurface" Property="Background" Value="#FF1B222D" /></Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LaunchFocusOverlay" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="LaunchSurface" Property="Background" Value="#FF111520" /></Trigger>
                                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Border Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,20,0,0" Background="#FF222A3A" BorderBrush="#FF343F55" BorderThickness="1" CornerRadius="12" ToolTip="{Binding IconToolTip}">
                                                        <Grid>
                                                            <Grid.Clip>
                                                                <RectangleGeometry Rect="0,0,64,64" RadiusX="12" RadiusY="12" />
                                                            </Grid.Clip>
                                                            <Image Source="{Binding IconSource}" Stretch="Uniform" Opacity="{Binding IconOpacity}" Visibility="{Binding IconVisibility}" />
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="#FFC6D3FF" Opacity="{Binding IconOpacity}" Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="92,10,0,0" Width="100" Height="22" FontSize="14" FontWeight="SemiBold" Foreground="{Binding CardTitleBrush}" Text="{Binding Entry.Name}" ToolTip="{Binding Entry.Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <Border x:Name="CategoryBadge" Width="64" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" Padding="4,0" Background="#FF222A3A" BorderBrush="#FF46516A" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False">
                                                        <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center" FontSize="10" Foreground="#FFC6D3FF" Text="{Binding Entry.Category}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </Border>
                                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="92,34,0,0" Width="176" Height="32" FontSize="11" Foreground="{Binding CardDescriptionBrush}" Text="{Binding DescriptionText}" ToolTip="{Binding DescriptionText}" AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="92,72,0,0" Width="176" Height="24" FontSize="11" Foreground="{Binding VersionBrush}" Text="{Binding VersionText}" ToolTip="{Binding VersionToolTip}" AutomationProperties.Name="{Binding VersionToolTip}" Visibility="{Binding VersionVisibility}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </Grid>
                                            </Button>
                                            <ProgressBar Height="3" Margin="12,0,12,2" VerticalAlignment="Bottom" IsIndeterminate="True" IsHitTestVisible="False" AutomationProperties.Name="작업 진행 상황">
                                                <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyStateTitle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="일치하는 앱이 없습니다" />
                        <Button x:Name="ClearFiltersButton" Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Center" Click="ClearFiltersButton_Click" Content="필터 지우기" Style="{StaticResource RoundedToolbarButtonStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <Border x:Name="ErrorPanel" Grid.RowSpan="4" Margin="0,0,0,0" Padding="12,9,8,9" VerticalAlignment="Top" Panel.ZIndex="3" AutomationProperties.LiveSetting="Assertive" Background="#FF2B1C21" BorderBrush="#FF61313C" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Path Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top" Data="M 7,1 L 13,12 L 1,12 Z M 7,4.3 L 7,8 M 7,10.2 L 7,10.3" Stroke="#FFFFB4C0" StrokeThickness="1.4" />
