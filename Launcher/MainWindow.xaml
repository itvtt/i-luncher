<Window x:Class="ILauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ILauncher"
        Title="i-luncher"
        Icon="Assets/ILauncher.ico"
        Foreground="#FFF5F7FB"
        FontFamily="pack://application:,,,/i-luncher;component/Assets/Fonts/#Pretendard"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Width="1100" Height="640" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 도구 버튼: 회색 캡슐, 흰 글자 (스토어형) -->
            <Style x:Key="RoundedToolbarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Background" Value="#FF2C2D32" />
                <Setter Property="Foreground" Value="#FFF5F5F7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Capsule" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF3A3B41" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF232428" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#FF3A3B41" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Capsule" Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 앱 카드: 옅은 반투명 유리 (위가 조금 밝은 흰 막 + 가는 테두리), 마우스를 올리면 조금 더 밝게 -->
            <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#12FFFFFF" Offset="0" />
                <GradientStop Color="#08FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassCardHoverBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1EFFFFFF" Offset="0" />
                <GradientStop Color="#10FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassCardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#24FFFFFF" Offset="0" />
                <GradientStop Color="#0CFFFFFF" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="StoreRowStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassCardEdgeBrush}" />
                <Setter Property="Foreground" Value="#FFF5F5F7" />
                <Setter Property="Padding" Value="14,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource GlassCardHoverBrush}" /><Setter TargetName="Row" Property="BorderBrush" Value="#38FFFFFF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Row" Property="Background" Value="#0AFFFFFF" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#FF4AA3FF" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.62" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 카드 오른쪽 버튼 (열기·받기·업데이트): 누르면 바로 실행·설치 (카드의 나머지는 앱 페이지). 회색 캡슐에 파란 굵은 글자 -->
            <Style x:Key="StoreActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="52" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#FF2C2D32" />
                <Setter Property="Foreground" Value="#FF4AA3FF" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="999" />
                                <Border x:Name="Shine" Background="#1FFFFFFF" CornerRadius="999" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shine" Property="Background" Value="#26000000" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HeroActionButtonStyle" TargetType="Button" BasedOn="{StaticResource StoreActionButtonStyle}">
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Background" Value="#40FFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <!-- 앱 페이지의 큰 버튼: 둥근 사각, 위가 밝은 파란 그라데이션과 가는 빛 테두리, 아래로 파란 빛. 아이콘 + 글자 -->
            <Style x:Key="DetailActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38" />
                <Setter Property="MinWidth" Value="116" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border CornerRadius="10" Background="#FF2F6BEB" Opacity="0.55" Margin="4,6,4,-4">
                                    <Border.Effect><BlurEffect Radius="14" /></Border.Effect>
                                </Border>
                                <Border CornerRadius="10" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF5B97FF" Offset="0" />
                                            <GradientStop Color="#FF2C66E5" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#66FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>
                                <Border x:Name="Shine" CornerRadius="10" Background="#1FFFFFFF" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shine" Property="Background" Value="#29000000" /><Setter TargetName="Shine" Property="Opacity" Value="1" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 큰 버튼 옆 네모 아이콘 버튼 (즐겨찾기 별 · 더 보기): 옅은 유리, 마우스를 올리면 조금 밝게 -->
            <Style x:Key="DetailIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="Foreground" Value="#FFE5E5EA" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Face" CornerRadius="10" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#24FFFFFF" /><Setter TargetName="Face" Property="BorderBrush" Value="#40FFFFFF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#0DFFFFFF" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF4AA3FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 스크린샷: 누르면 크게 -->
            <Style x:Key="PlainButtonStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 홍보 카드: 내용(그라데이션 카드) 그대로, 마우스를 올리면 살짝 밝게 -->
            <Style x:Key="HeroCardStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <ContentPresenter />
                                <Border x:Name="Shine" CornerRadius="18" Background="#14FFFFFF" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shine" Property="Background" Value="#1A000000" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.7" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 섹션 오른쪽 파란 글자 링크 (모두 업데이트 등) -->
            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FF4AA3FF" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="Text" Margin="0,0,0,3" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FF8CC4FF" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF6E6E73" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="#FF2A2B30" />
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="Transparent" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#FF1C1C1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 제목 표시줄 -->
        <Border Grid.Row="0" Background="#FF19191B" BorderBrush="#FF2E3036" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="28" Height="28" Margin="0,0,10,0" Source="Assets/ILauncher.png" Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#FFE8ECF4" Text="i-luncher" />
                    <TextBlock x:Name="TitleVersionText" Margin="8,1,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" AutomationProperties.Name="최소화" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최소화">
                        <Path Width="12" Height="1" Data="M 0,0.5 L 12,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton" AutomationProperties.Name="최대화" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최대화">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyph" Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph" Data="M 3.5,1.5 L 11.5,1.5 L 11.5,9.5 M 1.5,3.5 L 9.5,3.5 L 9.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" AutomationProperties.Name="닫기" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseChromeButtonStyle}" ToolTip="닫기">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <!-- 왼쪽: 검색 · 보기 · 분류 -->
            <Border Grid.Column="0" Background="#FF1F2024" BorderBrush="#FF2E3036" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Height="32" Margin="0,0,0,14" Background="#FF2C2D32" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 6.25,1.25 A 5,5 0 1 1 6.25,11.25 A 5,5 0 1 1 6.25,1.25 M 10,10 L 13.25,13.25" Stroke="#FF98989D" StrokeThickness="1.5" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,1,8,1" VerticalContentAlignment="Center" AutomationProperties.Name="앱 검색" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource TextBrush}" FontSize="13" Foreground="{StaticResource TextBrush}" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Grid.Column="1" Margin="2,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="검색" FontSize="13" Foreground="#FF98989D">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Button x:Name="AllAppsButton" Grid.Row="1" Click="FilterButton_Click" Tag="all" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="전체 앱" /><TextBlock x:Name="AllCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Button x:Name="InstalledAppsButton" Grid.Row="2" Click="FilterButton_Click" Tag="installed" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="설치된 앱" /><TextBlock x:Name="InstalledCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Button x:Name="UpdatesButton" Grid.Row="3" Click="FilterButton_Click" Tag="updates" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="업데이트" /><TextBlock x:Name="UpdatesCountText" HorizontalAlignment="Right" FontSize="11" Foreground="#FF8FD4A8" /></Grid>
                    </Button>
                    <!-- 즐겨찾기: 이 PC 의 일반 프로그램 -->
                    <Button x:Name="FavoritesButton" Grid.Row="4" Click="FilterButton_Click" Tag="favorites" Style="{StaticResource SidebarNavButtonStyle}"
                            ToolTip="이 PC 에 설치된 프로그램 바로 실행">
                        <Grid><TextBlock Text="즐겨찾기" /><TextBlock x:Name="FavoritesCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Border Grid.Row="5" Height="1" Margin="8,10,8,12" Background="#FF2E3036" />
                    <TextBlock Grid.Row="6" Margin="8,0,0,8" FontSize="11" FontWeight="SemiBold" Foreground="#FF8E8E93" Text="분류" />
                    <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryButtons" />
                    </ScrollViewer>
                    <!-- API Manager: 마스터 계정만 (빌드 설정 MASTER_USERS) -->
                    <StackPanel x:Name="ApiManagerPanel" Grid.Row="8" Visibility="Collapsed">
                        <Border Height="1" Margin="8,8,8,10" Background="#FF2E3036" />
                        <Button x:Name="ApiManagerButton" Click="ApiManagerButton_Click" Style="{StaticResource SidebarNavButtonStyle}" ToolTip="API 서버 관리">
                            <TextBlock Text="API Manager" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="StorePane" Grid.Column="1" Margin="30,20,22,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <!-- 큰 제목 · 개수 · 도구 -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NoticeButton" Click="NoticeButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="공지" ToolTip="공지">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="공지" VerticalAlignment="Center" />
                                <Ellipse x:Name="NoticeUnreadDot" Width="6" Height="6" Margin="6,0,0,0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddAppButton" Click="AddAppButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="앱 추가" ToolTip="앱 추가">
                            <TextBlock x:Name="AddAppText" Text="앱 추가" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="SettingsButton" Width="32" Padding="0" Click="SettingsButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="설정" ToolTip="설정">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="RefreshButton" Width="32" Padding="0" Click="RefreshButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="새로고침" ToolTip="새로고침 (F5)">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="SectionTitle" FontSize="28" FontWeight="Bold" Text="전체 앱" />
                        <TextBlock x:Name="CountText" Margin="10,0,0,5" VerticalAlignment="Bottom" FontSize="13" Foreground="#FF98989D" />
                    </StackPanel>
                </DockPanel>

                <!-- 런처 업데이트 -->
                <Border x:Name="LauncherUpdateBanner" Grid.Row="1" Margin="0,12,0,0" Padding="12,8" Background="#FF1A2E27" BorderBrush="#FF3C6B58" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LauncherUpdateText" VerticalAlignment="Center" Foreground="#FFBFEBD5" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="LauncherUpdateButton" Grid.Column="1" Content="지금 업데이트" Margin="12,0,0,0" Padding="10,4" Click="LauncherUpdateButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                </Border>

                <!-- 공지 -->
                <Border x:Name="NoticeBanner" Grid.Row="2" Margin="0,12,0,0" Padding="12,8" Background="#FF1D2C41" BorderBrush="#FF385577" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="공지" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#FFAECFFF" FontWeight="SemiBold" />
                        <TextBlock x:Name="NoticeBannerTitle" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="보기" Margin="12,0,0,0" Padding="10,4" Click="NoticeBanner_Click" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="공지 보기" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <ScrollViewer x:Name="CardScrollViewer" Padding="0,0,8,16" SizeChanged="CardScrollViewer_SizeChanged" ScrollChanged="CardScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <!-- 앱 한 줄: 아이콘 · 이름(길면 두 줄) · 설명 · 오른쪽 열기/업데이트/받기 -->
                            <DataTemplate DataType="{x:Type local:AppCard}">
                                <Grid Margin="0,0,12,12">
                                    <Button Style="{StaticResource StoreRowStyle}" Tag="{Binding}" Click="Card_Click"
                                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="실행" Icon="&#xE768;" Tag="{Binding}" Click="LaunchMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                            <MenuItem Header="{Binding FavoriteMenuHeader}" Icon="{Binding FavoriteGlyph}" Tag="{Binding}" Click="FavoriteToggleMenu_Click" />
                                            <MenuItem Header="업데이트" Icon="&#xE896;" Tag="{Binding}" Click="UpdateMenu_Click" Visibility="{Binding UpdateMenuVisibility}" />
                                            <MenuItem Header="설치 / 다시 설치" Icon="&#xE72C;" Tag="{Binding}" Click="ReinstallMenu_Click" />
                                            <Separator />
                                            <MenuItem Header="저장소 열기" Icon="&#xE8A7;" Tag="{Binding}" Click="OpenRepositoryMenu_Click" />
                                            <MenuItem Header="릴리스 노트 보기" Icon="&#xE8A5;" Tag="{Binding}" Click="OpenReleaseMenu_Click" Visibility="{Binding ReleaseMenuVisibility}" />
                                            <MenuItem Header="설치 폴더 열기" Icon="&#xE838;" Tag="{Binding}" Click="OpenFolderMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                            <Separator />
                                            <MenuItem Header="편집…" Icon="&#xE70F;" Tag="{Binding}" Click="EditMenu_Click" />
                                            <MenuItem Header="제거" Icon="&#xE74D;" Tag="{Binding}" Click="UninstallMenu_Click" Visibility="{Binding InstalledMenuVisibility}"
                                                      Style="{StaticResource DangerMenuItemStyle}" />
                                            <MenuItem Header="목록에서 삭제…" Icon="&#xE738;" Tag="{Binding}" Click="DeleteMenu_Click" Style="{StaticResource DangerMenuItemStyle}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid Height="78">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Width="56" Height="56" VerticalAlignment="Center">
                                                <Border CornerRadius="13" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" />
                                                <Image Width="56" Height="56" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,8,8,8" VerticalAlignment="Center">
                                                <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{Binding TitleBrush}" ToolTip="{Binding FullName}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" /><Run FontSize="12" FontWeight="Normal" Foreground="#FF8E8E93" Text="{Binding EnglishSuffix, Mode=OneWay}" /></TextBlock>
                                                <DockPanel Margin="0,2,0,0">
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource TagStyle}" Height="17" Padding="5,0" Margin="0,0,5,0" Background="#29E6C07A" Visibility="{Binding BetaVisibility}" AutomationProperties.Name="베타">
                                                        <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FFF0CF8A" Text="베타" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource TagStyle}" Height="17" Padding="5,0" Margin="0,0,5,0" Background="#293DD68C" Visibility="{Binding NewVisibility}" AutomationProperties.Name="새 앱">
                                                        <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FF7FE2B0" Text="NEW" />
                                                    </Border>
                                                    <TextBlock FontSize="12" Foreground="#FF98989D" Text="{Binding DescriptionText}" ToolTip="{Binding DescriptionText}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource StoreActionButtonStyle}" Tag="{Binding}" Click="StoreAction_Click" IsEnabled="{Binding CanInteract}"
                                                    Visibility="{Binding StoreButtonVisibility}" ToolTip="{Binding RunToolTip}" Content="{Binding StoreButtonText}"
                                                    AutomationProperties.Name="{Binding StoreButtonText}" />
                                        </Grid>
                                    </Button>
                                    <ProgressBar Height="2" Margin="16,0,16,1" VerticalAlignment="Bottom" IsHitTestVisible="False" Minimum="0" Maximum="100"
                                                 IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue, Mode=OneWay}" Visibility="{Binding BusyVisibility}"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FF4AA3FF" />
                                </Grid>
                            </DataTemplate>

                            <!-- 맨 위 큰 홍보 카드: 아이콘 색 그라데이션, 머리글 · 제목 · 설명, 큰 아이콘, 아래 앱 이름과 버튼 -->
                            <DataTemplate DataType="{x:Type local:HeroItem}">
                                <Button Style="{StaticResource HeroCardStyle}" Margin="0,6,12,12" Height="232" Tag="{Binding Card}" Click="Card_Click"
                                        AutomationProperties.Name="{Binding Card.Name}">
                                    <Border CornerRadius="18" Background="{Binding Art}" Padding="22,20,22,16">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#D9FFFFFF" Text="{Binding Eyebrow}" />
                                            <TextBlock Grid.Row="1" Margin="0,4,118,0" FontSize="23" FontWeight="Bold" Foreground="White" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Margin="0,4,118,0" MaxHeight="40" FontSize="13.5" LineHeight="19" Foreground="#E6FFFFFF" Text="{Binding Subtitle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.RowSpan="4" Width="100" Height="100" Margin="0,22,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Grid.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.35" Color="#FF000000" /></Grid.Effect>
                                                <Border CornerRadius="24" Background="{Binding Card.TileBrush}" Visibility="{Binding Card.InitialsVisibility}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="38" FontWeight="Bold" Foreground="White" Text="{Binding Card.Initials}" />
                                                </Border>
                                                <Image Width="100" Height="100" Source="{Binding Card.Icon}" Stretch="Uniform" Visibility="{Binding Card.IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <Border Grid.Row="4" BorderBrush="#40FFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource HeroActionButtonStyle}" Tag="{Binding Card}" Click="StoreAction_Click" IsEnabled="{Binding Card.CanInteract}"
                                                            Visibility="{Binding Card.StoreButtonVisibility}" ToolTip="{Binding Card.RunToolTip}" Content="{Binding Card.StoreButtonText}"
                                                            AutomationProperties.Name="{Binding Card.StoreButtonText}" />
                                                    <Grid Width="34" Height="34" DockPanel.Dock="Left">
                                                        <Border CornerRadius="9" Background="{Binding Card.TileBrush}" Visibility="{Binding Card.InitialsVisibility}">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White" Text="{Binding Card.Initials}" />
                                                        </Border>
                                                        <Image Width="34" Height="34" Source="{Binding Card.Icon}" Stretch="Uniform" Visibility="{Binding Card.IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                    <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="White" Text="{Binding Card.Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11.5" Foreground="#CCFFFFFF" Text="{Binding Card.Category}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>

                            <!-- 순위 한 줄 (최근 업데이트): 아이콘 · 번호 · 이름 · 분류와 날짜 · 버튼 -->
                            <DataTemplate DataType="{x:Type local:RankItem}">
                                <Grid Margin="0,0,12,12">
                                    <Button Style="{StaticResource StoreRowStyle}" Tag="{Binding Card}" Click="Card_Click" AutomationProperties.Name="{Binding Card.Name}">
                                        <Grid Height="78">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Width="48" Height="48" VerticalAlignment="Center">
                                                <Border CornerRadius="11" Background="{Binding Card.TileBrush}" Visibility="{Binding Card.InitialsVisibility}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="White" Text="{Binding Card.Initials}" />
                                                </Border>
                                                <Image Width="48" Height="48" Source="{Binding Card.Icon}" Stretch="Uniform" Visibility="{Binding Card.IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#FFF5F5F7" Text="{Binding Rank}" />
                                            <StackPanel Grid.Column="2" Margin="4,0,8,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{Binding Card.TitleBrush}" ToolTip="{Binding Card.FullName}" TextWrapping="Wrap"><Run Text="{Binding Card.Name, Mode=OneWay}" /><Run FontSize="12" FontWeight="Normal" Foreground="#FF8E8E93" Text="{Binding Card.EnglishSuffix, Mode=OneWay}" /></TextBlock>
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#FF98989D" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Style="{StaticResource StoreActionButtonStyle}" Tag="{Binding Card}" Click="StoreAction_Click" IsEnabled="{Binding Card.CanInteract}"
                                                    Visibility="{Binding Card.StoreButtonVisibility}" ToolTip="{Binding Card.RunToolTip}" Content="{Binding Card.StoreButtonText}"
                                                    AutomationProperties.Name="{Binding Card.StoreButtonText}" />
                                        </Grid>
                                    </Button>
                                    <ProgressBar Height="2" Margin="16,0,16,1" VerticalAlignment="Bottom" IsHitTestVisible="False" Minimum="0" Maximum="100"
                                                 IsIndeterminate="{Binding Card.IsIndeterminate}" Value="{Binding Card.ProgressValue, Mode=OneWay}" Visibility="{Binding Card.BusyVisibility}"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FF4AA3FF" />
                                </Grid>
                            </DataTemplate>

                            <!-- 즐겨찾기의 내 PC 프로그램 한 줄 -->
                            <DataTemplate DataType="{x:Type local:FavoriteCard}">
                                <Grid Margin="0,0,12,12">
                                    <Button Style="{StaticResource StoreRowStyle}" Tag="{Binding}" Click="FavoriteCard_Click" ToolTip="{Binding ToolTipText}" Opacity="{Binding CardOpacity}"
                                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="실행" Icon="&#xE768;" Tag="{Binding}" Click="FavoriteRunMenu_Click" />
                                            <MenuItem Header="편집…" Icon="&#xE70F;" Tag="{Binding}" Click="FavoriteEditMenu_Click" />
                                            <MenuItem Header="파일 위치 열기" Icon="&#xE838;" Tag="{Binding}" Click="FavoriteFolderMenu_Click" />
                                            <Separator />
                                            <MenuItem Header="삭제" Icon="&#xE74D;" Tag="{Binding}" Click="FavoriteDeleteMenu_Click" Style="{StaticResource DangerMenuItemStyle}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid Height="78">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Width="56" Height="56" VerticalAlignment="Center">
                                                <Border CornerRadius="13" Background="#FF2C2D32" Visibility="{Binding InitialsVisibility}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                                </Border>
                                                <Image Width="48" Height="48" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,8,8,8" VerticalAlignment="Center">
                                                <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="#FFF5F5F7" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#FF98989D" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Height="28" MinWidth="52" Padding="12,0" CornerRadius="14" VerticalAlignment="Center" Background="#FF2C2D32">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FF4AA3FF" Text="열기" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ScrollViewer.Resources>

                        <!-- 섹션: 제목 · 오른쪽 링크(모두 업데이트 등) · 줄 목록 (창 폭에 맞춰 1~4열) -->
                        <ItemsControl x:Name="SectionList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:StoreSection}">
                                    <StackPanel Margin="0,8,0,10">
                                        <Border BorderBrush="#FF38383A" BorderThickness="0,1,0,0" Padding="0,14,0,2" Visibility="{Binding HeaderVisibility}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="{Binding ActionText}" Tag="{Binding}" Click="SectionAction_Click"
                                                        Visibility="{Binding ActionVisibility}" IsEnabled="{Binding ActionEnabled}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Title}" />
                                                    <TextBlock Margin="8,0,0,2" VerticalAlignment="Bottom" FontSize="13" Foreground="#FF98989D" Text="{Binding Note}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Width="{Binding PanelWidth}" HorizontalAlignment="Left">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="460">
                        <TextBlock x:Name="EmptyStateTitle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyStateText" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="EmptyStateButton" Margin="0,14,0,0" Padding="14,7" HorizontalAlignment="Center" Click="EmptyStateButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Border x:Name="ErrorPanel" Grid.RowSpan="5" Padding="12,9,8,9" VerticalAlignment="Top" Panel.ZIndex="3" AutomationProperties.LiveSetting="Assertive" Background="#FF2A2418" BorderBrush="#FF6B5A33" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Path Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top" Data="M 7,1 L 13,12 L 1,12 Z M 7,4.3 L 7,8 M 7,10.2 L 7,10.3" Stroke="#FFF0CF8A" StrokeThickness="1.4" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#FFF3DDB0" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Width="30" Height="28" Margin="10,0,0,0" Padding="0" AutomationProperties.Name="알림 닫기" Click="DismissErrorButton_Click" Content="×" FontSize="18" Style="{StaticResource ChromeButtonStyle}" ToolTip="알림 닫기" />
                    </Grid>
                </Border>
            </Grid>

            <!-- API Manager · 설정: 앱 목록 대신 오른쪽 화면 전체 -->
            <!-- 앱 페이지 (카드를 누르면): 아이콘·이름·버튼, 정보 줄, 스크린샷, 설명, 새로운 기능. 뒤로·Esc·마우스 뒤로 단추로 목록 -->
            <Grid x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed">
                <ScrollViewer x:Name="DetailScrollViewer" Padding="30,16,22,28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
                        <Button x:Name="DetailBackButton" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="DetailBack_Click"
                                AutomationProperties.Name="뒤로" ToolTip="뒤로 (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="DetailBackText" Text="전체 앱" />
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="128" Height="128" VerticalAlignment="Top">
                                <Border CornerRadius="28" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="46" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                </Border>
                                <Image Width="128" Height="128" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="24,2,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="28" FontWeight="Bold" TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" /><Run FontSize="16" FontWeight="Normal" Foreground="#FF8E8E93" Text="{Binding EnglishSuffix, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF98989D" Text="{Binding App.Description}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource DetailActionButtonStyle}" Tag="{Binding}" Click="StoreAction_Click" IsEnabled="{Binding CanInteract}"
                                            Visibility="{Binding StoreButtonVisibility}" ToolTip="{Binding RunToolTip}" AutomationProperties.Name="{Binding StoreButtonText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StoreButtonGlyph}" Visibility="{Binding StoreButtonGlyphVisibility}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" Margin="0,1,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StoreButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DetailIconButtonStyle}" Tag="{Binding}" Click="FavoriteToggleMenu_Click" Content="{Binding FavoriteGlyph}"
                                            Foreground="{Binding FavoriteGlyphBrush}" ToolTip="{Binding FavoriteMenuHeader}" AutomationProperties.Name="{Binding FavoriteMenuHeader}" />
                                    <Button x:Name="DetailMoreButton" Style="{StaticResource DetailIconButtonStyle}" Tag="{Binding}" Content="&#xE712;"
                                            Click="DetailMore_Click" ToolTip="더 보기" AutomationProperties.Name="더 보기">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="업데이트" Icon="&#xE896;" Tag="{Binding}" Click="UpdateMenu_Click" Visibility="{Binding UpdateMenuVisibility}" />
                                                <MenuItem Header="다시 설치" Icon="&#xE72C;" Tag="{Binding}" Click="ReinstallMenu_Click" />
                                                <MenuItem Header="설치 폴더 열기" Icon="&#xE838;" Tag="{Binding}" Click="OpenFolderMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                                <MenuItem Header="저장소 열기" Icon="&#xE8A7;" Tag="{Binding}" Click="OpenRepositoryMenu_Click" />
                                                <Separator />
                                                <MenuItem Header="편집…" Icon="&#xE70F;" Tag="{Binding}" Click="EditMenu_Click" />
                                                <MenuItem Header="제거" Icon="&#xE74D;" Tag="{Binding}" Click="UninstallMenu_Click" Visibility="{Binding InstalledMenuVisibility}"
                                                          Style="{StaticResource DangerMenuItemStyle}" />
                                                <MenuItem Header="목록에서 삭제…" Icon="&#xE738;" Tag="{Binding}" Click="DeleteMenu_Click" Style="{StaticResource DangerMenuItemStyle}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Border Style="{StaticResource TagStyle}" Height="20" Margin="12,0,0,0" VerticalAlignment="Center" Background="#29E6C07A" Visibility="{Binding BetaVisibility}">
                                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#FFF0CF8A" Text="베타" />
                                    </Border>
                                    <Border Style="{StaticResource TagStyle}" Height="20" Margin="8,0,0,0" VerticalAlignment="Center" Background="#293DD68C" Visibility="{Binding NewVisibility}">
                                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#FF7FE2B0" Text="NEW" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,12,0,0" MaxWidth="360" HorizontalAlignment="Left" Visibility="{Binding BusyVisibility}">
                                    <TextBlock FontSize="12" Foreground="#FF98989D" Text="{Binding BusyText}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue, Mode=OneWay}"
                                                 Background="#FF2C2D32" BorderThickness="0" Foreground="#FF4AA3FF" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 정보 줄: 버전 · 출시 · 분류 · 크기 -->
                        <Border Margin="0,26,0,0" BorderBrush="#FF2E3036" BorderThickness="0,1,0,1" Padding="0,14">
                            <ItemsControl x:Name="DetailFacts" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#FF8E8E93" Text="{Binding Label}" />
                                            <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="17" FontWeight="Bold" Foreground="#FFE5E5EA" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="11" Foreground="#FF8E8E93" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- 스크린샷: 옆으로 넘김 (Shift+휠), 누르면 크게 -->
                        <StackPanel x:Name="DetailShotsSection" Margin="0,24,0,0" Visibility="Collapsed">
                            <TextBlock Text="미리 보기" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                            <ScrollViewer x:Name="DetailShotsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,10"
                                          PreviewMouseWheel="DetailShots_PreviewMouseWheel">
                                <ItemsControl x:Name="DetailShots" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource PlainButtonStyle}" Margin="0,0,14,0" Tag="{Binding Shot}" Click="Shot_Click" ToolTip="크게 보기">
                                                <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="12" BorderBrush="#26FFFFFF" BorderThickness="1">
                                                    <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" /></Border.Background>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- 설명 (앱 목록의 상세 설명) -->
                        <TextBlock x:Name="DetailDescription" Margin="0,24,0,0" FontSize="14" LineHeight="23" TextWrapping="Wrap" Foreground="#FFE5E5EA" Visibility="Collapsed" />

                        <!-- 새로운 기능 (최신 릴리스) -->
                        <StackPanel x:Name="DetailNewsSection" Margin="0,28,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock x:Name="DetailNewsWhen" DockPanel.Dock="Right" VerticalAlignment="Bottom" FontSize="12.5" Foreground="#FF8E8E93" />
                                <TextBlock Text="새로운 기능" FontSize="20" FontWeight="Bold" />
                            </DockPanel>
                            <TextBlock x:Name="DetailNewsVersion" Margin="0,4,0,0" FontSize="12.5" Foreground="#FF8E8E93" />
                            <TextBlock x:Name="DetailNews" Margin="0,10,0,0" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" Foreground="#FFD1D1D6" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 스크린샷 크게 보기 (누르거나 Esc 로 닫음) -->
                <Grid x:Name="ShotViewer" Background="#F2111113" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ShotViewer_MouseLeftButtonUp">
                    <Image x:Name="ShotViewerImage" Margin="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Grid>
            <ContentControl x:Name="PagePane" Grid.Column="1" Visibility="Collapsed" Focusable="False" />
        </Grid>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="2" Background="#FF19191B" BorderBrush="#FF2E3036" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CatalogSourceText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Cursor="Hand" MouseLeftButtonUp="CatalogSourceText_Click" ToolTip="앱 목록 위치 (클릭하면 열기)" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Opacity="0.75" IsHitTestVisible="False" Text="made by jy01.ahn" />
            </Grid>
        </Border>
    </Grid>
</Window>
