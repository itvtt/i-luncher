<Window x:Class="ILauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ILauncher"
        Title="i-luncher"
        Icon="Assets/ILauncher.ico"
        Foreground="#FFF5F7FB"
        FontFamily="Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="1100" Height="640" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LauncherResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RoundedToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
            <!-- 카드의 "업데이트" 표시와 같은 초록 -->
            <Style x:Key="UpdateAllButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF239B6A" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="#FF239B6A" BorderThickness="1" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#FF2BB07A" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFD7FFEA" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1D8058" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder" Property="Background" Value="#FF202635" />
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="#FF30394A" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 제목 표시줄 -->
        <Border Grid.Row="0" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="#FF202632" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="28" Height="28" Margin="0,0,10,0" Source="Assets/ILauncher.png" Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#FFE8ECF4" Text="i-luncher" />
                    <TextBlock x:Name="TitleVersionText" Margin="8,1,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" AutomationProperties.Name="최소화" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최소화">
                        <Path Width="12" Height="1" Data="M 0,0.5 L 12,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton" AutomationProperties.Name="최대화" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" ToolTip="최대화">
                        <Grid Width="13" Height="13">
                            <Path x:Name="MaximizeGlyph" Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph" Data="M 3.5,1.5 L 11.5,1.5 L 11.5,9.5 M 1.5,3.5 L 9.5,3.5 L 9.5,11.5 L 1.5,11.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" AutomationProperties.Name="닫기" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseChromeButtonStyle}" ToolTip="닫기">
                        <Path Width="12" Height="12" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <!-- 왼쪽: 보기와 분류 -->
            <Border Grid.Column="0" Background="#FF141821" BorderBrush="#FF252C39" BorderThickness="0,0,1,0">
                <Grid Margin="12,17,10,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="8,0,0,12" FontSize="12" FontWeight="SemiBold" Foreground="#FF8C96A8" Text="라이브러리" />
                    <Button x:Name="AllAppsButton" Grid.Row="1" Click="FilterButton_Click" Tag="all" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="전체 앱" /><TextBlock x:Name="AllCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Button x:Name="InstalledAppsButton" Grid.Row="2" Click="FilterButton_Click" Tag="installed" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="설치된 앱" /><TextBlock x:Name="InstalledCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Button x:Name="UpdatesButton" Grid.Row="3" Click="FilterButton_Click" Tag="updates" Style="{StaticResource SidebarNavButtonStyle}">
                        <Grid><TextBlock Text="업데이트" /><TextBlock x:Name="UpdatesCountText" HorizontalAlignment="Right" FontSize="11" Foreground="#FF8FD4A8" /></Grid>
                    </Button>
                    <!-- 즐겨찾기: 이 PC 의 일반 프로그램 -->
                    <Button x:Name="FavoritesButton" Grid.Row="4" Click="FilterButton_Click" Tag="favorites" Style="{StaticResource SidebarNavButtonStyle}"
                            ToolTip="이 PC 에 설치된 프로그램 바로 실행">
                        <Grid><TextBlock Text="즐겨찾기" /><TextBlock x:Name="FavoritesCountText" HorizontalAlignment="Right" FontSize="11" /></Grid>
                    </Button>
                    <Border Grid.Row="5" Height="1" Margin="8,10,8,12" Background="#FF2B3240" />
                    <TextBlock Grid.Row="6" Margin="8,0,0,8" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF697486" Text="분류" />
                    <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryButtons" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <!-- 검색과 도구 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Height="38" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="37" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 6.25,1.25 A 5,5 0 1 1 6.25,11.25 A 5,5 0 1 1 6.25,1.25 M 10,10 L 13.25,13.25" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.4" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="0,1,10,1" VerticalContentAlignment="Center" AutomationProperties.Name="앱 검색" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource TextBrush}" FontSize="13" Foreground="{StaticResource TextBrush}" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Grid.Column="1" Margin="2,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="앱 검색 (Ctrl+F)" Foreground="{StaticResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                        <Button x:Name="NoticeButton" Click="NoticeButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="공지" ToolTip="공지">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="공지" VerticalAlignment="Center" />
                                <Ellipse x:Name="NoticeUnreadDot" Width="6" Height="6" Margin="6,0,0,0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddAppButton" Click="AddAppButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="앱 추가" ToolTip="GitHub 저장소 주소로 앱 추가">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="11" Height="11" Margin="0,0,6,0" Data="M 5.5,0 L 5.5,11 M 0,5.5 L 11,5.5" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="AddAppText" Text="앱 추가" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Width="34" Padding="0" Click="SettingsButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="설정" ToolTip="설정">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="RefreshButton" Width="34" Padding="0" Click="RefreshButton_Click" Style="{StaticResource RoundedToolbarButtonStyle}" AutomationProperties.Name="새로고침" ToolTip="목록과 최신 버전 새로고침 (F5)">
                            <Path Width="16" Height="16" Stretch="Uniform" Data="M13,6 A5,5 0 1 0 14,9 M13,3 L13,6 L10,6" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 런처 업데이트 -->
                <Border x:Name="LauncherUpdateBanner" Grid.Row="1" Margin="0,12,0,0" Padding="12,8" Background="#FF1A2E27" BorderBrush="#FF3C6B58" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LauncherUpdateText" VerticalAlignment="Center" Foreground="#FFBFEBD5" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="LauncherUpdateButton" Grid.Column="1" Content="지금 업데이트" Margin="12,0,0,0" Padding="10,4" Click="LauncherUpdateButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                </Border>

                <!-- 공지 -->
                <Border x:Name="NoticeBanner" Grid.Row="2" Margin="0,12,0,0" Padding="12,8" Background="#FF1D2C41" BorderBrush="#FF385577" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="공지" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#FFAECFFF" FontWeight="SemiBold" />
                        <TextBlock x:Name="NoticeBannerTitle" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="보기" Margin="12,0,0,0" Padding="10,4" Click="NoticeBanner_Click" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="공지 보기" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SectionTitle" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="전체 앱" />
                    <Button x:Name="UpdateAllButton" Grid.Column="1" Height="28" Padding="12,0" Margin="0,0,12,0" Content="모두 업데이트" Click="UpdateAllButton_Click"
                            Style="{StaticResource UpdateAllButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="모두 업데이트" />
                    <TextBlock x:Name="CountText" Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>

                <Grid Grid.Row="4">
                    <ScrollViewer x:Name="CardScrollViewer" Padding="0,0,4,8" SizeChanged="CardScrollViewer_SizeChanged" ScrollChanged="CardScrollViewer_ScrollChanged" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <ItemsControl x:Name="LauncherItems">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type local:AppCard}">
                                    <Grid Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,16,18">
                                        <Button Style="{StaticResource PosterCardStyle}" BorderBrush="{Binding AccentBorderBrush}" Tag="{Binding}"
                                                Click="Card_Click" IsEnabled="{Binding CanInteract}" ToolTipService.ShowOnDisabled="True"
                                                ToolTip="{Binding RunToolTip}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="실행" Tag="{Binding}" Click="LaunchMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                                    <MenuItem Header="{Binding FavoriteMenuHeader}" Tag="{Binding}" Click="FavoriteToggleMenu_Click" />
                                                    <MenuItem Header="업데이트" Tag="{Binding}" Click="UpdateMenu_Click" Visibility="{Binding UpdateMenuVisibility}" />
                                                    <MenuItem Header="설치 / 다시 설치" Tag="{Binding}" Click="ReinstallMenu_Click" />
                                                    <MenuItem Header="제거" Tag="{Binding}" Click="UninstallMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                                    <Separator />
                                                    <MenuItem Header="편집…" Tag="{Binding}" Click="EditMenu_Click" />
                                                    <MenuItem Header="목록에서 삭제…" Tag="{Binding}" Click="DeleteMenu_Click" />
                                                    <Separator />
                                                    <MenuItem Header="저장소 열기" Tag="{Binding}" Click="OpenRepositoryMenu_Click" />
                                                    <MenuItem Header="릴리스 노트 보기" Tag="{Binding}" Click="OpenReleaseMenu_Click" Visibility="{Binding ReleaseMenuVisibility}" />
                                                    <MenuItem Header="설치 폴더 열기" Tag="{Binding}" Click="OpenFolderMenu_Click" Visibility="{Binding InstalledMenuVisibility}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <!-- 오로라 글로우: 아이콘 뒤로 퍼지는 앱 색 빛 -->
                                                <Border CornerRadius="19" Background="{Binding AccentGlowBrush}" IsHitTestVisible="False" />
                                                <Grid Margin="14,12,14,14">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <!-- 맨 위: 카테고리 · 베타 · NEW (왼쪽), 즐겨찾기 ★ (오른쪽) -->
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFF0CF8A" Text="&#xE735;"
                                                                   Visibility="{Binding FavoriteVisibility}" ToolTip="즐겨찾기" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource GlassChipStyle}" MaxWidth="110">
                                                                <TextBlock VerticalAlignment="Center" FontSize="10.5" Foreground="#FFD3DBE8" Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <Border Style="{StaticResource GlassChipStyle}" Margin="4,0,0,0" Background="#2EE6C07A" BorderBrush="#40E6C07A" Visibility="{Binding BetaVisibility}" AutomationProperties.Name="베타">
                                                                <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#FFF0CF8A" Text="베타" />
                                                            </Border>
                                                            <Border Style="{StaticResource GlassChipStyle}" Margin="4,0,0,0" Background="#2E3DD68C" BorderBrush="#403DD68C" Visibility="{Binding NewVisibility}" AutomationProperties.Name="새 앱">
                                                                <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FF5FE3A1" Text="NEW" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- 가운데: 큰 아이콘 (없으면 이름 색 타일과 머리글자) -->
                                                    <Grid Grid.Row="1" Width="92" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border CornerRadius="24" Background="{Binding TileBrush}" Visibility="{Binding InitialsVisibility}">
                                                            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#FF000000" /></Border.Effect>
                                                        </Border>
                                                        <Border CornerRadius="24" Visibility="{Binding InitialsVisibility}" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Offset="0" Color="#33FFFFFF" /><GradientStop Offset="0.5" Color="#00FFFFFF" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}">
                                                            <TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#FF000000" /></TextBlock.Effect>
                                                        </TextBlock>
                                                        <Image Width="88" Height="88" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#FF000000" /></Image.Effect>
                                                        </Image>
                                                    </Grid>

                                                    <!-- 아래: 이름 · 설명, 오른쪽 아래 버전과 동작 아이콘 (업데이트 = 초록 ↑, 받기 = 파랑 ↓, 빛남) -->
                                                    <StackPanel Grid.Row="2">
                                                        <TextBlock FontSize="17" FontWeight="Bold" Foreground="{Binding TitleBrush}" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" Height="32" FontSize="11.5" LineHeight="16" Foreground="#FFA7B2C4" Text="{Binding DescriptionText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                        <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                            <Border Style="{StaticResource GlassChipStyle}" Background="{Binding VersionBadgeBackground}" Visibility="{Binding VersionVisibility}" IsHitTestVisible="True" ToolTip="{Binding VersionToolTip}">
                                                                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Medium" Foreground="{Binding VersionBrush}" Text="{Binding VersionText}" />
                                                            </Border>
                                                            <Border Width="22" Height="22" Margin="6,0,0,0" CornerRadius="11" Background="{Binding ActionBackground}" Visibility="{Binding ActionVisibility}"
                                                                    ToolTip="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}">
                                                                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.8" Color="{Binding ActionGlowColor}" /></Border.Effect>
                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding ActionGlyph}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <ProgressBar Height="3" Margin="20,0,20,8" VerticalAlignment="Bottom" IsHitTestVisible="False" Minimum="0" Maximum="100"
                                                     IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue, Mode=OneWay}" Visibility="{Binding BusyVisibility}"
                                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                                <!-- 즐겨찾기의 내 PC 프로그램: 같은 타일 모양 (누르면 실행, 우클릭으로 편집·삭제) -->
                                <DataTemplate DataType="{x:Type local:FavoriteCard}">
                                    <Button Style="{StaticResource PosterCardStyle}" BorderBrush="{Binding AccentBorderBrush}" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,16,18"
                                            Tag="{Binding}" Click="FavoriteCard_Click" ToolTip="{Binding ToolTipText}" Opacity="{Binding CardOpacity}"
                                            AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="실행" Tag="{Binding}" Click="FavoriteRunMenu_Click" />
                                                <MenuItem Header="편집…" Tag="{Binding}" Click="FavoriteEditMenu_Click" />
                                                <MenuItem Header="파일 위치 열기" Tag="{Binding}" Click="FavoriteFolderMenu_Click" />
                                                <Separator />
                                                <MenuItem Header="삭제" Tag="{Binding}" Click="FavoriteDeleteMenu_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Border CornerRadius="19" Background="{Binding AccentGlowBrush}" IsHitTestVisible="False" />
                                            <Grid Margin="14,12,14,14">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Border Style="{StaticResource GlassChipStyle}" HorizontalAlignment="Left">
                                                    <TextBlock VerticalAlignment="Center" FontSize="10.5" Foreground="#FFD3DBE8" Text="내 PC" />
                                                </Border>
                                                <Grid Grid.Row="1" Width="92" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border CornerRadius="24" Background="#FF2B3546" Visibility="{Binding InitialsVisibility}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                                    </Border>
                                                    <Image Width="76" Height="76" Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#FF000000" /></Image.Effect>
                                                    </Image>
                                                </Grid>
                                                <StackPanel Grid.Row="2">
                                                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="#FFF5F7FB" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,3,0,0" Height="32" FontSize="11" LineHeight="16" Foreground="#FFA7B2C4" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    <Border Height="22" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="460">
                        <TextBlock x:Name="EmptyStateTitle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptyStateText" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="EmptyStateButton" Margin="0,14,0,0" Padding="14,7" HorizontalAlignment="Center" Click="EmptyStateButton_Click" Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Border x:Name="ErrorPanel" Grid.RowSpan="5" Padding="12,9,8,9" VerticalAlignment="Top" Panel.ZIndex="3" AutomationProperties.LiveSetting="Assertive" Background="#FF2A2418" BorderBrush="#FF6B5A33" BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Path Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top" Data="M 7,1 L 13,12 L 1,12 Z M 7,4.3 L 7,8 M 7,10.2 L 7,10.3" Stroke="#FFF0CF8A" StrokeThickness="1.4" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#FFF3DDB0" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Width="30" Height="28" Margin="10,0,0,0" Padding="0" AutomationProperties.Name="알림 닫기" Click="DismissErrorButton_Click" Content="×" FontSize="18" Style="{StaticResource ChromeButtonStyle}" ToolTip="알림 닫기" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="2" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="#FF202632" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CatalogSourceText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Cursor="Hand" MouseLeftButtonUp="CatalogSourceText_Click" ToolTip="앱 목록 위치 (클릭하면 열기)" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
