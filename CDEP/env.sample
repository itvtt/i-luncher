# API 서버를 컨테이너 · 배포 환경(C-DEP 등)에서 돌릴 때 넣는 환경 변수 (relay.py 맨 위 SETTINGS 와 같은 이름).
# 실제 값은 배포 환경의 설정 · 비밀 값(Secret)에 넣습니다. 이 파일을 복사해 값을 채운 파일은 저장소에 올리지 않습니다(.env 는 .gitignore).
# 순서: relay.py SETTINGS < 환경 변수 < --set. 비워 둔 키는 SETTINGS 기본값을 씁니다.

# ── 받을 주소 · 포트 (Dockerfile 기본값) ──
RELAY_BIND=0.0.0.0
RELAY_PORT=2003
# 앱 · 런처가 이 서버를 부르는 주소 (알림 링크에 씀). 예: https://<배포 주소>
RELAY_PUBLIC_URL=

# ── 데이터: 앱 목록 · 스크린샷 · 공지 · 스킬 · 보고서 · 백업 (영구 저장소를 이 경로에 연결) ──
RELAY_DATA_ROOT=/data

# ── 비밀 값 (Secret 으로) ──
# 관리자 메뉴(앱 목록 · 공지 · 릴리스) 비밀번호. 비우면 누구나 고칠 수 있으므로 꼭 넣습니다.
RELAY_ADMIN_PASSWORD=
# 앱 키 (Terminal Notes 의 RELAY_INGEST_KEY 와 같게, 쓰지 않으면 비움)
RELAY_INGEST_KEY=
# GitHub Enterprise 읽기 전용 토큰 (비공개 · internal 저장소의 릴리스 중계 /api/v3, 스킬 링크)
RELAY_GITHUB_TOKEN=

# ── GitHub Enterprise ──
# 예: https://<Enterprise 호스트>/api/v3 (비우면 github.com)
RELAY_GITHUB_API=
# GitHub 중계로 열어 줄 저장소 (쉼표, 소유자/저장소 또는 소유자/*). 앱 목록의 저장소는 자동으로 열림
LAUNCHER_GITHUB_REPOS=

# ── 계정 ──
# 마스터 계정 (쉼표, 런처 빌드 설정 MASTER_USERS 와 같게)
MASTER_USERS=

# ── EQ Status 설비 상태 API 는 이 서버에서 하지 않음 (EQ Status 는 따로 둔 설비 API 서버를 씀) ──
EQUIPMENT_DB_HOST=

# ── 그 밖 (필요할 때만) ──
# RELAY_LOG_FILE=relay.log
# RELAY_BACKUP_KEEP=30
# RELAY_REPORT_RETENTION_DAYS=90
# RELAY_WEBHOOK_URL=
# HTTPS 를 이 서버가 직접 할 때만 (보통은 배포 환경의 게이트웨이가 함)
# RELAY_TLS_CERT=
# RELAY_TLS_KEY=
