<UserControl x:Class="IApi.Manager.ManagerView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <!-- i-api 관리 창의 화면: 서버 · API · 앱 목록 · 릴리스 · 러너 · 공지 · 스킬 -->
    <UserControl.Resources>
        <ResourceDictionary Source="ManagerResources.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 머리 줄: 제목, 포트 · [실행] (설정 파일 · 로그인 자동 실행 · 방화벽 · 시작), 서버 상태, ⋯ (다시 시작 · 멈추기 · 업데이트 · 파일), 새로 고침 -->
        <DockPanel Margin="30,20,22,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="포트" Style="{StaticResource HintStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="PortBox" Width="86" MaxLength="5" Tag="예: 2003" VerticalAlignment="Center" AutomationProperties.Name="포트" KeyDown="PortBox_KeyDown" />
                <Button x:Name="PortButton" Content="실행" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,14,0" VerticalAlignment="Center" Click="PortButton_Click" />
                <Border Height="32" Padding="12,0" CornerRadius="16" Background="{StaticResource RaisedSurfaceBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="확인 중…" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock x:Name="AddressText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="MoreButton" Style="{StaticResource RoundIconButtonStyle}" Content="&#xE712;" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="더 보기" AutomationProperties.Name="더 보기" Click="MoreButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RestartItem" Header="다시 시작" Click="RestartButton_Click" />
                            <MenuItem x:Name="StopItem" Header="멈추기" Click="StopButton_Click" />
                            <MenuItem x:Name="UpdateItem" Header="업데이트" Click="UpdateButton_Click" />
                            <Separator />
                            <MenuItem Header="설정 파일 열기" Click="SettingsFileButton_Click" />
                            <MenuItem Header="로그 열기" Click="LogButton_Click" />
                            <MenuItem Header="데이터 폴더 열기" Click="DataFolderButton_Click" />
                            <MenuItem Header="브라우저로 열기" Click="BrowserButton_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RefreshButton" Style="{StaticResource RoundIconButtonStyle}" Content="&#xE72C;" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="새로 고침 (F5)" AutomationProperties.Name="새로 고침" Click="RefreshButton_Click" />
            </StackPanel>
            <TextBlock x:Name="HeaderText" Text="API 서버 i-api" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" />
        </DockPanel>

        <!-- 화면 고르기 -->
        <ListBox x:Name="Nav" Grid.Row="1" Margin="30,16,22,0" Style="{StaticResource TabStripStyle}" ItemContainerStyle="{StaticResource TabItemStyle}"
                 SelectionChanged="Nav_SelectionChanged">
            <ListBoxItem Content="API" Tag="Functions" IsSelected="True" />
            <ListBoxItem Content="앱 목록" Tag="Apps" />
            <!-- 릴리스 · 러너 · 스킬: API 서버 관리가 아니라 숨김 (사용자 결정 2026-11-25) -->
            <ListBoxItem Content="릴리스" Tag="Releases" Visibility="Collapsed" />
            <ListBoxItem Content="러너" Tag="Runners" Visibility="Collapsed" />
            <ListBoxItem Content="공지" Tag="Notices" />
            <ListBoxItem Content="스킬" Tag="Skills" Visibility="Collapsed" />
        </ListBox>

        <Grid Grid.Row="2" Margin="30,18,22,16">
            <!-- API: 서버의 API 마다 켜고 끄기, 호출 · 실패 · 걸린 시간 (서버 3.0 이상) -->
            <Grid x:Name="FunctionsSection">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button x:Name="AddFunctionButton" DockPanel.Dock="Right" Content="+ API 추가" Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                            Click="AddFunctionButton_Click" />
                    <TextBlock x:Name="FunctionsSummaryText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,0,26,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="72" /><ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="API" Style="{StaticResource HintStyle}" />
                            <TextBlock Grid.Column="2" Text="오늘" Style="{StaticResource HintStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="30일" Style="{StaticResource HintStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="실패" Style="{StaticResource HintStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <ListBox x:Name="FunctionsList" Grid.Row="1" SelectionChanged="FunctionsList_SelectionChanged">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="10,12,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="72" /><ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding On, Mode=OneWay}" IsEnabled="{Binding Switchable}" Tag="{Binding}"
                                                  HorizontalAlignment="Left" Click="FunctionSwitch_Click" AutomationProperties.Name="{Binding Title}" />
                                        <StackPanel Grid.Column="1" Opacity="{Binding RowOpacity}">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Route}" Style="{StaticResource HintStyle}" FontFamily="Consolas, Malgun Gothic" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TodayText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding PeriodText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource LabelTextBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding FailuresText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{Binding FailuresBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 고른 API (사용자 API 면 편집 · 삭제), 또는 편집 칸 -->
                    <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
                        <Grid>
                        <StackPanel x:Name="FunctionDetail" Visibility="Collapsed">
                            <TextBlock x:Name="FunctionTitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="FunctionRouteText" Style="{StaticResource HintStyle}" FontFamily="Consolas, Malgun Gothic" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock x:Name="FunctionDescriptionText" FontSize="12.5" Foreground="{StaticResource LabelTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock x:Name="FunctionStateText" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <StackPanel x:Name="CustomActions" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                <Button Content="편집" Click="EditFunctionButton_Click" />
                                <Button Content="삭제" Click="DeleteFunctionButton_Click" />
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,16,0,0">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="10,8">
                                    <StackPanel><TextBlock Text="오늘" Style="{StaticResource HintStyle}" /><TextBlock x:Name="FunctionTodayText" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="10,8">
                                    <StackPanel><TextBlock Text="30일" Style="{StaticResource HintStyle}" /><TextBlock x:Name="FunctionPeriodText" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10,8">
                                    <StackPanel><TextBlock Text="평균" Style="{StaticResource HintStyle}" /><TextBlock x:Name="FunctionAverageText" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                            </UniformGrid>
                            <!-- 최근 30일 호출 (실패는 노랑) -->
                            <ItemsControl x:Name="FunctionBars" Height="64" Margin="0,16,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="1,0" Background="Transparent" ToolTip="{Binding Tip}">
                                            <Border Height="{Binding CallsHeight}" VerticalAlignment="Bottom" CornerRadius="2" Background="{StaticResource AccentBrush}" Opacity="0.75" />
                                            <Border Height="{Binding FailuresHeight}" VerticalAlignment="Bottom" CornerRadius="2" Background="{StaticResource WarnBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="FunctionBarsText" Style="{StaticResource HintStyle}" Margin="0,4,0,0" />
                            <TextBlock x:Name="FunctionLastText" FontSize="12.5" Foreground="{StaticResource LabelTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <TextBlock x:Name="FunctionFailureText" FontSize="12.5" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                        <!-- 사용자 API 편집: 저장하면 바로 동작 -->
                        <StackPanel x:Name="FunctionEditor" Visibility="Collapsed">
                            <TextBlock x:Name="EditorTitleText" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="이름" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="EditorNameBox" Tag="예: 설비 목록" TextChanged="Editor_Changed" />
                            <TextBlock Text="설명" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="EditorDescriptionBox" Tag="(선택)" TextChanged="Editor_Changed" />
                            <TextBlock Text="방법 · 주소" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EditorGet" Content="GET" GroupName="EditorMethod" IsChecked="True" Checked="Editor_Changed" />
                                <RadioButton x:Name="EditorPost" Content="POST" GroupName="EditorMethod" Checked="Editor_Changed" />
                                <RadioButton x:Name="EditorPut" Content="PUT" GroupName="EditorMethod" Checked="Editor_Changed" />
                                <RadioButton x:Name="EditorDelete" Content="DELETE" GroupName="EditorMethod" Checked="Editor_Changed" />
                            </StackPanel>
                            <TextBox x:Name="EditorPathBox" Margin="0,8,0,0" Tag="/hello/{name}" FontFamily="Consolas, Malgun Gothic" TextChanged="Editor_Changed" />
                            <TextBlock Text="부를 수 있는 사람" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EditorOpen" Content="누구나" GroupName="EditorAccess" IsChecked="True" Checked="Editor_Changed" />
                                <RadioButton x:Name="EditorKey" Content="앱 키" GroupName="EditorAccess" Checked="Editor_Changed" />
                                <RadioButton x:Name="EditorAdmin" Content="관리자" GroupName="EditorAccess" Checked="Editor_Changed" />
                            </StackPanel>
                            <TextBlock Text="종류" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EditorText" Content="고정 응답" GroupName="EditorKind" IsChecked="True" Checked="EditorKind_Checked" />
                                <RadioButton x:Name="EditorScript" Content="PowerShell" GroupName="EditorKind" Checked="EditorKind_Checked" />
                                <RadioButton x:Name="EditorForward" Content="다른 주소로 전달" GroupName="EditorKind" Checked="EditorKind_Checked" />
                            </StackPanel>
                            <TextBlock x:Name="EditorBodyHint" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="0,10,0,6" />
                            <TextBox x:Name="EditorBodyBox" Style="{StaticResource DocumentBoxStyle}" Height="170" TextChanged="Editor_Changed" />
                            <DockPanel Margin="0,14,0,0">
                                <Button x:Name="EditorDeleteButton" DockPanel.Dock="Right" Content="삭제" Style="{StaticResource LinkButtonStyle}" Click="DeleteFunctionButton_Click" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="EditorSaveButton" Content="저장" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="SaveFunctionButton_Click" />
                                    <Button Content="취소" Click="CancelEditButton_Click" />
                                </StackPanel>
                            </DockPanel>
                            <!-- 시험 호출: 저장한 것을 이 서버에 그대로 부름 -->
                            <TextBlock Text="시험" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="부르기" Margin="8,0,0,0" Click="TryFunctionButton_Click" />
                                <TextBox x:Name="TryPathBox" FontFamily="Consolas, Malgun Gothic" Tag="/hello/test" />
                            </DockPanel>
                            <TextBox x:Name="TryBodyBox" Margin="0,8,0,0" Style="{StaticResource DocumentBoxStyle}" Height="64" Tag="보낼 본문 (POST · PUT, 선택)" />
                            <TextBlock x:Name="TryResultText" Style="{StaticResource HintStyle}" Margin="0,10,0,4" />
                            <TextBox x:Name="TryResultBox" Style="{StaticResource DocumentBoxStyle}" Height="110" IsReadOnly="True" Visibility="Collapsed" />
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 앱 목록 (i-luncher) -->
            <Grid x:Name="AppsSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button x:Name="SaveAppsButton" DockPanel.Dock="Right" Content="저장" Style="{StaticResource PrimaryButtonStyle}" Margin="0" IsEnabled="False"
                            Click="SaveAppsButton_Click" VerticalAlignment="Center" />
                    <TextBlock Text="마스터 계정의 i-luncher에 기본 목록과 함께 이 순서대로 보입니다." Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="AppsList" SelectionChanged="AppsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource HintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="앱 추가" AutomationProperties.Name="앱 추가" Click="AddAppButton_Click" />
                            <Button x:Name="RemoveAppButton" Style="{StaticResource IconButtonStyle}" Content="&#xE738;" ToolTip="목록에서 빼기" AutomationProperties.Name="목록에서 빼기" Click="RemoveAppButton_Click" />
                            <Button x:Name="MoveUpButton" Style="{StaticResource IconButtonStyle}" Content="&#xE74A;" ToolTip="위로" AutomationProperties.Name="위로" Click="MoveUpButton_Click" />
                            <Button x:Name="MoveDownButton" Style="{StaticResource IconButtonStyle}" Content="&#xE74B;" ToolTip="아래로" AutomationProperties.Name="아래로" Click="MoveDownButton_Click" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Column="1" Margin="22,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AppForm" IsEnabled="False" MaxWidth="560" HorizontalAlignment="Left" Width="Auto" MinWidth="320" PreviewKeyDown="AppForm_PreviewKeyDown">
                            <TextBlock Text="이름" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                            <TextBox x:Name="AppNameBox" TextChanged="AppField_TextChanged" />
                            <!-- 분류: 직접 쓰거나 아래 지금 있는 분류를 눌러 고름 (런처 왼쪽 분류 · 카드 섹션) -->
                            <TextBlock Text="분류" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="AppCategoryBox" Tag="예: 개발" TextChanged="AppField_TextChanged" ToolTip="i-luncher 왼쪽 분류와 카드 섹션 이름. 비우면 기타" />
                            <WrapPanel x:Name="CategoryChips" Margin="0,2,0,0" />
                            <TextBlock Text="GitHub 저장소" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="AppRepositoryBox" Tag="https://github.com/소유자/저장소" TextChanged="AppField_TextChanged" />
                            <TextBlock Text="설명" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="AppDescriptionBox" TextChanged="AppField_TextChanged" />
                            <TextBlock Text="제작자" Style="{StaticResource FieldLabelStyle}" ToolTip="i-luncher 앱 페이지의 정보 줄 (비우면 안 보임)" />
                            <TextBox x:Name="AppAuthorBox" TextChanged="AppField_TextChanged" />
                            <TextBlock Text="상세 설명" Style="{StaticResource FieldLabelStyle}" ToolTip="i-luncher 앱 페이지의 긴 설명" />
                            <TextBox x:Name="AppDetailsBox" Style="{StaticResource DocumentBoxStyle}" Height="110" FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
                                     TextChanged="AppField_TextChanged" />
                            <!-- 앱 페이지 스크린샷: + (파일) 또는 이미지를 복사해 Ctrl+V. 이 순서대로 보임 -->
                            <DockPanel Margin="0,10,0,4">
                                <Button x:Name="AddScreenshotButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Height="26" Width="30"
                                        ToolTip="스크린샷 추가 (PNG·JPG, 이미지를 복사해 Ctrl+V 도 됨)" AutomationProperties.Name="스크린샷 추가" Click="AddScreenshotButton_Click" />
                                <TextBlock Text="스크린샷" Style="{StaticResource FieldLabelStyle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl x:Name="ScreenshotStrip" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="132" Height="82" Margin="0,0,8,8" ToolTip="{Binding Name}">
                                            <Border CornerRadius="7" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                                                <Border CornerRadius="6">
                                                    <Border.Background><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" /></Border.Background>
                                                </Border>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0">
                                                <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="22" Background="#CC1C1C1E" FontSize="10" Content="&#xE76B;" Tag="{Binding Name}"
                                                        ToolTip="앞으로" AutomationProperties.Name="앞으로" Click="MoveScreenshotButton_Click" />
                                                <Button Style="{StaticResource IconButtonStyle}" Width="24" Height="22" Margin="3,0,0,0" Background="#CC1C1C1E" FontSize="10" Content="&#xE711;"
                                                        Tag="{Binding Name}" ToolTip="빼기" AutomationProperties.Name="스크린샷 빼기" Click="RemoveScreenshotButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="id" Style="{StaticResource FieldLabelStyle}" ToolTip="영문 소문자·숫자·-, 앱마다 다르게 (설치 기록이 이 id를 따름)" />
                                    <TextBox x:Name="AppIdBox" Tag="예: my-app" TextChanged="AppField_TextChanged"
                                             ToolTip="영문 소문자·숫자·-, 앱마다 다르게 (설치 기록이 이 id를 따름)" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="설치 폴더 이름" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="AppInstallNameBox" TextChanged="AppField_TextChanged"
                                             ToolTip="%LOCALAPPDATA%\Programs\&lt;이름&gt;. 앱의 update.json InstallName 과 같아야 스스로 업데이트하고, 릴리스 파일은 &lt;이름&gt;-win-x64.zip" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="설치 방식" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AppKindZip" Content="zip 풀기" GroupName="AppKind" Checked="AppKind_Checked" />
                                <RadioButton x:Name="AppKindSetup" Content="설치 프로그램" GroupName="AppKind" Checked="AppKind_Checked" />
                            </StackPanel>
                            <CheckBox x:Name="AppMasterOnlyBox" Content="마스터 계정에만 보이기" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}"
                                      ToolTip="런처의 MASTER_USERS(.env)에 있는 계정에만 i-luncher에 보입니다"
                                      Checked="AppMasterOnly_Changed" Unchecked="AppMasterOnly_Changed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 릴리스: 프로젝트마다 다음 버전이 들어가 있고, 고쳐서 릴리스 (저장소의 release.yml 실행) -->
            <Grid x:Name="ReleasesSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="새 버전에는 다음 번호가 들어가 있습니다. 고쳐서 릴리스할 수 있습니다." Style="{StaticResource HintStyle}" />
                <Grid Grid.Row="1" Margin="14,14,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="96" /><ColumnDefinition Width="118" /><ColumnDefinition Width="84" /><ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="앱" Style="{StaticResource HintStyle}" />
                    <TextBlock Grid.Column="1" Text="현재" Style="{StaticResource HintStyle}" />
                    <TextBlock Grid.Column="2" Text="새 버전" Style="{StaticResource HintStyle}" />
                    <TextBlock Grid.Column="4" Text="최근 실행" Style="{StaticResource HintStyle}" Margin="10,0,0,0" />
                </Grid>
                <ListBox x:Name="ReleasesList" Grid.Row="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Tip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="96" /><ColumnDefinition Width="118" /><ColumnDefinition Width="84" /><ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Latest}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsVersionFixed}"
                                         Margin="0,0,8,0" Padding="8,4" AutomationProperties.Name="새 버전" />
                                <Button Grid.Column="3" Content="릴리스" IsEnabled="{Binding CanRelease}" Click="ReleaseButton_Click" Margin="0" MinWidth="0" Padding="10,5" />
                                <Button Grid.Column="4" Style="{StaticResource LinkButtonStyle}" Foreground="{Binding StatusBrush}"
                                        Cursor="{Binding StatusCursor}" ToolTip="{Binding StatusTip}" Click="ReleaseStatusButton_Click"
                                        HorizontalAlignment="Left" Margin="2,0,0,0" MaxWidth="188">
                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 러너: 이 PC의 GitHub Actions 러너 (추가·.env 편집·시작·멈추기·삭제), 로그온 작업 하나가 켜 둔 러너를 시작 -->
            <Grid x:Name="RunnersSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="RunnerTaskBar" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="RunnerTaskText" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                    <Button x:Name="RunnerTaskButton" Content="정리" Style="{StaticResource LinkButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center"
                            ToolTip="로그온 작업을 GitHub Runners 하나로" Click="RunnerTaskButton_Click" />
                </StackPanel>
                <TextBlock x:Name="RunnersMessageText" Grid.Row="1" Style="{StaticResource HintStyle}" Visibility="Collapsed" />
                <Grid x:Name="RunnersBody" Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="RunnersList" SelectionChanged="RunnersList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" Margin="1,0,11,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource HintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AddRunnerButton" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="러너 추가" AutomationProperties.Name="러너 추가"
                                    Click="AddRunnerButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 고른 러너 -->
                    <ScrollViewer x:Name="RunnerDetail" Grid.Column="1" Margin="22,0,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left" MinWidth="340">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" ToolTip="러너 삭제" AutomationProperties.Name="러너 삭제"
                                        Click="DeleteRunnerButton_Click" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="StartRunnerButton" Content="시작" Click="StartRunnerButton_Click" />
                                    <Button x:Name="StopRunnerButton" Content="멈추기" Click="StopRunnerButton_Click" />
                                    <Button x:Name="RestartRunnerButton" Content="다시 시작" Click="RestartRunnerButton_Click" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Ellipse x:Name="RunnerStateDot" Width="9" Height="9" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RunnerStateText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="RunnerGitHubText" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" Margin="12,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="저장소" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                <Button x:Name="RunnerRepositoryLink" Grid.Column="1" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,3"
                                        ToolTip="GitHub에서 열기" Click="RunnerRepositoryLink_Click" />
                                <TextBlock Grid.Row="1" Text="이름" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RunnerNameText" Grid.Row="1" Grid.Column="1" FontSize="12.5" Margin="0,5" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="폴더" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                <Button x:Name="RunnerFolderLink" Grid.Row="2" Grid.Column="1" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,3"
                                        ToolTip="폴더 열기" Click="RunnerFolderLink_Click" />
                            </Grid>
                            <DockPanel Margin="0,18,0,6">
                                <Button x:Name="SaveRunnerEnvButton" DockPanel.Dock="Right" Content="저장" Style="{StaticResource PrimaryButtonStyle}" Margin="0" IsEnabled="False"
                                        Click="SaveRunnerEnvButton_Click" VerticalAlignment="Bottom" />
                                <TextBlock Text=".env" Style="{StaticResource SubheadingStyle}" Margin="0" VerticalAlignment="Bottom"
                                           ToolTip="러너가 작업에 넘기는 환경 변수 (이름=값). 저장하면 쉬는 러너는 다시 시작" />
                            </DockPanel>
                            <TextBox x:Name="RunnerEnvBox" Style="{StaticResource DocumentBoxStyle}" Height="150" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                     Tag="이름=값" TextChanged="RunnerEnvBox_TextChanged" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 새 러너 -->
                    <ScrollViewer x:Name="RunnerAddForm" Grid.Column="1" Margin="22,0,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left" MinWidth="340">
                            <TextBlock Text="저장소" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                            <DockPanel>
                                <Button x:Name="RunnerRepositoryMenuButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE70D;" Margin="6,0,0,0"
                                        ToolTip="앱 목록의 저장소" AutomationProperties.Name="저장소 고르기" Click="RunnerRepositoryMenuButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="RunnerRepositoryMenu" />
                                    </Button.ContextMenu>
                                </Button>
                                <TextBox x:Name="NewRunnerRepositoryBox" Tag="소유자/저장소" LostKeyboardFocus="NewRunnerRepositoryBox_LostKeyboardFocus"
                                         KeyDown="NewRunnerRepositoryBox_KeyDown" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="폴더" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="NewRunnerFolderBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="러너 이름" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="NewRunnerNameBox" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text=".env" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="NewRunnerEnvBox" Style="{StaticResource DocumentBoxStyle}" Height="120" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                     Tag="이름=값" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="RegisterRunnerButton" Content="등록" Style="{StaticResource PrimaryButtonStyle}" Click="RegisterRunnerButton_Click" />
                                <Button Content="취소" Click="CancelRunnerButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 공지: Terminal Notes 의 공지 (i-luncher 공지는 GitHub 공지 저장소에서 고침) -->
            <Grid x:Name="NoticesSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="HistoryButton" Content="이전 공지" Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0" Click="HistoryButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="HistoryMenu" />
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="SaveNoticeButton" Content="저장" Style="{StaticResource PrimaryButtonStyle}" Margin="0" IsEnabled="False" Click="SaveNoticeButton_Click" />
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="NoticeInfoText" Grid.Row="1" Style="{StaticResource HintStyle}" Margin="0,10,0,0" />
                <TextBox x:Name="AnnouncementBox" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource DocumentBoxStyle}" Tag="공지 내용" TextChanged="AnnouncementBox_TextChanged" />
            </Grid>

            <!-- 스킬 -->
            <Grid x:Name="SkillsSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="SkillsList" SelectionChanged="SkillsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource HintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid x:Name="SkillDetail" Grid.Column="1" Margin="18,0,0,0" IsEnabled="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" ToolTip="스토어에서 삭제 (30일 동안 skills\.trash에 보관)"
                                    AutomationProperties.Name="스토어에서 삭제" Click="DeleteSkillButton_Click" VerticalAlignment="Center" />
                            <TextBlock x:Name="SkillHeaderText" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox x:Name="SkillContentBox" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DocumentBoxStyle}" IsReadOnly="True" />
                        <DockPanel Grid.Row="2" Margin="0,14,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="보기" Style="{StaticResource LinkButtonStyle}" Click="ShowSkillVersionButton_Click" ToolTip="고른 버전의 내용을 위에 보여 줌" />
                                <Button Content="이 버전으로 되돌리기" Style="{StaticResource LinkButtonStyle}" Click="RestoreSkillButton_Click"
                                        ToolTip="고른 버전의 내용을 새 최신 버전으로 올림" />
                            </StackPanel>
                            <TextBlock Text="버전" Style="{StaticResource SubheadingStyle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox x:Name="SkillVersionsList" Grid.Row="3" MinHeight="70" MouseDoubleClick="ShowSkillVersionButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 아래: 결과·오류 (있을 때만, 누르면 닫힘) -->
        <Border x:Name="MessageBar" Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="30,8" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="MessageBar_MouseLeftButtonUp">
            <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
