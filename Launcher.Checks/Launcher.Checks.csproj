<Project Sdk="Microsoft.NET.Sdk">
  <!-- 런처 핵심 동작 확인 (NuGet 없이 실행: dotnet run, project Launcher.Checks).
       실제 GitHub·실제 설치 폴더·실제 "앱" 목록은 건드리지 않음: 가짜 HTTP 처리기와 임시 폴더, 테스트용 레지스트리 키를 씀 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Launcher\i-luncher.csproj" />
  </ItemGroup>
</Project>
