<Window x:Class="ApiManager.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Manager" Width="1120" Height="740" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" Icon="Assets/ApiManager.ico" Style="{DynamicResource WindowStyle}"
        WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary Source="ManagerResources.xaml" />
    </Window.Resources>
    <!-- 기본 흰 제목 표시줄 대신 머리 줄이 제목 표시줄 (끌어서 옮기기, 두 번 눌러 최대화, Alt+Space 메뉴는 그대로) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 머리 줄: 이름, 서버 상태·주소, 새로 고침, 최소화·최대화·닫기 -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/ApiManager.ico" Width="20" Height="20" Margin="16,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="API Manager" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" Margin="0,1,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="확인 중…" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="AddressText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="새로 고침 (F5)" AutomationProperties.Name="새로 고침" Click="RefreshButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="최소화"
                            AutomationProperties.Name="최소화" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" ToolTip="최대화"
                            AutomationProperties.Name="최대화" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;" ToolTip="닫기 (서버는 계속 돕니다)"
                            AutomationProperties.Name="닫기" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="10,14" ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Content="서버" Tag="Server" IsSelected="True" />
                    <ListBoxItem Content="앱 목록" Tag="Apps" />
                    <ListBoxItem Content="릴리스" Tag="Releases" />
                    <ListBoxItem Content="공지" Tag="Notices" />
                    <ListBoxItem x:Name="ReportsNavItem" Content="문제 보고" Tag="Reports" />
                    <ListBoxItem Content="스킬" Tag="Skills" />
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="26,20,26,16">
                <!-- 서버 -->
                <ScrollViewer x:Name="ServerSection" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RestartButton" Content="다시 시작" Click="RestartButton_Click" />
                                <Button x:Name="StopButton" Content="멈추기" Click="StopButton_Click" />
                                <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" Content="&#xE712;" ToolTip="더 보기" AutomationProperties.Name="더 보기"
                                        Click="MoreButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="설정 파일 열기" Click="SettingsFileButton_Click" />
                                            <MenuItem Header="로그 열기" Click="LogButton_Click" />
                                            <MenuItem Header="데이터 폴더 열기" Click="DataFolderButton_Click" />
                                            <MenuItem Header="브라우저로 열기" Click="BrowserButton_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="서버" Style="{StaticResource HeadingStyle}" />
                                <TextBlock x:Name="VersionsText" Style="{StaticResource HintStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="FirewallText" Foreground="{StaticResource WarnBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

                        <UniformGrid Columns="3" Margin="0,18,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="새 보고" Style="{StaticResource HintStyle}" /><TextBlock x:Name="CountNew" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="문제 보고" Style="{StaticResource HintStyle}" /><TextBlock x:Name="CountReports" Text="—" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel><TextBlock Text="스킬" Style="{StaticResource HintStyle}" /><TextBlock x:Name="CountSkills" Text="—" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="접속한 PC" Style="{StaticResource SubheadingStyle}" Margin="0,24,0,8" />
                        <Grid Margin="14,0,14,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="주소" Style="{StaticResource HintStyle}" />
                            <TextBlock Grid.Column="1" Text="버전" Style="{StaticResource HintStyle}" />
                            <TextBlock Grid.Column="2" Text="마지막 접속" Style="{StaticResource HintStyle}" />
                            <TextBlock Grid.Column="3" Text="쓴 기능" Style="{StaticResource HintStyle}" />
                        </Grid>
                        <ListBox x:Name="ClientsList" MaxHeight="240" MinHeight="48">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Tip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Address}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Last}" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Features}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoClientsText" Text="아직 접속한 PC가 없습니다." Style="{StaticResource HintStyle}" Margin="2,6,0,0" Visibility="Collapsed" />

                        <Button x:Name="SettingsToggleButton" Content="설정 보기" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="-8,18,0,0"
                                Click="SettingsToggleButton_Click" />
                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,6,0,8">
                            <TextBlock x:Name="SettingsText" FontSize="12.5" Foreground="{StaticResource LabelTextBrush}" TextWrapping="Wrap" LineHeight="20" />
                            <TextBlock x:Name="ServerFootText" Style="{StaticResource HintStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 앱 목록 (i-luncher) -->
                <Grid x:Name="AppsSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="SaveAppsButton" DockPanel.Dock="Right" Content="저장" Style="{StaticResource PrimaryButtonStyle}" Margin="0" IsEnabled="False"
                                Click="SaveAppsButton_Click" VerticalAlignment="Center" />
                        <TextBlock Text="앱 목록" Style="{StaticResource HeadingStyle}" VerticalAlignment="Center" ToolTip="i-luncher에 이 순서대로 보입니다" />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="AppsList" SelectionChanged="AppsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource HintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="앱 추가" AutomationProperties.Name="앱 추가" Click="AddAppButton_Click" />
                                <Button x:Name="RemoveAppButton" Style="{StaticResource IconButtonStyle}" Content="&#xE738;" ToolTip="목록에서 빼기" AutomationProperties.Name="목록에서 빼기" Click="RemoveAppButton_Click" />
                                <Button x:Name="MoveUpButton" Style="{StaticResource IconButtonStyle}" Content="&#xE74A;" ToolTip="위로" AutomationProperties.Name="위로" Click="MoveUpButton_Click" />
                                <Button x:Name="MoveDownButton" Style="{StaticResource IconButtonStyle}" Content="&#xE74B;" ToolTip="아래로" AutomationProperties.Name="아래로" Click="MoveDownButton_Click" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Column="1" Margin="22,0,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AppForm" IsEnabled="False" MaxWidth="560" HorizontalAlignment="Left" Width="Auto" MinWidth="320">
                                <TextBlock Text="이름" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                                <TextBox x:Name="AppNameBox" TextChanged="AppField_TextChanged" />
                                <TextBlock Text="영문 이름" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="AppEnglishNameBox" TextChanged="AppField_TextChanged" />
                                <TextBlock Text="GitHub 저장소" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="AppRepositoryBox" Tag="https://github.com/소유자/저장소" TextChanged="AppField_TextChanged" />
                                <TextBlock Text="설명" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="AppDescriptionBox" TextChanged="AppField_TextChanged" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="분류" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="AppCategoryBox" TextChanged="AppField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="id" Style="{StaticResource FieldLabelStyle}" ToolTip="영문 소문자·숫자·-, 앱마다 다르게 (설치 기록이 이 id를 따름)" />
                                        <TextBox x:Name="AppIdBox" Tag="예: my-app" TextChanged="AppField_TextChanged"
                                                 ToolTip="영문 소문자·숫자·-, 앱마다 다르게 (설치 기록이 이 id를 따름)" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="설치 폴더 이름" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="AppInstallNameBox" TextChanged="AppField_TextChanged"
                                         ToolTip="%LOCALAPPDATA%\Programs\&lt;이름&gt;. 앱의 update.json InstallName 과 같아야 스스로 업데이트하고, 릴리스 파일은 &lt;이름&gt;-win-x64.zip" />
                                <TextBlock Text="설치 방식" Style="{StaticResource FieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AppKindZip" Content="zip 풀기" GroupName="AppKind" Checked="AppKind_Checked" />
                                    <RadioButton x:Name="AppKindSetup" Content="설치 프로그램" GroupName="AppKind" Checked="AppKind_Checked" />
                                </StackPanel>
                                <CheckBox x:Name="AppMasterOnlyBox" Content="마스터 계정에만 보이기" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}"
                                          ToolTip="런처의 MASTER_USERS(.env)에 있는 계정에만 i-luncher에 보입니다"
                                          Checked="AppMasterOnly_Changed" Unchecked="AppMasterOnly_Changed" />
                                <CheckBox x:Name="AppBetaBox" Content="베타 (정식 서비스 전)" Margin="0,10,0,0" Foreground="{StaticResource TextBrush}"
                                          ToolTip="i-luncher 카드에 '베타' 배지를 붙입니다. 끄면 정식 서비스"
                                          Checked="AppBadge_Changed" Unchecked="AppBadge_Changed" />
                                <CheckBox x:Name="AppNewBox" Content="NEW (새로 추가한 앱)" Margin="0,10,0,0" Foreground="{StaticResource TextBrush}"
                                          ToolTip="i-luncher 카드에 'NEW' 배지를 붙입니다. 새로 추가하면 켜져 있고, 알릴 만큼 지나면 끄세요"
                                          Checked="AppBadge_Changed" Unchecked="AppBadge_Changed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 릴리스: 프로젝트마다 다음 버전이 들어가 있고, 고쳐서 릴리스 (저장소의 release.yml 실행) -->
                <Grid x:Name="ReleasesSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="릴리스" Style="{StaticResource HeadingStyle}" ToolTip="새 버전에는 다음 번호가 들어가 있습니다. 고쳐서 릴리스할 수 있습니다." />
                    <Grid Grid.Row="1" Margin="14,16,14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="96" /><ColumnDefinition Width="118" /><ColumnDefinition Width="84" /><ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="앱" Style="{StaticResource HintStyle}" />
                        <TextBlock Grid.Column="1" Text="현재" Style="{StaticResource HintStyle}" />
                        <TextBlock Grid.Column="2" Text="새 버전" Style="{StaticResource HintStyle}" />
                        <TextBlock Grid.Column="4" Text="최근 실행" Style="{StaticResource HintStyle}" Margin="10,0,0,0" />
                    </Grid>
                    <ListBox x:Name="ReleasesList" Grid.Row="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Tip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="96" /><ColumnDefinition Width="118" /><ColumnDefinition Width="84" /><ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Latest}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsVersionFixed}"
                                             Margin="0,0,8,0" Padding="8,4" AutomationProperties.Name="새 버전" />
                                    <Button Grid.Column="3" Content="릴리스" IsEnabled="{Binding CanRelease}" Click="ReleaseButton_Click" Margin="0" MinWidth="0" Padding="10,5" />
                                    <Button Grid.Column="4" Style="{StaticResource LinkButtonStyle}" Foreground="{Binding StatusBrush}"
                                            Cursor="{Binding StatusCursor}" ToolTip="{Binding StatusTip}" Click="ReleaseStatusButton_Click"
                                            HorizontalAlignment="Left" Margin="2,0,0,0" MaxWidth="188">
                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 공지: Terminal Notes 공지와 i-luncher 공지를 한 곳에서 -->
                <Grid x:Name="NoticesSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="HistoryButton" Content="이전 공지" Style="{StaticResource LinkButtonStyle}" Margin="0,0,8,0" Click="HistoryButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="HistoryMenu" />
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="SaveNoticeButton" Content="저장" Style="{StaticResource PrimaryButtonStyle}" Margin="0" IsEnabled="False" Click="SaveNoticeButton_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="공지" Style="{StaticResource HeadingStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <RadioButton x:Name="NoticeKindTerminalNotes" Content="Terminal Notes" GroupName="NoticeKind" IsChecked="True" Checked="NoticeKind_Checked" VerticalAlignment="Center" />
                            <RadioButton x:Name="NoticeKindLauncher" Content="i-luncher" GroupName="NoticeKind" Checked="NoticeKind_Checked" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="NoticeInfoText" Grid.Row="1" Style="{StaticResource HintStyle}" Margin="0,10,0,0" />
                    <TextBox x:Name="AnnouncementBox" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource DocumentBoxStyle}" Tag="공지 내용" TextChanged="AnnouncementBox_TextChanged" />
                    <TextBox x:Name="LauncherNoticesBox" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource DocumentBoxStyle}" Visibility="Collapsed"
                             Tag="첫 줄은 제목, 다음 줄부터 본문. 공지 사이는 --- 만 있는 줄" TextChanged="LauncherNoticesBox_TextChanged" />
                </Grid>

                <!-- 문제 보고 -->
                <Grid x:Name="ReportsSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBox x:Name="ReportSearchBox" DockPanel.Dock="Right" Width="220" Tag="검색" VerticalAlignment="Center" TextChanged="ReportSearchBox_TextChanged" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="문제 보고" Style="{StaticResource HeadingStyle}" />
                            <TextBlock x:Name="ReportsAnalysisText" Style="{StaticResource HintStyle}" TextWrapping="Wrap" Margin="0,4,16,0" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="ReportFilterAll" GroupName="ReportFilter" IsChecked="True" Checked="ReportFilter_Changed" />
                        <RadioButton x:Name="ReportFilterNew" GroupName="ReportFilter" Checked="ReportFilter_Changed" />
                        <RadioButton x:Name="ReportFilterChecking" GroupName="ReportFilter" Checked="ReportFilter_Changed" />
                        <RadioButton x:Name="ReportFilterResolved" GroupName="ReportFilter" Checked="ReportFilter_Changed" />
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="ReportsList" SelectionChanged="ReportsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource HintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11.5" Foreground="{Binding StatusBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid x:Name="ReportDetail" Grid.Column="1" Margin="18,0,0,0" IsEnabled="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ReportHeaderText" Style="{StaticResource HintStyle}" />
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="ReportStatusNew" GroupName="ReportStatus" />
                                    <RadioButton x:Name="ReportStatusChecking" GroupName="ReportStatus" />
                                    <RadioButton x:Name="ReportStatusResolved" GroupName="ReportStatus" />
                                </StackPanel>
                                <TextBox x:Name="ReportNoteBox" Grid.Column="1" Margin="6,0,8,0" Tag="메모" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="저장" Style="{StaticResource PrimaryButtonStyle}" Click="SaveReportButton_Click" Margin="0,0,2,0" />
                                    <Button x:Name="SaveReportLogsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE896;" ToolTip="로그 저장 (zip)" AutomationProperties.Name="로그 저장"
                                            Click="SaveReportLogsButton_Click" />
                                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" ToolTip="보고서 삭제" AutomationProperties.Name="보고서 삭제" Click="DeleteReportButton_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="ReportTextBox" Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource DocumentBoxStyle}" IsReadOnly="True" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 스킬 -->
                <Grid x:Name="SkillsSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="스킬" Style="{StaticResource HeadingStyle}" />
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="SkillsList" SelectionChanged="SkillsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource HintStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid x:Name="SkillDetail" Grid.Column="1" Margin="18,0,0,0" IsEnabled="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" ToolTip="스토어에서 삭제 (30일 동안 skills\.trash에 보관)"
                                        AutomationProperties.Name="스토어에서 삭제" Click="DeleteSkillButton_Click" VerticalAlignment="Center" />
                                <TextBlock x:Name="SkillHeaderText" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="SkillContentBox" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DocumentBoxStyle}" IsReadOnly="True" />
                            <DockPanel Grid.Row="2" Margin="0,14,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="보기" Style="{StaticResource LinkButtonStyle}" Click="ShowSkillVersionButton_Click" ToolTip="고른 버전의 내용을 위에 보여 줌" />
                                    <Button Content="이 버전으로 되돌리기" Style="{StaticResource LinkButtonStyle}" Click="RestoreSkillButton_Click"
                                            ToolTip="고른 버전의 내용을 새 최신 버전으로 올림" />
                                </StackPanel>
                                <TextBlock Text="버전" Style="{StaticResource SubheadingStyle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="SkillVersionsList" Grid.Row="3" MinHeight="70" MouseDoubleClick="ShowSkillVersionButton_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 아래: 결과·오류 (있을 때만, 누르면 닫힘) -->
        <Border x:Name="MessageBar" Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="20,8" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="MessageBar_MouseLeftButtonUp">
            <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </Border>
    </Grid>
    </Border>
</Window>
