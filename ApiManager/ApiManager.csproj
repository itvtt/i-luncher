<Project Sdk="Microsoft.NET.Sdk">

  <!-- 관리자 메뉴: i-luncher 안의 API 서버 관리 화면 (마스터 계정만, 런처의 MASTER_USERS).
       이 PC의 API 서버 i-api (C#, ..\CDEP\i-api.csproj)를 설치·시작·중지하고 API · 앱 목록·공지·문제 보고·스킬·릴리스·러너를 관리.
       서버 프로그램은 런처 설치 폴더의 server\ 로 들어가고 (i-api.exe 와 그 파일들, 시작·중지 스크립트, README), 런처가 새 버전이 되면 시작할 때
       서버 PC 의 서버(%LOCALAPPDATA%\i-api)를 새 i-api.exe 로 바꿈 (settings.txt 는 그대로, 예전 Python 서버 relay.py 는 한 번 옮김) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApiManager</RootNamespace>
    <AssemblyName>ApiManager</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);server\**</DefaultItemExcludes>
    <!-- 런처 빌드 · 게시의 값(-p:Version, -r win-x64 …)이 서버에 넘어가지 않게: 서버는 자기 버전으로 같은 모양 (어느 PC 의 .NET 10 에서나) -->
    <ApiServerRemoved>Version;RuntimeIdentifier;SelfContained;PublishDir;PublishSingleFile;ReleaseZip;_IsPublishing;AppHostRelativeDotNet;AppHostDotNetSearch</ApiServerRemoved>
    <ApiServerStage>$(MSBuildProjectDirectory)\obj\i-api\$(Configuration)\</ApiServerStage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="server\README.md;server\*.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 서버를 먼저 복원 · 빌드 (이 프로젝트의 dll 에는 넣지 않음) -->
    <ProjectReference Include="..\CDEP\i-api.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="$(ApiServerRemoved)" />
    <Resource Include="Assets\ApiManager.ico" />
    <InternalsVisibleTo Include="Launcher.Checks" />
  </ItemGroup>

  <!-- 서버를 게시해 그 파일을 server\ 로 (런처의 출력 · 게시 폴더까지 따라감) -->
  <Target Name="BundleApiServer" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\CDEP\i-api.csproj" Targets="Publish" RemoveProperties="$(ApiServerRemoved.Replace(';PublishDir', ''))"
             Properties="Configuration=$(Configuration);PublishDir=$(ApiServerStage)" />
    <ItemGroup>
      <_ApiServerFile Include="$(ApiServerStage)**\*" Exclude="$(ApiServerStage)**\*.pdb" />
      <Content Include="@(_ApiServerFile)" Link="server\%(_ApiServerFile.RecursiveDir)%(_ApiServerFile.Filename)%(_ApiServerFile.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
