<Window x:Class="FolderCompareWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderCompareWPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="/FolderCompareWPF;component/Assets/FolderCompare.ico"
        Title="File Compare · 파일 비교"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Background="#080A0E"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8C6D9"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#243247"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#344B69"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#82ACEC"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="Tag" Value="Close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="#C44152"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#101720"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip" Background="#50647E" CornerRadius="4" Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#8AA7CF"/></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#8AA7CF"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315D99"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#304868"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEF3FA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Color system -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080A0E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#11151C"/>
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#0C1016"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3442"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#41516A"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF3FA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0BED0"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#92A3BA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3875DE"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#182D49"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#B69AFF"/>
        <SolidColorBrush x:Key="PurpleSoftBrush" Color="#292039"/>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#172033"
                          BlurRadius="22"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.09"/>

        <!-- Surfaces -->
        <Style x:Key="SurfaceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="BrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style x:Key="EditorSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Path fields -->
        <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#406BA9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TextBoxChrome" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="#171D27"/>
                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree and splitter -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Header" Value="{Binding Name}"/>
            <Setter Property="Tag" Value="{Binding FileTag}"/>
            <Setter Property="ToolTip" Value="{Binding RelativePath}"/>
            <Setter Property="local:MainWindow.IsFileSelected" Value="{Binding IsSelected}"/>
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FileContainer_PreviewMouseLeftButtonDown"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="5,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Width="16" Height="24" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8 Z" Fill="#B0BED0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,0 L 4,4 Z"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Selection" Grid.Column="1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger SourceName="Selection" Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="#233247"/></Trigger>
                            <Trigger Property="local:MainWindow.IsFileSelected" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="#315D99"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#8AA7CF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="SplitterLine"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource BorderBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Width" Value="2"/>
                                <Setter TargetName="SplitterLine" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#202939"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#0D131C" BorderBrush="#202B3A" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/FolderCompare.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FILE COMPARE" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#CFDCEF" VerticalAlignment="Center"/>
                    <Border Width="1" Height="12" Margin="14,0" Background="#344156"/>
                    <TextBlock Text="파일 비교" FontSize="11" Foreground="#8FA2BC" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMinimize" Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" ToolTip="최소화" AutomationProperties.Name="최소화" Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}" ToolTip="최대화" AutomationProperties.Name="최대화" Click="BtnMaximize_Click"/>
                    <Button x:Name="BtnClose" Content="&#xE8BB;" Tag="Close" Style="{StaticResource CaptionButtonStyle}" ToolTip="닫기" AutomationProperties.Name="닫기" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18,14,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- Left workspace -->
            <Border Grid.Column="0"
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <CheckBox x:Name="ChkIgnoreWhitespace" DockPanel.Dock="Right"
                                  Content="공백·줄바꿈 무시" Margin="8,0,0,0" FontSize="11"
                                  VerticalAlignment="Center"
                                  ToolTip="스페이스(띄어쓰기), 탭, 줄바꿈 차이를 무시하고 비교합니다. 문자열 안의 공백도 무시합니다. 원본 파일은 변경하지 않습니다. 16MB 이하 텍스트에 적용됩니다."
                                  Click="IgnoreWhitespace_Click"/>
                        <Border DockPanel.Dock="Left"
                                Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="9">
                            <Image Source="Assets/FolderCompare.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="파일 비교"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="A ↔ B"
                                       Margin="0,1,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- A/B selectors stay in one horizontal row -->
                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="7"
                                Background="#101D2C"
                                BorderBrush="#304866"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel>
                                <Button Content="A 폴더" Click="OpenFolderA_Click" ToolTip="A 폴더 열기" Style="{StaticResource EditorSaveButtonStyle}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Name="BtnBrowseA"
                                        Content="📁"
                                        Margin="0,5,0,7"
                                        Style="{StaticResource BrowseButtonStyle}"
                                        ToolTip="A 폴더 또는 드라이브 선택"
                                        HorizontalAlignment="Center"
                                        Click="BtnBrowseA_Click"/>
                                <TextBox x:Name="TxtDirA"
                                         Style="{StaticResource PathTextBoxStyle}"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                         AllowDrop="True"
                                         PreviewDragOver="TxtDir_PreviewDragOver"
                                         Drop="TxtDirA_Drop"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="7"
                                Background="#1C172A"
                                BorderBrush="#493B65"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel>
                                <Button Content="B 폴더" Click="OpenFolderB_Click" ToolTip="B 폴더 열기" Style="{StaticResource EditorSaveButtonStyle}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PurpleBrush}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Name="BtnBrowseB"
                                        Content="📁"
                                        Margin="0,5,0,7"
                                        Style="{StaticResource BrowseButtonStyle}"
                                        ToolTip="B 폴더 또는 드라이브 선택"
                                        HorizontalAlignment="Center"
                                        Click="BtnBrowseB_Click"/>
                                <TextBox x:Name="TxtDirB"
                                         Style="{StaticResource PathTextBoxStyle}"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                         AllowDrop="True"
                                         PreviewDragOver="TxtDir_PreviewDragOver"
                                         Drop="TxtDirB_Drop"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnCompare"
                                Grid.Column="0"
                                Content="비교"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnCompare_Click"/>
                        <Button x:Name="BtnSave"
                                Grid.Column="2"
                                Content="저장"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnSave_Click"/>
                    </Grid>
                    </StackPanel>

                    <Border x:Name="BorderCompareProgress"
                            Grid.Row="3"
                            Visibility="Collapsed"
                            Margin="0,0,0,10"
                            Padding="8,7"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="#304866"
                            BorderThickness="1"
                            CornerRadius="7">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="&#xE895;"
                                       Margin="0,0,6,0"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Top"/>
                            <TextBlock x:Name="TxtCompareProgress"
                                       Text="비교 준비 중..."
                                       FontSize="10.5"
                                       Foreground="#ABCDFE"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="4"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="10,10,10,8">
                                <TextBlock Text="비교 결과"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <TreeView x:Name="TvFileList"
                                          PreviewKeyDown="TvFileList_PreviewKeyDown"
                                          Padding="4,6"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Standard"
                                          ScrollViewer.CanContentScroll="True"
                                          SelectedItemChanged="TvFileList_SelectedItemChanged"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Button x:Name="BtnCopySelected" Grid.Row="5"
                            Content="선택 파일 A → B 덮어쓰기 (0)" Margin="0,10,0,0"
                            FontSize="11" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                            Click="BtnCopySelected_Click"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Style="{StaticResource SplitterStyle}"/>

            <!-- Diff workspace -->
            <Border Grid.Column="2"
                    Style="{StaticResource SurfaceCardStyle}"
                    ClipToBounds="True">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Margin="32"
                                Visibility="{Binding Visibility, ElementName=TxtInfoMessage}">
                        <Border Width="64" Height="64"
                                Margin="0,0,0,18"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="18">
                            <TextBlock Text="&#xE8AB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="25"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtInfoMessage"
                                   Text="파일을 선택하세요."
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Visibility="Visible"/>
                        <TextBlock Text="왼쪽 트리에서 비교가 완료된 파일을 열 수 있습니다."
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtLoadingMessage"
                               Text="비교 중입니다..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.35" Duration="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <Grid x:Name="GridDiffPanel" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="11"/>
                        </Grid.ColumnDefinitions>

                        <!-- A editor -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="2"
                                    Padding="12,0"
                                    Background="#101D2C"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28"
                                            Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="7"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="A" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtFileA"
                                               Grid.Column="1"
                                               Text="A · 파일 없음"
                                               Margin="9,0,10,0"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="BtnSaveFileA"
                                            Grid.Column="2"
                                            Content="A 저장"
                                            IsEnabled="False"
                                            ToolTip="수정한 A 파일 저장 (Ctrl+S)"
                                            Style="{StaticResource EditorSaveButtonStyle}"
                                            Click="BtnSaveFileA_Click"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0"
                                    Background="#0D131D"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,0"
                                    ClipToBounds="True">
                                <TextBlock x:Name="LnDiffA"
                                           Padding="0,0,8,0"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="13"
                                           LineHeight="20"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Top">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LnDiffATransform"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <RichTextBox x:Name="RtbDiffA"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         AcceptsTab="True"
                                         SpellCheck.IsEnabled="False"
                                         BorderThickness="0"
                                         Background="{StaticResource SurfaceBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource AccentBrush}"
                                         SelectionBrush="#406BA9"
                                         Padding="8,0,8,0"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="13"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextChanged="RtbDiffA_TextChanged"
                                         ScrollViewer.ScrollChanged="RtbDiffA_ScrollChanged"/>
                        </Grid>

                        <GridSplitter Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      Style="{StaticResource SplitterStyle}"/>

                        <!-- B editor -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="2"
                                    Padding="12,0"
                                    Background="#1C172A"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28"
                                            Background="{StaticResource PurpleSoftBrush}"
                                            CornerRadius="7"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="B" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource PurpleBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtFileB"
                                               Grid.Column="1"
                                               Text="B · 파일 없음"
                                               Margin="9,0,10,0"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="BtnSaveFileB"
                                            Grid.Column="2"
                                            Content="B 저장"
                                            IsEnabled="False"
                                            ToolTip="수정한 B 파일 저장 (Ctrl+S)"
                                            Style="{StaticResource EditorSaveButtonStyle}"
                                            Click="BtnSaveFileB_Click"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0"
                                    Background="#0D131D"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,0"
                                    ClipToBounds="True">
                                <TextBlock x:Name="LnDiffB"
                                           Padding="0,0,8,0"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="13"
                                           LineHeight="20"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Top">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LnDiffBTransform"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <RichTextBox x:Name="RtbDiffB"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         AcceptsTab="True"
                                         SpellCheck.IsEnabled="False"
                                         BorderThickness="0"
                                         Background="{StaticResource SurfaceBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource PurpleBrush}"
                                         SelectionBrush="#69558C"
                                         Padding="8,0,8,0"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="13"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextChanged="RtbDiffB_TextChanged"
                                         ScrollViewer.ScrollChanged="RtbDiffB_ScrollChanged"/>
                        </Grid>

                        <Border Grid.Column="3" Margin="0,50,0,0"
                                Background="#141D2A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,0,0,0">
                            <Canvas x:Name="CanvasScrollMarkers"
                                    MouseLeftButtonDown="CanvasScrollMarkers_MouseLeftButtonDown"
                                    SizeChanged="CanvasScrollMarkers_SizeChanged"
                                    Background="Transparent" ClipToBounds="True"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
