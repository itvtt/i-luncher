<Window x:Class="DeskCal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Calendar" Height="650" Width="850"
        Icon="/DeskCal;component/cal.ico"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        PreviewMouseDown="Window_PreviewMouseDown"
        StateChanged="Window_StateChanged"
        FontFamily="Segoe UI, Malgun Gothic"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="MyWindowChrome"
                      CaptionHeight="60"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Color x:Key="AccentColor">#5AC8FA</Color>
        <Color x:Key="AccentSoftColor">#335AC8FA</Color>
        <Color x:Key="DangerColor">#FF5C5C</Color>
        <Color x:Key="DangerSoftColor">#33FF5C5C</Color>
        <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentSoftBrush"   Color="{StaticResource AccentSoftColor}"/>
        <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="DangerSoftBrush"   Color="{StaticResource DangerSoftColor}"/>
        <SolidColorBrush x:Key="CardBackgroundDark"   Color="#1E2231"/>
        <SolidColorBrush x:Key="CardBackgroundDarker" Color="#181C28"/>
        <SolidColorBrush x:Key="CardBorderBrush"      Color="#2E3547"/>
        <SolidColorBrush x:Key="ScrollThumbBrush"     Color="#4A5270"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6B7599"/>

        <LinearGradientBrush x:Key="TopBarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1C2030" Offset="0"/>
            <GradientStop Color="#161A26" Offset="0.5"/>
            <GradientStop Color="#12151E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E2338" Offset="0"/>
            <GradientStop Color="#1A1F32" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CalendarBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#12151E" Offset="0"/>
            <GradientStop Color="#0C0E16" Offset="1"/>
        </LinearGradientBrush>

        <!-- ToggleSwitch 스타일 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Background"   Value="#2E3547"/>
            <Setter Property="BorderBrush"  Value="#3A4058"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="50" Height="26">
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    CornerRadius="13" BorderThickness="1"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                            <Ellipse x:Name="Knob" Width="22" Height="22"
                                     HorizontalAlignment="Left" Margin="2,2,2,2">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EAF0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.35" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="26,2,2,2" Duration="0:0:0.18"
                                                                DecelerationRatio="0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="2,2,2,2" Duration="0:0:0.18"
                                                                DecelerationRatio="0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModernCheckBox 스타일 -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Foreground" Value="#9BA4C0"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Height="20" Width="20">
                                <Border x:Name="Border" CornerRadius="5" BorderThickness="1.5"
                                        BorderBrush="#3A4058" Background="#1E2231"/>
                                <Path x:Name="CheckMark" Data="M 4,10 L 8,14 L 16,4"
                                      Stroke="White" StrokeThickness="2.3"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border"    Property="Background"  Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Border"    Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility"  Value="Visible"/>
                                <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5580A8D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 스크롤바 스타일 -->
        <Style x:Key="ModernScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="6" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="{DynamicResource ScrollThumbBrush}"
                                           Style="{DynamicResource ScrollThumbs}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"   Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Thumb" Property="Background"
                                        Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumbs" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid>
                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="Transparent"/>
                            <Border CornerRadius="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Grid.Column="0" Margin="{TemplateBinding Padding}" Grid.Row="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                AutomationProperties.AutomationId="VerticalScrollBar"
                                Cursor="Arrow" Grid.Column="1"
                                Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Grid.Row="0"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Style="{DynamicResource ModernScrollBarStyle}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                AutomationProperties.AutomationId="HorizontalScrollBar"
                                Cursor="Arrow" Grid.Column="0"
                                Maximum="{TemplateBinding ScrollableWidth}" Minimum="0"
                                Orientation="Horizontal" Grid.Row="1"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Style="{DynamicResource ModernScrollBarStyle}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModernBtn -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Foreground"        Value="#A0A8C4"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Padding"           Value="6,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#E0E4F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="21*"/>
            <ColumnDefinition Width="62*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F1119" Offset="0"/>
                <GradientStop Color="#0B0D14" Offset="0.45"/>
                <GradientStop Color="#080A10" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border x:Name="MainBorder" CornerRadius="18"
                BorderBrush="#25FFFFFF" BorderThickness="1" Grid.ColumnSpan="2">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="32" ShadowDepth="6"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ══ 상단 툴바 ══ -->
                <Grid Grid.Row="0" Background="{StaticResource TopBarGradient}">
                    <!-- 하단 separator -->
                    <Border VerticalAlignment="Bottom" Height="1" Background="#15FFFFFF"/>
                    <Border Background="Transparent"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernBtn}" Content="◀" Width="38" Height="38" Click="BtnPrev_Click" FontSize="13"/>
                        <TextBlock x:Name="TxtYearMonth" Text="2025. 11"
                                   FontSize="26" FontWeight="Bold" Foreground="#E8ECF8" Margin="14,0"
                                   VerticalAlignment="Center" Cursor="Hand"
                                   MouseLeftButtonDown="TxtYearMonth_MouseLeftButtonDown"
                                   ToolTip="클릭하면 오늘 날짜로 이동합니다.">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Button Style="{StaticResource ModernBtn}" Content="▶" Width="38" Height="38" Click="BtnNext_Click" FontSize="13"/>
                        <Button Content="오늘" Click="BtnToday_Click"
                                Style="{StaticResource ModernBtn}"
                                FontSize="12" FontWeight="SemiBold"
                                Width="60" Height="28" Margin="16,0,0,0"
                                BorderBrush="#405AC8FA" BorderThickness="1"
                                Background="#205AC8FA" Foreground="#C0D8F8"
                                ToolTip="이번 달로 돌아가기"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,18,0">

                        <ToggleButton x:Name="BtnPrivacy"
                            Click="BtnPrivacy_Click"
                            Width="35" Margin="0,0,4,0"
                            ToolTip="프라이버시 모드 (토글)"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border"
                                        Background="#D49520"
                                        CornerRadius="8" Padding="4,3">
                                        <TextBlock x:Name="LockIcon"
                                           Text="🔓"
                                           FontFamily="Segoe UI Emoji"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="LockIcon" Property="Text"       Value="🔒"/>
                                            <Setter TargetName="border"   Property="Background" Value="#B07818"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="LockIcon" Property="Text"       Value="🗝️"/>
                                            <Setter TargetName="border"   Property="Background" Value="#D49520"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#C08618"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <CheckBox x:Name="ChkLockMinimize"
                            Margin="0,0,8,0"
                            ToolTip="고정 (체크 시 최소화 비활성화)"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Cursor="Hand">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="border"
                                        Background="#90FF4060"
                                        CornerRadius="8" Padding="5,3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📌"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"/>
                                            <TextBlock x:Name="pinLabel"
                                               Text="고정"
                                               FontSize="11"
                                               Foreground="#D0D4E4"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                            <Grid Width="15" Height="15" VerticalAlignment="Center">
                                                <Border x:Name="checkBorder"
                                                CornerRadius="4" BorderThickness="1.5"
                                                BorderBrush="#3A4058" Background="#1E2231"/>
                                                <Path x:Name="checkMark"
                                              Data="M 3,7.5 L 6,10.5 L 12,4"
                                              Stroke="White" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="Collapsed"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border"      Property="Background"  Value="#C0FF2850"/>
                                            <Setter TargetName="pinLabel"    Property="Foreground"  Value="#FFFFFF"/>
                                            <Setter TargetName="checkBorder" Property="Background"  Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="checkMark"   Property="Visibility"  Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#B0FF3868"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <Button x:Name="BtnMiniMode" Style="{StaticResource ModernBtn}"
        Content="▤" Width="35" Click="BtnMiniMode_Click" ToolTip="미니 모드 (현재 주만 표시)"/>

                        <!-- 검색 버튼 (NEW) -->
                        <Button x:Name="BtnSearch" Style="{StaticResource ModernBtn}"
                                Content="🔍" Width="35" Click="BtnSearch_Click" ToolTip="일정 검색 (Ctrl+F)"/>
                        <!-- 매크로 버튼 (NEW) -->
                        <Button x:Name="BtnMacro" Style="{StaticResource ModernBtn}"
                                Content="📋" Width="35" Click="BtnMacro_Click" ToolTip="매크로 일정 관리"/>

                        <Button x:Name="BtnSettings" Style="{StaticResource ModernBtn}"
                                Content="⚙" Width="35" Click="BtnSettings_Click" ToolTip="설정"/>
                        <Button Style="{StaticResource ModernBtn}" Content="─" Width="35" Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnMaximize" Style="{StaticResource ModernBtn}"
                                Content="□" Width="35" Click="BtnMaximize_Click"/>
                        <Button Width="35" Style="{StaticResource ModernBtn}"
                                Click="BtnClose_Click" Foreground="#E05050">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="5,3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}">
                                            <ContentPresenter.Content>✕</ContentPresenter.Content>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#40FF4444"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#70FF4444"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ══ 요일 헤더 ══ -->
                <Border Grid.Row="1" Margin="12,6,12,0" CornerRadius="10"
                        Background="{StaticResource HeaderGradient}"
                        BorderBrush="#18FFFFFF" BorderThickness="1">
                    <Grid x:Name="HeaderGrid" Margin="8,0,8,0">
                        <TextBlock x:Name="TxtHeaderSun" Text="일" Foreground="#E06060"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="13">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtMon" Text="월" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="#7880A0">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtTue" Text="화" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="#7880A0">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtWed" Text="수" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="#7880A0">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtThu" Text="목" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="#7880A0">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtFri" Text="금" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="#7880A0">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="0.15"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtHeaderSat" Text="토" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#4EB8E8">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ══ 달력 그리드 ══ -->
                <Border Grid.Row="2" Margin="12,6,12,12" CornerRadius="14"
                        Background="{StaticResource CalendarBackgroundGradient}"
                        BorderBrush="#15FFFFFF" BorderThickness="1">
                    <Grid x:Name="CalendarGrid" Margin="6"/>
                </Border>

                <!-- ══ 설정 팝업 ══ -->
                <Border x:Name="SettingsPopup"
                        Grid.RowSpan="3"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="290" Margin="0,78,110,0" Padding="20"
                        CornerRadius="14" Visibility="Collapsed"
                        Background="#E8181C28"
                        BorderBrush="#20FFFFFF" BorderThickness="1"
                        MaxHeight="420">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" Opacity="0.65" ShadowDepth="8" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Grid.Row="0">
                            <Ellipse Width="26" Height="26" Fill="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.4"
                                                      Color="{StaticResource AccentColor}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="TxtSettingsHeader" Text="설정"
                                       FontWeight="Bold" Margin="8,0,0,0" FontSize="18"
                                       VerticalAlignment="Center" Foreground="#E0E4F4"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                                

                            <!-- Row 0: 투명도 (기존 유지) -->
                            <TextBlock x:Name="TxtOpacityLabel" Text="투명도"
           VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Foreground="#B0B8D0"/>
                            <Slider x:Name="SliderOpacity" Grid.Row="0" Grid.Column="1"
        Margin="5,0" Minimum="0.2" Maximum="1.0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtOpacityValue" Grid.Row="0" Grid.Column="2"
           Text="90%" FontSize="12" VerticalAlignment="Center"
           HorizontalAlignment="Right" Foreground="#7880A0"/>

                            <!-- Row 1: 글자 크기 (기존 유지) -->
                            <TextBlock x:Name="TxtFontSizeLabel" Text="글자 크기"
           VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Foreground="#B0B8D0"/>
                            <Slider x:Name="SliderFontSize" Grid.Row="1" Grid.Column="1"
        Margin="5,0" Minimum="10" Maximum="30"
        SmallChange="1" LargeChange="2"
        IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtFontSizeInput" Grid.Row="1" Grid.Column="2"
         Text="12" FontSize="12" VerticalAlignment="Center"
         HorizontalAlignment="Right" Width="30"
         TextAlignment="Center" Padding="2"
         Background="#10141E" Foreground="#C0C8E0"
         BorderBrush="#2E3547" BorderThickness="1"/>

                            <!-- Row 2: 주말 숨기기 (기존 유지) -->
                            <TextBlock x:Name="TxtWeekendsLabel" Text="주말 숨기기"
           VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Foreground="#B0B8D0"/>
                            <CheckBox x:Name="BtnHideWeekends"
          Style="{StaticResource ToggleSwitchStyle}"
          Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
          HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- Row 3: 고정 시 드래그 잠금 (신규) -->
                            <TextBlock Text="고정 시 드래그 잠금"
           VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Foreground="#B0B8D0"/>
                            <CheckBox x:Name="ChkLockDrag"
          Style="{StaticResource ToggleSwitchStyle}"
          Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
          HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- Row 4: 부팅시 자동 실행 (Row 3→4) -->
                            <TextBlock x:Name="TxtAutoStartLabel" Text="부팅시 자동 실행"
           VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Foreground="#B0B8D0"/>
                            <CheckBox x:Name="ChkAutoStart"
          Style="{StaticResource ToggleSwitchStyle}"
          Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
          HorizontalAlignment="Right" VerticalAlignment="Center"
          Click="ChkAutoStart_Click"/>

                            <!-- Row 5: 전/후 월 표시 (Row 4→5, CheckBox.Template 내용 그대로 유지) -->
                            <TextBlock Text="전/후 월 표시"
           VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" Foreground="#B0B8D0"/>
                            <CheckBox x:Name="CalChkShowAdjacentMonths"
          Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
          HorizontalAlignment="Right" VerticalAlignment="Center"
          IsChecked="False"
          Checked="CalChkShowAdjacentMonths_Changed"
          Unchecked="CalChkShowAdjacentMonths_Changed">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Grid Width="50" Height="26">
                                            <Border x:Name="Border" Background="#2E3547"
                        CornerRadius="13" BorderThickness="1" BorderBrush="#3A4058">
                                                <Border.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.15"/>
                                                </Border.Effect>
                                            </Border>
                                            <Ellipse x:Name="Knob" Width="22" Height="22"
                         HorizontalAlignment="Left" Margin="2,2,2,2">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#E8EAF0" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.35"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background"  Value="#5AC8FA"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#5AC8FA"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                    Storyboard.TargetProperty="Margin"
                                    To="26,2,2,2" Duration="0:0:0.18" DecelerationRatio="0.9"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                    Storyboard.TargetProperty="Margin"
                                    To="2,2,2,2" Duration="0:0:0.18" DecelerationRatio="0.9"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>



                            <!-- Row 6: 일정 기호 (Row 5→6) -->
                            <TextBlock x:Name="TxtBulletLabel" Text="일정 기호"
           VerticalAlignment="Center" Grid.Row="6" Grid.Column="0" Foreground="#B0B8D0"/>
                            <UniformGrid Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Rows="1" Columns="4">
                                <Button x:Name="BtnStyle0" Content="•"  Click="BtnStyle_Click" Tag="0" Margin="1" Style="{StaticResource ModernBtn}"/>
                                <Button x:Name="BtnStyle1" Content="■"  Click="BtnStyle_Click" Tag="1" Margin="1" Style="{StaticResource ModernBtn}"/>
                                <Button x:Name="BtnStyle2" Content="-"  Click="BtnStyle_Click" Tag="2" Margin="1" Style="{StaticResource ModernBtn}"/>
                                <Button x:Name="BtnStyle3" Content="1." Click="BtnStyle_Click" Tag="3" Margin="1" Style="{StaticResource ModernBtn}"/>
                            </UniformGrid>

                            <!-- Row 7: 연속일정 연결 표시 (신규) -->
                            <TextBlock Text="연속일정 연결"
           VerticalAlignment="Center" Grid.Row="7" Grid.Column="0" Foreground="#B0B8D0"/>
                            <CheckBox x:Name="ChkConnectConsecutive"
          Style="{StaticResource ToggleSwitchStyle}"
          Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
          HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
